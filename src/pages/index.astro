---
// src/pages/index.astro
// FileIntel — Homepage

import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';

const tools = [
  {
    icon: "🔍",
    tag: "featured",
    tagLabel: "Featured",
    name: "PDF Metadata Inspector & Remover",
    desc: "Surface and strip hidden author names, GPS coordinates, edit history, and company data from any PDF before you share it.",
    href: "/pdf-metadata-remover",
    featured: true,
  },
  {
    icon: "📄",
    tag: "live",
    tagLabel: "Live",
    name: "PDF Redactor",
    desc: "Black out sensitive text, signatures, and personal information from PDF documents. Permanent, unrecoverable redaction.",
    href: "/pdf-redactor",
    featured: false,
  },
  {
    icon: "🗂",
    tag: "live",
    tagLabel: "Live",
    name: "CSV Deduplicator",
    desc: "Upload a spreadsheet and remove duplicate rows instantly. Configurable by column. Export the clean file directly.",
    href: "/csv-deduplicator",
    featured: false,
  },
  {
    icon: "🔐",
    tag: "live",
    tagLabel: "Live",
    name: "Secure PDF Merger",
    desc: "Combine multiple PDFs without uploading anywhere. Reorder pages, set output metadata, download the result.",
    href: "/pdf-merger",
    featured: false,
  },
  {
    icon: "✂️",
    tag: "soon",
    tagLabel: "Live",
    name: "PDF Page Splitter",
    desc: "Extract specific pages or split a PDF into individual files. No 5-page limits, no watermarks, no payment wall.",
    href: "/pdf-splitter",
    dim: false,
  },
  {
    icon: "🧹",
    tag: "soon",
    tagLabel: "Coming soon",
    name: "Image EXIF Cleaner",
    desc: "Strip GPS data, camera model, and shooting parameters from photos before posting publicly or sharing with clients.",
    href: "#",
    dim: true,
  },
];

const blogs = [
  {
    category: "GDPR & Compliance",
    title: "GDPR and PDF Metadata: What Every DPO Needs to Know",
    excerpt:
      "PDF files shared by your organization may contain personal data in fields most people never see — author names, GPS coordinates, manager fields. Under GDPR Article 4(1), this is not a grey area.",
    readTime: "9 min read",
    href: "/blog/gdpr-pdf-metadata",
  },
  {
    category: "PDF Security",
    title: "How to View PDF Metadata on Mac, Windows & Linux",
    excerpt:
      "Step-by-step guide for every platform. From the one-click browser tool that works everywhere, to native OS viewers, to the command line for power users who want every byte.",
    readTime: "8 min read",
    href: "/blog/view-pdf-metadata-mac-windows-linux",
  },
  {
    category: "Legal & Professional",
    title: "How to Remove Metadata from a PDF Before Sending",
    excerpt:
      "A step-by-step guide for lawyers, freelancers, HR professionals, and anyone who sends sensitive documents. Four methods compared. Takes under two minutes.",
    readTime: "6 min read",
    href: "/blog/pdf-metadata-lawyers",
  },
  {
    category: "HR & Employment",
    title: "PDF Metadata in HR & Employment Documents: What HR Teams and Job Seekers Must Know",
    excerpt:
      "Offer letters, resumes, and HR documents contain hidden metadata that exposes names, salaries, and internal notes. What HR teams and job seekers need to know — and how to fix it.",
    readTime: "7 min read",
    href: "/blog/pdf-metadata-hr-employment-documents",
  },
];

const marqueeItems = [
  "PDF Metadata Remover",
  "CSV Deduplicator",
  "PDF Redactor",
  "Privacy Risk Score",
  "Browser-side Processing",
  "Zero Data Sent",
  "GDPR Friendly",
  "For Lawyers & Journalists",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary SEO -->
    <title>FileIntel</title>
    <meta
      name="description"
      content="Inspect, clean, and transform your files privately. PDF metadata removal, redaction, and more. Everything runs in your browser — your files never leave your device."
    />
    <link rel="canonical" href="https://fileintel.tech/" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://fileintel.tech/" />
    <meta
      property="og:title"
      content="FileIntel — Private File Tools for Professionals"
    />
    <meta
      property="og:description"
      content="PDF metadata removal, redaction, and more. 100% browser-side — your files never leave your device."
    />
    <meta property="og:image" content="https://fileintel.tech/og-image.png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="FileIntel — Private File Tools for Professionals"
    />
    <meta
      name="twitter:description"
      content="PDF metadata removal, redaction, and more. Your files never leave your browser."
    />
    <meta name="twitter:image" content="https://fileintel.tech/og-image.png" />

    <!-- Schema.org -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "FileIntel",
        "url": "https://fileintel.tech",
        "description": "Private file tools for professionals. PDF metadata removal, redaction, CSV deduplication — all browser-side.",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://fileintel.tech/search?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/styles/global.css" />
  </head>

  <body>
    <!-- ANNOUNCE -->
    <div class="announce">
      New: <a href="/pdf-metadata-remover"
        ><strong>PDF Privacy Risk Score</strong></a
      > — instantly see your document's privacy risk before stripping. →
    </div>

    <!-- NAV -->
    <Navbar activePage="home" />

    <!-- HERO -->
    <header
      style="max-width:var(--max-width);margin:0 auto;padding:96px 40px 80px;text-align:center;"
    >
      <div class="eyebrow">Private file tools for professionals</div>

      <h1
        style="font-family:var(--serif);font-size:clamp(48px,7vw,80px);line-height:1.04;letter-spacing:-0.03em;margin-bottom:24px;max-width:820px;margin-left:auto;margin-right:auto;"
      >
        Your files stay<br /><em style="font-style:italic;color:var(--accent);"
          >on your machine.</em
        >
      </h1>

      <p
        style="font-size:17px;color:var(--ink-2);line-height:1.65;margin-bottom:44px;max-width:520px;margin-left:auto;margin-right:auto;font-weight:300;"
      >
        FileIntel is a suite of file tools that process everything in your
        browser. No uploads. No accounts. No servers watching your documents.
      </p>

      <div
        style="display:flex;gap:12px;justify-content:center;margin-bottom:56px;"
      >
        <a href="#tools" class="btn btn-primary">
          Browse tools
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            ><line x1="5" y1="12" x2="19" y2="12"></line><polyline
              points="12 5 19 12 12 19"></polyline></svg
          >
        </a>
        <a href="#why" class="btn btn-secondary">How it works</a>
      </div>

      <div class="trust-row" style="justify-content:center;">
        <div class="trust-item">
          <span class="trust-check">✓</span> Zero server uploads
        </div>
        <div class="trust-item">
          <span class="trust-check">✓</span> No account required
        </div>
        <div class="trust-item">
          <span class="trust-check">✓</span> Open source
        </div>
        <div class="trust-item">
          <span class="trust-check">✓</span> Works offline
        </div>
        <div class="trust-item">
          <span class="trust-check">✓</span> Free forever
        </div>
      </div>
    </header>

    <!-- MARQUEE -->
    <div class="marquee-wrap">
      <div class="marquee-track" aria-hidden="true">
        {
          [...marqueeItems, ...marqueeItems].map((item) => (
            <span class="marquee-item">
              {item}
              <span class="marquee-dot" />
            </span>
          ))
        }
      </div>
    </div>

    <!-- TOOLS GRID -->
    <section
      id="tools"
      style="padding:88px 40px;max-width:var(--max-width);margin:0 auto;"
    >
      <div class="section-label">The suite</div>
      <h2 class="section-title">Every tool. Zero upload.</h2>
      <p class="section-sub">
        Built for professionals who send sensitive documents daily and can't
        afford data leaks.
      </p>

      <div
        class="tools-grid"
        style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;"
      >
        {
          tools.map((tool) => (
            <a
              href={tool.href}
              class={`tool-card ${tool.featured ? "featured" : ""} ${tool.dim ? "dim" : ""}`}
            >
              <div class="tool-icon">{tool.icon}</div>
              <span class={`tag tag-${tool.tag}`}>{tool.tagLabel}</span>
              <div class="tool-name">{tool.name}</div>
              <div class="tool-desc">{tool.desc}</div>
              <div class="tool-arrow">
                {tool.dim ? "In development" : "Open tool →"}
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- WHY SECTION -->
    <section class="section-dark" id="why" style="padding:88px 40px;">
      <div
        class="architecture-grid"
        style="max-width:var(--max-width);margin:0 auto;display:grid;grid-template-columns:1fr 1.4fr;gap:100px;align-items:center;"
      >
        <div>
          <div class="section-label">The architecture</div>
          <h2
            style="font-family:var(--serif);font-size:clamp(32px,4vw,46px);color:var(--paper);line-height:1.08;letter-spacing:-0.02em;margin-bottom:20px;"
          >
            Built so we<br /><em style="font-style:italic;color:#f0c060;"
              >can't</em
            > see<br />your files.
          </h2>
          <p
            style="font-size:15px;color:#7a7a72;font-weight:300;line-height:1.7;margin-bottom:36px;"
          >
            Most file tools process documents on their servers. We architected
            FileIntel so that's technically impossible — not just a policy
            promise.
          </p>

          <div style="display:flex;flex-direction:column;gap:0;">
            {
              [
                {
                  n: "01",
                  h: "No upload endpoint exists",
                  p: "There is no server route that accepts file data. You can't accidentally send us your document.",
                },
                {
                  n: "02",
                  h: "PDF.js runs in your browser tab",
                  p: "All parsing happens locally using Mozilla's open source PDF.js — the same engine Firefox uses.",
                },
                {
                  n: "03",
                  h: "Memory cleared on tab close",
                  p: "When you close the tab, everything disappears. No cache, no session storage, no trace.",
                },
                {
                  n: "04",
                  h: "Open source — verify it yourself",
                  p: "Every line of code is on GitHub. Audit exactly what happens to your file.",
                },
              ].map((pt) => (
                <div style="padding:20px 0;border-bottom:1px solid #1e1e1a;display:flex;gap:16px;align-items:flex-start;">
                  <span style="font-family:var(--mono);font-size:11px;color:#3a3a35;font-weight:500;padding-top:2px;flex-shrink:0;">
                    {pt.n}
                  </span>
                  <div>
                    <h4 style="font-size:14px;font-weight:600;color:var(--paper);margin-bottom:4px;">
                      {pt.h}
                    </h4>
                    <p style="font-size:13px;color:#5a5a52;line-height:1.6;">
                      {pt.p}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- ARCH CARD -->
        <div
          style="background:#0a0a08;border:1px solid #1e1e1a;border-radius:var(--radius-lg);overflow:hidden;"
        >
          <div
            style="padding:16px 20px;border-bottom:1px solid #1a1a17;display:flex;align-items:center;gap:10px;"
          >
            <div style="display:flex;gap:6px;">
              <div
                style="width:10px;height:10px;border-radius:50%;background:#ff5f57;"
              >
              </div>
              <div
                style="width:10px;height:10px;border-radius:50%;background:#febc2e;"
              >
              </div>
              <div
                style="width:10px;height:10px;border-radius:50%;background:#28c840;"
              >
              </div>
            </div>
            <span
              style="font-family:var(--mono);font-size:11px;color:#A1A1AA;letter-spacing:0.06em;"
              >fileintel — processing pipeline</span
            >
          </div>
          <div style="padding:28px;display:flex;flex-direction:column;gap:4px;">
            {
              [
                {
                  icon: "📂",
                  title: "You select a file",
                  sub: "File object stays in browser memory",
                },
                {
                  icon: "⚙️",
                  title: "PDF.js parses it locally",
                  sub: "file.arrayBuffer() → in-tab processing",
                },
                {
                  icon: "🔍",
                  title: "Metadata surfaced in UI",
                  sub: "XMP + DocInfo streams parsed",
                },
                {
                  icon: "💾",
                  title: "Clean file downloaded",
                  sub: "Rewritten in memory → direct download",
                },
              ].map((step, i) => (
                <>
                  <div style="display:flex;align-items:center;gap:14px;padding:14px 16px;border-radius:var(--radius);">
                    <div style="width:36px;height:36px;border-radius:var(--radius);background:#1a1a17;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;">
                      {step.icon}
                    </div>
                    <div>
                      <h5 style="font-size:13px;font-weight:500;color:var(--paper);margin-bottom:2px;">
                        {step.title}
                      </h5>
                      <p style="font-size:11.5px;color:#9A9A94;font-family:var(--mono);">
                        {step.sub}
                      </p>
                    </div>
                  </div>
                  {i < 3 && (
                    <div style="text-align:center;color:#2a2a27;font-size:12px;">
                      ↓
                    </div>
                  )}
                </>
              ))
            }
            <div
              style="margin-top:8px;padding:16px;background:#0f1a14;border:1px solid #1e3028;border-radius:var(--radius);font-family:var(--mono);font-size:11.5px;color:#4a9a6a;display:flex;align-items:center;gap:8px;"
            >
              <span>✓</span>
              <span>0 bytes sent to any server at any step</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- STATS -->
    <section style="padding:72px 40px;background:var(--paper);">
      <div style="max-width:var(--max-width);margin:0 auto;">
        <div class="stats-grid">
          <div class="stat-box">
            <div class="stat-num">23+</div>
            <div class="stat-label">Metadata fields inspected per PDF</div>
          </div>
          <div class="stat-box">
            <div class="stat-num">0 bytes</div>
            <div class="stat-label">Data sent to our servers. Ever.</div>
          </div>
          <div class="stat-box">
            <div class="stat-num">~2s</div>
            <div class="stat-label">Average processing time per file</div>
          </div>
          <div class="stat-box">
            <div class="stat-num">Free</div>
            <div class="stat-label">No plans. No paywalls. No limits.</div>
          </div>
        </div>
      </div>
    </section>

    <!-- BLOG -->
    <section
      style="padding:88px 40px;max-width:var(--max-width);margin:0 auto;"
    >
      <div class="section-label">From the blog</div>
      <h2 class="section-title">Why this matters</h2>
      <p class="section-sub">
        Guides on file privacy, document security, and protecting your data
        before sharing.
      </p>

      <div
        class="blog-grid"
        style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;"
      >
        {
          blogs.map((post) => (
            <a href={post.href} class="blog-card">
              <div class="blog-card-body">
                <div class="blog-category">{post.category}</div>
                <div class="blog-title">{post.title}</div>
                <div class="blog-excerpt">{post.excerpt}</div>
              </div>
              <div class="blog-card-foot">
                <span class="blog-meta">{post.readTime}</span>
                <span class="blog-read">Read →</span>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- CTA -->
    <section class="section-dark" style="padding:100px 40px;text-align:center;">
      <div
        style="font-family:var(--mono);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:#7C7C78;margin-bottom:20px;"
      >
        Start now — no account needed
      </div>
      <h2
        style="font-family:var(--serif);font-size:clamp(36px,5vw,58px);color:var(--paper);line-height:1.08;letter-spacing:-0.02em;margin-bottom:16px;"
      >
        Try a tool.<br /><em style="font-style:italic;color:#f0c060;"
          >Keep your files.</em
        >
      </h2>
      <p
        style="font-size:15px;color:#5a5a52;margin-bottom:44px;font-weight:300;max-width:420px;margin-left:auto;margin-right:auto;"
      >
        Pick any tool. Drop a file. Done in under 30 seconds. Nothing leaves
        your device.
      </p>
      <div style="display:flex;gap:12px;justify-content:center;">
        <a href="#tools" class="btn btn-light">
          Browse tools
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            ><line x1="5" y1="12" x2="19" y2="12"></line><polyline
              points="12 5 19 12 12 19"></polyline></svg
          >
        </a>
        <a
          href="https://github.com/Darshwan/FileIntel"
          target="_blank"
          rel="noopener"
          class="btn btn-ghost"
        >
          View on GitHub →
        </a>
      </div>
    </section>

    <!-- FOOTER -->
    <Footer />
  </body>
</html>
