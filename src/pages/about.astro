---
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";

// src/pages/about.astro
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>About | FileIntel</title>
    <meta
      name="description"
      content="FileIntel is a suite of private file tools built for professionals. No uploads, no accounts, no servers watching your documents."
    />
    <link rel="canonical" href="https://fileintel.me/about" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="/styles/global.css" />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      :root {
        --ink: #0f0f0d;
        --ink-2: #3a3a35;
        --ink-3: #7a7a72;
        --paper: #f5f3ee;
        --paper-2: #eceae3;
        --paper-3: #e2dfd6;
        --accent: #c8432a;
        --green: #2a6b4a;
        --green-light: #e8f2ec;
        --green-border: #b8ddc8;
        --amber: #b06820;
        --amber-light: #fef3e2;
        --border: #d4d1c8;
        --white: #fafaf8;
        --serif: "Instrument Serif", Georgia, serif;
        --mono: "DM Mono", "Courier New", monospace;
        --sans: "Geist", system-ui, sans-serif;
        --radius: 4px;
        --radius-lg: 8px;
      }
      body {
        font-family: var(--sans);
        background: var(--paper);
        color: var(--ink);
        line-height: 1.6;
      }
          .announce { padding: 8px; }

      .title {
        font-weight: bold;
        letter-spacing: 0.09rem;
        font-size: 2rem;
      }
      .nav {
        background: var(--white);
        border-bottom: 1px solid var(--border);
        padding: 0 40px;
        position: sticky;
        top: 0;
        z-index: 100;
      }
      .nav-inner {
        max-width: 1160px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 56px;
      }
      .nav-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
      }
      .nav-logo-mark {
        width: 28px;
        height: 28px;
        background: var(--ink);
        border-radius: var(--radius);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--mono);
        font-size: 12px;
        font-weight: 700;
        color: var(--paper);
      }
      .nav-logo-text {
        font-size: 14px;
        font-weight: 600;
        color: var(--ink);
        line-height: 1.1;
      }
      .nav-logo-sub {
        font-family: var(--mono);
        font-size: 9px;
        color: var(--ink-3);
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }
      .nav-links {
        display: flex;
        align-items: center;
        gap: 28px;
        list-style: none;
      }
      .nav-links a {
        font-size: 13px;
        color: var(--ink-2);
        text-decoration: none;
        font-weight: 500;
        transition: color 0.15s;
      }
      .nav-links a:hover {
        color: var(--ink);
      }
      .nav-badge {
        font-family: var(--mono);
        font-size: 10px;
        background: var(--green-light);
        color: var(--green);
        border: 1px solid var(--green-border);
        padding: 3px 8px;
        border-radius: 3px;
      }
      @media (max-width: 700px) {
        .nav-links {
          display: none;
        }
        .nav {
          padding: 0 20px;
        }
      }

      .hero {
        background: var(--ink);
        padding: 64px 40px 56px;
        position: relative;
        overflow: hidden;
      }
      .hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
          linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.025) 1px,
            transparent 1px
          );
        background-size: 48px 48px;
        pointer-events: none;
      }
      .hero-inner {
        max-width: 1160px;
        margin: 0 auto;
        position: relative;
        z-index: 1;
      }
      .hero-eyebrow {
        font-family: var(--mono);
        font-size: 10.5px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 18px;
      }
      .hero-title {
        font-family: var(--serif);
        font-size: clamp(30px, 4.5vw, 52px);
        color: var(--paper);
        line-height: 1.08;
        letter-spacing: -0.025em;
        margin-bottom: 20px;
      }
      .hero-sub {
        font-size: 16px;
        color: #7a7a72;
        max-width: 520px;
        line-height: 1.65;
      }
      @media (max-width: 700px) {
        .hero {
          padding: 40px 20px 36px;
        }
      }

      .page-wrap {
        max-width: 1160px;
        margin: 0 auto;
        padding: 56px 40px 80px;
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 64px;
      }
      @media (max-width: 960px) {
        .page-wrap {
          grid-template-columns: 1fr;
          padding: 32px 20px 60px;
        }
      }

      .prose h2 {
        font-family: var(--serif);
        font-size: clamp(20px, 2.5vw, 26px);
        letter-spacing: -0.02em;
        color: var(--ink);
        margin: 12px 0 16px;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--paper-3);
      }
      .prose p {
        font-size: 15.5px;
        color: var(--ink-2);
        line-height: 1.8;
        margin-bottom: 18px;
      }
      .prose a {
        color: var(--accent);
        text-decoration: none;
        border-bottom: 1px solid rgba(200, 67, 42, 0.3);
      }
      .prose a:hover {
        border-bottom-color: var(--accent);
      }
      .prose strong {
        color: var(--ink);
        font-weight: 600;
      }

      .founder-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 24px;
        margin: 32px 0;
        display: flex;
        align-items: center;
        gap: 20px;
      }
      .founder-avatar {
        width: 90px;
        height: 90px;
        border-radius: 5%;
        object-fit: cover;
        overflow: hidden;
      }
      .founder-name {
        font-size: 16px;
        font-weight: 600;
        color: var(--ink);
        margin-bottom: 4px;
      }
      .founder-role {
        font-family: var(--mono);
        font-size: 11px;
        color: var(--ink-3);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 6px;
      }
      .founder-bio {
        font-size: 13.5px;
        color: var(--ink-3);
        line-height: 1.5;
      }

      .values-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin: 24px 0;
      }
      @media (max-width: 600px) {
        .values-grid {
          grid-template-columns: 1fr;
        }
      }
      .value-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 18px 20px;
      }
      .value-icon {
        font-size: 20px;
        margin-bottom: 10px;
      }
      .value-title {
        font-size: 14px;
        font-weight: 600;
        color: var(--ink);
        margin-bottom: 6px;
      }
      .value-desc {
        font-size: 13px;
        color: var(--ink-3);
        line-height: 1.55;
      }
      .contact-list {
        margin-top: 20px;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .contact-item {
        display: flex;
        align-items: center;
        gap: 14px;

        padding: 14px 16px;

        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);

        color: var(--ink);
        text-decoration: none;

        transition: all 0.18s ease;
      }

      .contact-item:hover {
        background: var(--paper-2);
        border-color: var(--accent);
        transform: translateY(-1px);
      }

      .contact-item svg {
        width: 22px;
        height: 22px;
        flex-shrink: 0;
      }

      .contact-label {
        width: 90px;
        font-weight: 600;
        color: var(--ink);
      }

      .contact-value {
        color: var(--ink-3);
        word-break: break-word;
      }

      .contact-note {
        margin-top: 16px;
        color: var(--ink-3);
        font-size: 14px;
      }

      @media (max-width: 640px) {
        .contact-item {
          flex-wrap: wrap;
          align-items: flex-start;
        }

        .contact-label {
          width: 100%;
          margin-bottom: 2px;
        }
      }
      .sidebar {
        position: sticky;
        top: 58px;
        display: flex;
        flex-direction: column;
        gap: 16px;
      }
      @media (max-width: 960px) {
        .sidebar {
          position: static;
        }
      }
      .sidebar-widget {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
      }
      .sidebar-widget-header {
        padding: 12px 16px;
        border-bottom: 1px solid var(--paper-3);
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-3);
        font-weight: 600;
      }
      .sidebar-widget-body {
        padding: 14px 16px;
      }
      .sidebar-link {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: var(--ink-2);
        text-decoration: none;
        padding: 7px 0;
        border-bottom: 1px solid var(--paper-3);
        transition: color 0.15s;
      }
      .sidebar-link:last-child {
        border-bottom: none;
      }
      .sidebar-link:hover {
        color: var(--accent);
      }
      .tools-sidebar {
        display: flex;
        flex-direction: column;
        padding: 0;
      }

      .tool-sidebar-link {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;

        padding: 12px 16px;
        text-decoration: none;
        color: var(--ink);

        border-bottom: 1px solid var(--paper-3);
        transition:
          background 0.18s ease,
          color 0.18s ease;
      }

      .tool-sidebar-link:last-child {
        border-bottom: none;
      }

      .tool-sidebar-link:hover {
        background: var(--paper-2);
      }

      .tool-sidebar-link span:first-child {
        font-size: 13px;
        font-family: var(--mono);
        line-height: 1.35;
      }
      .tool-row-status {
        font-size: 11px;
      }
      .tool-row-status.live {
        color: var(--green);
      }
      .stat-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
      }
      .stat-box {
        background: var(--paper-2);
        border-radius: var(--radius);
        padding: 12px;
        text-align: center;
      }
      .stat-num {
        font-weight: bold;
        font-size: 20px;
        font-family: var(--sans);
      }
      .stat-label {
        font-size: 11px;
        color: var(--ink-3);
        margin-top: 2px;
      }
    </style>
  </head>
  <body>
    <div
      id="reading-progress"
      aria-hidden="true"
      style="position:fixed;top:0;left:0;width:0%;height:3px;background:var(--accent);z-index:9999;transition:width 0.08s linear;border-radius:0 2px 2px 0;pointer-events:none;"
    >
    </div>
    <!-- ANNOUNCE -->
    <div class="announce">
      New: <a href="/pdf-metadata-remover"
        ><strong>PDF Privacy Risk Score</strong></a
      > — instantly see your document's privacy risk before stripping. →
    </div>
    <Navbar activePage="/about" />

    <section class="hero">
      <div class="hero-inner">
        <div class="hero-eyebrow">About</div>
        <h1 class="hero-title">
          Built because privacy shouldn't require trust
        </h1>
        <p class="hero-sub">
          FileIntel started with a simple question: why do PDF tools need to see
          your files at all? They don't. So we built ones that don't.
        </p>
      </div>
    </section>

    <div class="page-wrap">
      <div class="prose">
        <h2 id="story" class="title">The story</h2>
        <p>
          Most online file tools work the same way: you upload your document to
          their server, they process it, and send it back. That means your
          contracts, your legal filings, your client proposals — all passing
          through someone else's infrastructure, logged, potentially stored,
          potentially readable.
        </p>
        <p>
          FileIntel does none of that. Every tool runs entirely in your browser
          using JavaScript. Your files are read into memory locally, processed
          locally, and downloaded locally. Nothing travels across the internet
          to us. We don't have servers that receive files because we
          deliberately chose not to build them.
        </p>
        <p>
          The result is a set of professional document tools that are genuinely
          private — not "private" as a marketing claim, but private as a
          technical fact you can verify yourself.
        </p>

        <h2 id="founder" class="title">The founder</h2>
        <div class="founder-card">
          <div class="founder-avatar">
            <img src="/images/darshan.png" alt="Darshan Lamichhane" />
          </div>
          <div>
            <div class="founder-name">Darshan Lamichhane</div>
            <div class="founder-role">
              Founder &amp; Developer &middot; Nepal
            </div>
            <div class="founder-bio">
              Building FileIntel as an independent project. Focused on
              privacy-first tools for professionals who handle sensitive
              documents daily.
            </div>
          </div>
        </div>
        <p>
          FileIntel is an independent project — not a startup, not VC-backed,
          not optimising for growth metrics. It exists because the tools should
          exist. The source code is on <a
            href="https://github.com/Darshwan/fileintel"
            target="_blank"
            rel="noopener">GitHub</a
          >. You can read every line.
        </p>

        <h2 id="values" class="title">What we stand for</h2>
        <div class="values-grid">
          <div class="value-card">
            <div class="value-icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                shape-rendering="geometricPrecision"
                text-rendering="geometricPrecision"
                image-rendering="optimizeQuality"
                fill-rule="evenodd"
                width="24"
                height="24"
                clip-rule="evenodd"
                viewBox="0 0 498 512.17"
                ><path
                  d="M232.21 0c86.9 55.08 165.4 81.14 232.78 74.98 3.67 74.22-2.36 138.96-17.12 194.7-10-4.08-20.68-6.52-31.7-7 11.57-46.07 16.23-99.25 13.23-159.92-57.04 5.22-123.5-16.84-197.06-63.48C168.68 88.73 103 103.21 36.04 99.7c-2.97 113.09 16.9 198.24 55.29 260.18 28.38-23.73 76.71-20.15 99.6-51.62 1.65-2.43 2.41-3.74 2.39-4.81-.01-.56-24.83-31-27.06-34.55-5.85-9.3-16.8-21.93-16.8-32.82 0-6.15 4.85-14.17 11.8-15.96-.54-9.22-.91-18.57-.91-27.84 0-5.47.1-11.01.3-16.43.3-3.44.94-4.95 1.85-8.27a58.537 58.537 0 0 1 26.13-33.18c4.43-2.8 9.25-4.98 14.19-6.77 8.96-3.27 4.62-17.43 14.46-17.65 22.99-.59 60.81 19.51 75.54 35.48 9.39 10.38 14.75 21.92 15.07 35.92l-.93 40.27c4.08 1 8.66 4.19 9.66 8.28 3.15 12.71-10.04 28.53-16.18 38.64-5.65 9.33-27.26 34.79-27.28 35-.1 1.09.46 2.47 1.94 4.69 10.53 14.48 26.44 21.54 43.3 27.25-1.87 6.71-3.07 13.64-3.53 20.74-1.76 1.23-3.4 2.6-4.91 4.11l-.1.1c-6.73 6.75-10.93 16.04-10.93 26.26v93.19c-20.32 12.65-42.28 23.4-65.81 32.26C82.71 457.27-6.26 322.77.34 71.37 79.43 75.51 157.03 58.41 232.21 0zm105.67 375.54h3.88v-11.95c0-19.96 7.87-38.16 20.55-51.39 12.79-13.33 30.44-21.6 49.88-21.6s37.11 8.27 49.88 21.6c12.69 13.23 20.56 31.42 20.56 51.39v11.95h3.88c6.32 0 11.49 5.18 11.49 11.5v113.63c0 6.33-5.17 11.5-11.49 11.5H337.88c-6.33 0-11.49-5.17-11.49-11.5V387.04c-.01-6.32 5.16-11.5 11.49-11.5zm65.2 73.48-11.96 31.34h42.13l-11.08-31.77c7.04-3.62 11.85-10.95 11.85-19.41 0-12.06-9.77-21.82-21.84-21.82-12.05 0-21.82 9.76-21.82 21.82 0 8.8 5.21 16.38 12.72 19.84zm-39.57-73.48h97.35v-11.95c0-14.2-5.53-27.06-14.43-36.34-8.81-9.19-20.93-14.9-34.24-14.9-13.31 0-25.44 5.71-34.24 14.9-8.91 9.28-14.44 22.14-14.44 36.34v11.95z"
                ></path></svg
              >
            </div>
            <div class="value-title">Privacy by design</div>
            <div class="value-desc">
              Not a checkbox. A technical constraint we built around from the
              start.
            </div>
          </div>
          <div class="value-card">
            <div class="value-icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                shape-rendering="geometricPrecision"
                text-rendering="geometricPrecision"
                image-rendering="optimizeQuality"
                fill-rule="evenodd"
                width="24"
                height="24"
                clip-rule="evenodd"
                viewBox="0 0 512 472.37"
                ><path
                  fill-rule="nonzero"
                  d="M145.33 172.6l57.21-.75c2.76-.04 5.33.74 7.51 2.1 11.85 6.86 23.04 14.67 33.45 23.48 5.86 4.97 11.53 10.28 16.99 15.96 19.67-30.56 43.04-61.58 67.52-90.78 31.9-38.04 65.91-73.2 96.22-100.37 2.65-2.37 5.97-3.53 9.26-3.53l44.22-.07c7.7 0 13.95 6.25 13.95 13.95 0 3.86-1.56 7.34-4.09 9.87-40.58 45.12-82.2 96.78-119.92 149.72-34.92 49.02-66.55 99.17-90.93 146.26-3.52 6.83-11.92 9.51-18.75 5.99a13.796 13.796 0 01-6.23-6.5c-13.36-28.57-29.28-54.8-48.23-78.2-18.93-23.37-41-44.09-66.69-61.72-6.35-4.33-7.98-13-3.65-19.35 2.82-4.14 7.49-6.27 12.16-6.06zM62.55 0h270.16c-19.14 19.72-35.72 38.96-49.97 57.45H62.55c-1.42 0-2.71.57-3.64 1.46a5.27 5.27 0 00-1.46 3.64v347.26c0 1.34.6 2.6 1.54 3.55.96.95 2.23 1.56 3.56 1.56h386.89c1.29 0 2.55-.62 3.52-1.58.97-.97 1.59-2.24 1.59-3.53V213.59c20.82-8.61 40.4-17.48 57.45-25.81v222.03c0 17.14-7.11 32.82-18.43 44.14-11.33 11.33-26.99 18.42-44.13 18.42H62.55c-17.13 0-32.83-7.06-44.17-18.4C7.08 442.67 0 427.03 0 409.81V62.55C0 45.4 7.04 29.78 18.35 18.46l.11-.11C29.78 7.04 45.4 0 62.55 0z"
                ></path></svg
              >
            </div>
            <div class="value-title">Verifiable claims</div>
            <div class="value-desc">
              Everything we say about how our tools work can be confirmed in
              DevTools or source code.
            </div>
          </div>
          <div class="value-card">
            <div class="value-icon">
              <!--?xml version="1.0" encoding="utf-8"?-->
              <svg
                version="1.1"
                id="Layer_1"
                xmlns="http://www.w3.org/2000/svg"
                xmlns:xlink="http://www.w3.org/1999/xlink"
                x="0px"
                y="0px"
                viewBox="0 0 102.85 122.88"
                width="24"
                height="24"
                style="enable-background:new 0 0 102.85 122.88"
                xml:space="preserve"
                ><style type="text/css">
                  .st0 {
                    fill-rule: evenodd;
                    clip-rule: evenodd;
                  }
                </style><g
