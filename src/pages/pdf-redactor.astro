---
// src/pages/pdf-redactor.astro
// FileIntel — PDF Redactor
// Production: PDF.js rendering + canvas overlay + keyword search + pdf-lib flatten

import Navbar from '../components/Navbar.astro';
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>PDF Redactor — Free, Private, No Upload | FileIntel</title>
        <meta
            name="description"
            content="Redact sensitive text from PDF files privately. Draw redaction boxes or search by keyword. Text is permanently removed — not just covered. 100% browser-side."
        />
        <link rel="canonical" href="https://fileintel.me/pdf-redactor" />
        <meta property="og:type" content="website" />
        <meta property="og:url" content="https://fileintel.me/pdf-redactor" />
        <meta
            property="og:title"
            content="PDF Redactor — Free & Private | FileIntel"
        />
        <meta
            property="og:description"
            content="Permanently redact sensitive text from PDFs. Draw boxes or search keywords. Browser-only — your file never leaves your device."
        />
        <meta
            property="og:image"
            content="https://fileintel.me/og-pdf-redactor.png"
        />
        <meta name="twitter:card" content="summary_large_image" />

        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "WebApplication",
                "name": "PDF Redactor",
                "description": "Permanently redact sensitive text from PDF files in your browser. Draw redaction boxes or search by keyword.",
                "url": "https://fileintel.me/pdf-redactor",
                "applicationCategory": "UtilitiesApplication",
                "operatingSystem": "Any",
                "offers": {
                    "@type": "Offer",
                    "price": "0",
                    "priceCurrency": "USD"
                }
            }
        </script>

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="stylesheet" href="/styles/global.css" />

        <style>
            /* ══ PAGE HERO ══ */
            .page-hero {
                background: var(--paper);
                padding: 40px 20px 36px;
                border-bottom: 1px solid var(--border);
                position: relative;
                overflow: hidden;
            }

            .page-hero::before {
                content: '';
                position: absolute;
                inset: 0;
                background-image: radial-gradient(circle, rgba(0,0,0,0.02) 1px, transparent 1px);
                background-size: 28px 28px;
                pointer-events: none;
            }

            .page-hero-inner {
                max-width: var(--max-width);
                margin: 0 auto;
                position: relative;
                z-index: 1;
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                gap: 40px;
                flex-wrap: wrap;
            }
            .page-hero-inner .how-it-works{
                display:flex;
                flex-direction:column;
                gap:20px;
                min-width:220px;
            }

            .page-hero h1 {
                font-family: var(--serif);
                font-size: clamp(36px, 3.5vw, 44px);
                color: var(--ink);
                letter-spacing: -0.02em;
                line-height: 1.08;
                margin-bottom: 12px;
            }

            .page-hero h1 em { font-style: italic; color: var(--accent); }
            .page-hero p { font-size: 14px; color: var(--ink-2); line-height: 1.65; font-weight: 300; max-width: 440px; }
            @media (max-width: 768px) {
                .page-hero-inner .how-it-works{ min-width: 100%; }
                
            }
            /* ══ PAGE LAYOUT ══ */
            .redactor-page {
                max-width: var(--max-width);
                margin: 0 auto;
                padding: 40px 20px 80px;
                display: grid;
                grid-template-columns: 280px 1fr;
                gap: 24px;
                align-items: start;
                min-height: calc(100vh - var(--nav-height));
            }

            /* ══ LEFT SIDEBAR ══ */
            .sidebar {
                position: sticky;
                top: calc(var(--nav-height) + 20px);
                display: flex;
                flex-direction: column;
                gap: 12px;
            }

            .sidebar-card {
                background: var(--white);
                border: 1px solid var(--border);
                border-radius: var(--radius-lg);
                overflow: hidden;
            }

            .sidebar-header {
                padding: 13px 16px;
                border-bottom: 1px solid var(--paper-3);
                font-family: var(--mono);
                font-size: 10.5px;
                font-weight: 600;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                color: var(--ink-3);
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .sidebar-body {
                padding: 14px 16px;
            }

            /* ══ TOOL MODES ══ */
            .mode-tabs {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 4px;
                padding: 12px;
                border-bottom: 1px solid var(--paper-3);
            }

            .mode-tab {
                padding: 9px 8px;
                border-radius: var(--radius);
                border: 1px solid var(--border);
                background: var(--paper);
                font-size: 12px;
                font-weight: 500;
                cursor: pointer;
                font-family: var(--sans);
                color: var(--ink-2);
                transition: all 0.15s;
                text-align: center;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
            }

            .mode-tab:hover {
                background: var(--paper-2);
                border-color: var(--ink-3);
            }
            .mode-tab.active {
                background: var(--ink);
                color: var(--white);
                border-color: var(--ink);
            }

            /* ══ KEYWORD SEARCH ══ */
            .keyword-input-wrap {
                display: flex;
                gap: 6px;
                margin-bottom: 10px;
            }

            .keyword-input {
                flex: 1;
                padding: 8px 11px;
                border: 1px solid var(--border);
                border-radius: var(--radius);
                font-size: 13px;
                font-family: var(--sans);
                background: var(--paper);
                color: var(--ink);
                outline: none;
                transition: border-color 0.15s;
            }

            .keyword-input:focus {
                border-color: var(--ink-2);
                background: var(--white);
            }

            .keyword-add-btn {
                padding: 8px 12px;
                background: var(--ink);
                color: var(--white);
                border: none;
                border-radius: var(--radius);
                font-size: 12px;
                font-weight: 600;
                cursor: pointer;
                font-family: var(--sans);
                transition: background 0.15s;
                white-space: nowrap;
            }

            .keyword-add-btn:hover {
                background: #1e1e1a;
            }

            .keyword-list {
                display: flex;
                flex-direction: column;
                gap: 5px;
                max-height: 180px;
                overflow-y: auto;
            }

            .keyword-chip {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 6px 10px;
                background: var(--paper-2);
                border: 1px solid var(--border);
                border-radius: var(--radius);
                font-size: 12px;
                font-family: var(--mono);
                color: var(--ink-2);
                gap: 8px;
            }

            .keyword-chip-text {
                flex: 1;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .keyword-chip-count {
                font-size: 10px;
                background: var(--accent);
                color: white;
                padding: 1px 6px;
                border-radius: 10px;
                font-weight: 600;
                flex-shrink: 0;
            }

            .keyword-chip-count.zero {
                background: var(--paper-3);
                color: var(--ink-3);
            }

            .keyword-remove {
                background: none;
                border: none;
                cursor: pointer;
                color: var(--ink-3);
                font-size: 14px;
                line-height: 1;
                padding: 0;
                flex-shrink: 0;
                transition: color 0.15s;
            }

            .keyword-remove:hover {
                color: var(--accent);
            }

            /* ══ COLOR PICKER ══ */
            .color-options {
                display: flex;
                gap: 6px;
                flex-wrap: wrap;
            }

            .color-opt {
                width: 28px;
                height: 28px;
                border-radius: var(--radius);
                border: 2px solid transparent;
                cursor: pointer;
                transition: all 0.15s;
                position: relative;
            }

            .color-opt.selected {
                border-color: var(--ink);
                transform: scale(1.1);
            }

            .color-opt:hover {
                transform: scale(1.08);
            }

            /* ══ ZONES LIST ══ */
            .zones-list {
                display: flex;
                flex-direction: column;
                gap: 4px;
                max-height: 200px;
                overflow-y: auto;
            }

            .zone-item {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 7px 10px;
                background: var(--paper);
                border: 1px solid var(--border);
                border-radius: var(--radius);
                font-size: 11.5px;
                color: var(--ink-2);
                font-family: var(--mono);
                cursor: pointer;
                transition: all 0.15s;
            }

            .zone-item:hover {
                border-color: var(--accent);
                background: var(--red-light);
            }

            .zone-item-dot {
                width: 10px;
                height: 10px;
                border-radius: 2px;
                flex-shrink: 0;
            }

            .zone-item-label {
                flex: 1;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .zone-remove {
                background: none;
                border: none;
                cursor: pointer;
                color: var(--ink-3);
                font-size: 13px;
                padding: 0;
                line-height: 1;
                transition: color 0.15s;
            }

            .zone-remove:hover {
                color: var(--accent);
            }

            .zones-empty {
                font-size: 12px;
                color: var(--ink-3);
                text-align: center;
                padding: 16px 0;
                font-style: italic;
            }

            /* ══ STATS BAR ══ */
            .redact-stats {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 1px;
                background: var(--border);
                border: 1px solid var(--border);
                border-radius: var(--radius);
                overflow: hidden;
                margin-bottom: 12px;
            }

            .redact-stat {
                background: var(--white);
                padding: 10px 12px;
                text-align: center;
            }

            .redact-stat-num {
                font-family: var(--serif);
                font-size: 22px;
                font-style: italic;
                color: var(--ink);
                line-height: 1;
            }

            .redact-stat-label {
                font-size: 10px;
                color: var(--ink-3);
                font-family: var(--mono);
                letter-spacing: 0.04em;
                text-transform: uppercase;
                margin-top: 2px;
            }

            /* ══ ACTION BUTTONS ══ */
            .sidebar-actions {
                display: flex;
                flex-direction: column;
                gap: 6px;
            }

            .sidebar-actions .btn {
                justify-content: center;
                padding: 11px 16px;
                font-size: 13px;
            }

            /* ══ MAIN CANVAS AREA ══ */
            .canvas-area {
                background: var(--white);
                border: 1px solid var(--border);
                border-radius: var(--radius-lg);
                overflow: hidden;
                min-height: 600px;
                display: flex;
                flex-direction: column;
            }

            .canvas-toolbar {
                padding: 10px 16px;
                border-bottom: 1px solid var(--paper-3);
                display: flex;
                align-items: center;
                gap: 10px;
                background: var(--paper);
                flex-wrap: wrap;
            }

            .canvas-toolbar-label {
                font-family: var(--mono);
                font-size: 10.5px;
                color: var(--ink-3);
                letter-spacing: 0.06em;
                text-transform: uppercase;
            }

            .page-nav {
                display: flex;
                align-items: center;
                gap: 6px;
                margin-left: auto;
            }

            .page-nav-btn {
                width: 28px;
                height: 28px;
                border: 1px solid var(--border);
                background: var(--white);
                border-radius: var(--radius);
                cursor: pointer;
                font-size: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: all 0.15s;
                font-family: var(--sans);
            }

            .page-nav-btn:hover {
                background: var(--paper-2);
                border-color: var(--ink-3);
            }
            .page-nav-btn:disabled {
                opacity: 0.3;
                cursor: default;
            }

            .page-indicator {
                font-family: var(--mono);
                font-size: 11.5px;
                color: var(--ink-2);
                min-width: 60px;
                text-align: center;
            }

            .zoom-select {
                padding: 4px 8px;
                border: 1px solid var(--border);
                border-radius: var(--radius);
                font-size: 12px;
                font-family: var(--mono);
                background: var(--white);
                color: var(--ink-2);
                cursor: pointer;
                outline: none;
            }

            /* ══ CANVAS CONTAINER ══ */
            .canvas-container {
                flex: 1;
                overflow: auto;
                background: #e8e5de;
                display: flex;
                align-items: flex-start;
                justify-content: center;
                padding: 24px;
                min-height: 500px;
                position: relative;
            }

            .canvas-wrapper {
                position: relative;
                display: inline-block;
                box-shadow: var(--shadow-lg);
                border-radius: 2px;
                cursor: crosshair;
                line-height: 0;
            }

            /* Draw mode cursor */
            .canvas-wrapper.mode-draw {
                cursor: crosshair;
            }
            .canvas-wrapper.mode-keyword {
                cursor: default;
            }

            #pdf-canvas {
                display: block;
                border-radius: 2px;
            }

            #overlay-canvas {
                position: absolute;
                inset: 0;
                border-radius: 2px;
                pointer-events: none;
            }

            #interaction-canvas {
                position: absolute;
                inset: 0;
                border-radius: 2px;
            }

            /* ══ UPLOAD STATE ══ */
            .upload-state {
                flex: 1;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 60px 40px;
                text-align: center;
                background: var(--paper);
            }

            .upload-drop-zone {
                width: 100%;
                max-width: 420px;
                border: 1.5px dashed var(--border);
                border-radius: var(--radius-lg);
                padding: 48px 32px;
                cursor: pointer;
                transition: all 0.2s;
                background: var(--white);
                user-select: none;
            }

            .upload-drop-zone * {
                pointer-events: none;
            }
            .upload-drop-zone:hover {
                border-color: var(--ink-2);
                background: var(--paper);
            }
            .upload-drop-zone.drag-active {
                border-color: var(--green);
                background: var(--green-light);
                border-style: solid;
            }

            .upload-drop-zone h3 {
                font-size: 15px;
                font-weight: 600;
                color: var(--ink);
                margin-bottom: 6px;
            }
            .upload-drop-zone p {
                font-size: 13px;
                color: var(--ink-3);
                margin-bottom: 20px;
            }

            /* ══ LOADING STATE ══ */
            .loading-state {
                flex: 1;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 60px;
                background: var(--paper);
            }

            .spinner {
                width: 36px;
                height: 36px;
                border: 3px solid var(--paper-3);
                border-top-color: var(--ink);
                border-radius: 50%;
                margin: 0 auto 16px;
                animation: spin 0.75s linear infinite;
            }

            @keyframes spin {
                to {
                    transform: rotate(360deg);
                }
            }

            /* ══ KEYWORD HIGHLIGHTS (on overlay) ══ */
            .highlight-match {
                position: absolute;
                background: rgba(255, 200, 0, 0.35);
                border: 1.5px solid rgba(200, 150, 0, 0.6);
                border-radius: 2px;
                pointer-events: none;
            }

            /* ══ PROGRESS BAR ══ */
            .progress-wrap {
                height: 3px;
                background: var(--paper-3);
                display: none;
            }

            .progress-fill {
                height: 100%;
                width: 0%;
                background: var(--green);
                transition: width 0.3s ease;
            }

            /* ══ CURSOR HINT ══ */
            .cursor-hint {
                position: absolute;
                bottom: 12px;
                left: 50%;
                transform: translateX(-50%);
                background: rgba(15, 15, 13, 0.75);
                color: white;
                font-size: 11.5px;
                font-family: var(--mono);
                padding: 5px 12px;
                border-radius: 20px;
                pointer-events: none;
                opacity: 0;
                transition: opacity 0.3s;
                white-space: nowrap;
                letter-spacing: 0.04em;
            }

            .canvas-container:hover .cursor-hint {
                opacity: 1;
            }

            /* ══ RESPONSIVE ══ */
            @media (max-width: 900px) {
                .redactor-page {
                    grid-template-columns: 1fr;
                    padding: 20px;
                }
                .sidebar {
                    position: static;
                }
            }
        </style>
    </head>

    <body>
        <!-- ANNOUNCE -->
        <div class="announce">
            <strong>Privacy first.</strong> Your files are processed entirely in your
            browser — we never see them.
        </div>

        <!-- NAV -->
        <!-- NAV -->
        <style>
            /* ── Dropdown ── */
            .nav-dropdown {
                position: relative;
            }

            .nav-dropdown-trigger {
                font-size: 13.5px;
                color: var(--ink-2);
                text-decoration: none;
                padding: 6px 14px;
                border-radius: var(--radius);
                transition: all 0.15s;
                font-weight: 400;
                cursor: pointer;
                background: none;
                border: none;
                font-family: var(--sans);
                display: flex;
                align-items: center;
                gap: 5px;
            }

            .nav-dropdown-trigger:hover {
                background: var(--paper-2);
                color: var(--ink);
            }

            .nav-dropdown-trigger svg {
                transition: transform 0.2s ease;
                flex-shrink: 0;
            }

            .nav-dropdown:hover .nav-dropdown-trigger svg,
            .nav-dropdown.open .nav-dropdown-trigger svg {
                transform: rotate(180deg);
            }

            .nav-dropdown-menu {
                position: absolute;
                top: calc(100% + 8px);
                left: 50%;
                transform: translateX(-50%) translateY(-4px);
                width: 280px;
                background: var(--white);
                border: 1px solid var(--border);
                border-radius: var(--radius-lg);
                box-shadow: var(--shadow-lg);
                opacity: 0;
                pointer-events: none;
                transition:
                    opacity 0.18s ease,
                    transform 0.18s ease;
                z-index: 200;
                overflow: hidden;
            }

            .nav-dropdown:hover .nav-dropdown-menu,
            .nav-dropdown.open .nav-dropdown-menu {
                opacity: 1;
                pointer-events: auto;
                transform: translateX(-50%) translateY(0);
            }

            .dropdown-header {
                padding: 10px 14px 8px;
                font-family: var(--mono);
                font-size: 10px;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                color: var(--ink-3);
                border-bottom: 1px solid var(--paper-3);
            }

            .dropdown-item {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 11px 14px;
                text-decoration: none;
                color: var(--ink);
                transition: background 0.12s;
                border-bottom: 1px solid var(--paper-3);
            }

            .dropdown-item:last-child {
                border-bottom: none;
            }
            .dropdown-item:hover {
                background: var(--paper);
            }

            .dropdown-item-icon {
                width: 32px;
                height: 32px;
                border-radius: var(--radius);
                background: var(--paper-2);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 15px;
                flex-shrink: 0;
                transition: background 0.12s;
            }

            .dropdown-item:hover .dropdown-item-icon {
                background: var(--paper-3);
            }

            .dropdown-item-text {
                flex: 1;
                min-width: 0;
            }

            .dropdown-item-name {
                font-size: 13px;
                font-weight: 600;
                color: var(--ink);
                margin-bottom: 2px;
                letter-spacing: -0.01em;
            }

            .dropdown-item-desc {
                font-size: 11px;
                color: var(--ink-3);
                line-height: 1.4;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .dropdown-item-badge {
                font-family: var(--mono);
                font-size: 9.5px;
                padding: 2px 6px;
                border-radius: 3px;
                font-weight: 600;
                flex-shrink: 0;
            }

            .badge-live {
                background: var(--green-light);
                color: var(--green);
            }
            .badge-soon {
                background: var(--paper-3);
                color: var(--ink-3);
            }

            .dropdown-footer {
                padding: 9px 14px;
                background: var(--paper);
                border-top: 1px solid var(--paper-3);
                font-size: 11.5px;
                color: var(--ink-3);
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .dropdown-footer a {
                font-size: 11.5px;
                color: var(--ink-2);
                text-decoration: none;
                font-weight: 500;
                transition: color 0.15s;
            }

            .dropdown-footer a:hover {
                color: var(--ink);
            }
        </style>

        <Navbar activePage="tools" />

        <!-- PAGE HERO -->
        <div class="page-hero">
            <div class="page-hero-inner">
                <div>
                    <div class="eyebrow" style="margin-bottom:14px;">PDF Redactor</div>
                    <h1>
                        Permanently remove<br /><em>sensitive text.</em>
                    </h1>
                    <p>
                        Draw redaction boxes directly on the page or search
                        by keyword to redact every match at once. Text is
                        flattened and irrecoverable — not just visually
                        covered.
                    </p>
                </div>

                    <!-- RIGHT: HOW IT WORKS MINI STEPS -->
                    <div class="how-it-works"
                    >
                        {
                            [
                                {
                                    n: "01",
                                    t: "Upload PDF",
                                    d: "Drop your file — stays in browser",
                                },
                                {
                                    n: "02",
                                    t: "Mark sensitive areas",
                                    d: "Draw boxes or type keywords",
                                },
                                {
                                    n: "03",
                                    t: "Apply & Download",
                                    d: "Text permanently removed",
                                },
                            ].map((s) => (
                                <div style="display:flex;gap:14px;align-items:flex-start;padding:14px 18px;background:var(--paper);border:1px solid var(--border);border-radius:var(--radius);">
                                    <span style="font-family:var(--serif);font-size:20px;font-style:italic;color:var(--ink-3);line-height:1;flex-shrink:0;padding-top:2px;">
                                        {s.n}
                                    </span>
                                    <div>
                                        <div style="font-size:13px;font-weight:600;color:var(--ink);margin-bottom:2px;">
                                            {s.t}
                                        </div>
                                        <div style="font-size:11.5px;color:var(--ink-2);font-family:var(--mono);">
                                            {s.d}
                                        </div>
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>

