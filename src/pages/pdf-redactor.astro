        <script>
            (() => {
                "use strict";

                // ── Constants ──
                const MAX_FILE_SIZE = 52428800; // 50MB
                const DEFAULT_COLOR = "#000000";

                // ── State ──
                let pdfDoc = null; // PDF.js document
                let currentPage = 1;
                let totalPages = 0;
                let currentScale = 1.0;
                let currentMode = "draw"; // 'draw' | 'keyword'
                let selectedColor = DEFAULT_COLOR;
                let isDrawing = false;
                let drawStart = { x: 0, y: 0 };
                let currentRect = null;
                let redactZones = []; // { page, x, y, w, h, color, id, source }
                let keywords = []; // { text, color, count }
                let keywordMatches = {}; // { page: [{ x, y, w, h, keyword }] }
                let currentFileBytes = null;
                let currentFileName = "";
                let renderTask = null;
                let pageTextContent = {}; // cache text content per page

                // ── DOM ──
                const $ = (id) => document.getElementById(id);
                const fileInput = $("file-input");
                const uploadDropZone = $("upload-drop-zone");
                const uploadState = $("upload-state");
                const loadingState = $("loading-state");
                const loadingMsg = $("loading-msg");
                const canvasToolbar = $("canvas-toolbar");
                const canvasContainer = $("canvas-container");
                const canvasWrapper = $("canvas-wrapper");
                const pdfCanvas = $("pdf-canvas");
                const overlayCanvas = $("overlay-canvas");
                const interactionCanvas = $("interaction-canvas");
                const pageIndicator = $("page-indicator");
                const prevBtn = $("prev-page-btn");
                const nextBtn = $("next-page-btn");
                const zoomSelect = $("zoom-select");
                const modeDrawBtn = $("mode-draw-btn");
                const modeKeywordBtn = $("mode-keyword-btn");
                const drawContent = $("draw-mode-content");
                const keywordContent = $("keyword-mode-content");
                const keywordInput = $("keyword-input");
                const keywordAddBtn = $("keyword-add-btn");
                const keywordList = $("keyword-list");
                const keywordEmpty = $("keyword-empty");
                const zonesList = $("zones-list");
                const zonesEmpty = $("zones-empty");
                const zonesBadge = $("zones-badge");
                const statZones = $("stat-zones");
                const statPages = $("stat-pages");
                const clearAllBtn = $("clear-all-btn");
                const applyBtn = $("apply-btn");
                const newFileBtn = $("new-file-btn");
                const cursorHint = $("cursor-hint");
                const toolbarModeLabel = $("toolbar-mode-label");
                const dlBar = $("dl-bar");
                const dlProgress = $("dl-progress");
                const sbFilename = $("sb-filename");
                const sbFileinfo = $("sb-fileinfo");

                // ── PDF.js contexts ──
                const pdfCtx = pdfCanvas.getContext("2d");
                const overlayCtx = overlayCanvas.getContext("2d");
                const interactionCtx = interactionCanvas.getContext("2d");

                // ── Helpers ──
                function formatBytes(b) {
                    if (b < 1024) return b + " B";
                    if (b < 1048576) return (b / 1024).toFixed(1) + " KB";
                    return (b / 1048576).toFixed(2) + " MB";
                }

                function uid() {
                    return Math.random().toString(36).slice(2, 9);
                }

                function showProgress(pct) {
                    dlProgress.style.display = "block";
                    dlBar.style.width = pct + "%";
                }

                function hideProgress() {
                    setTimeout(() => {
                        dlProgress.style.display = "none";
                        dlBar.style.width = "0%";
                    }, 600);
                }

                function showSidebar() {
                    $("file-info-card").style.display = "block";
                    $("mode-card").style.display = "block";
                    $("zones-card").style.display = "block";
                    $("action-card").style.display = "flex";
                    $("action-card").style.flexDirection = "column";
                    $("action-card").style.gap = "6px";
                }

                // ── Show/hide UI states ──
                function showUpload() {
                    uploadState.style.display = "flex";
                    loadingState.style.display = "none";
                    canvasToolbar.style.display = "none";
                    canvasContainer.style.display = "none";
                }

                function showLoading(msg = "Loading PDF...") {
                    uploadState.style.display = "none";
                    loadingState.style.display = "flex";
                    loadingMsg.textContent = msg;
                    canvasToolbar.style.display = "none";
                    canvasContainer.style.display = "none";
                }

                function showCanvas() {
                    uploadState.style.display = "none";
                    loadingState.style.display = "none";
                    canvasToolbar.style.display = "flex";
                    canvasContainer.style.display = "flex";
                }

                async function renderRedactorDiff(appliedZones, pageNum) {
                    const diffEl = document.getElementById("redactor-diff");
                    if (!diffEl || !pdfDoc) return;

                    diffEl.style.display = "block";

                    const THUMB_SCALE = 0.5;
                    const page = await pdfDoc.getPage(pageNum || 1);
                    const vp = page.getViewport({ scale: THUMB_SCALE });

                    // ── BEFORE canvas ──
                    const beforeCanvas =
                        document.getElementById("rd-before-canvas");
                    const beforeCtx = beforeCanvas.getContext("2d");
                    beforeCanvas.width = vp.width;
                    beforeCanvas.height = vp.height;
                    await page.render({
                        canvasContext: beforeCtx,
                        viewport: vp,
                    }).promise;

                    // ── AFTER canvas — render page then draw redaction boxes ──
                    const afterCanvas =
                        document.getElementById("rd-after-canvas");
                    const afterCtx = afterCanvas.getContext("2d");
                    afterCanvas.width = vp.width;
                    afterCanvas.height = vp.height;
                    await page.render({ canvasContext: afterCtx, viewport: vp })
                        .promise;

                    // Draw zones on the after canvas
                    const pageZones = appliedZones.filter(
                        (z) => z.page === (pageNum || 1),
                    );
                    pageZones.forEach((zone) => {
                        // Scale from full resolution to thumbnail
                        const scaleRatio = THUMB_SCALE / currentScale;
                        afterCtx.fillStyle = zone.color;
                        afterCtx.fillRect(
                            zone.x * scaleRatio,
                            zone.y * scaleRatio,
                            zone.w * scaleRatio,
                            zone.h * scaleRatio,
                        );
                    });

                    // ── Counts ──
                    document.getElementById("rd-before-count").textContent =
                        "Page 1 shown";
                    document.getElementById("rd-after-count").textContent =
                        `${pageZones.length} zone${pageZones.length !== 1 ? "s" : ""} on this page`;
                    document.getElementById("rd-zones-count").textContent =
                        `${appliedZones.length} zone${appliedZones.length !== 1 ? "s" : ""}`;
                    document.getElementById(
                        "redactor-diff-summary",
                    ).textContent =
                        `${appliedZones.length} redaction${appliedZones.length !== 1 ? "s" : ""} applied across ${new Set(appliedZones.map((z) => z.page)).size} page${new Set(appliedZones.map((z) => z.page)).size !== 1 ? "s" : ""}`;

                    // ── Zones list ──
                    const list = document.getElementById("rd-zones-list");
                    list.innerHTML = "";
                    const byPage = {};
                    appliedZones.forEach((z) => {
                        if (!byPage[z.page]) byPage[z.page] = [];
                        byPage[z.page].push(z);
                    });

                    Object.keys(byPage)
                        .sort((a, b) => a - b)
                        .forEach((pg) => {
                            const header = document.createElement("div");
                            header.style.cssText =
                                "font-family:var(--mono);font-size:10px;color:var(--ink-3);text-transform:uppercase;letter-spacing:0.06em;padding:6px 18px 3px;";
                            header.textContent = `Page ${pg}`;
                            list.appendChild(header);

                            byPage[pg].forEach((z, i) => {
                                const row = document.createElement("div");
                                row.className = "zone-summary-row";
                                row.innerHTML = `
        <div class="zone-color-dot" style="background:${z.color === "#ffffff" || z.color === "#f5f3ee" ? "#ccc" : z.color};"></div>
        <span style="flex:1;">${z.source === "keyword" ? '"' + z.keyword + '"' : "Drawn zone " + (i + 1)}</span>
        <span style="color:var(--ink-3);">${Math.round(z.w)}×${Math.round(z.h)}px</span>
        <span class="diff-field-status status-removed">Removed</span>
      `;
                                list.appendChild(row);
                            });
                        });

                    diffEl.scrollIntoView({
                        behavior: "smooth",
                        block: "nearest",
                    });
                }

                // ── Render PDF page ──
                async function renderPage(pageNum) {
                    if (!pdfDoc) return;

                    // Cancel any in-progress render
                    if (renderTask) {
                        try {
                            renderTask.cancel();
                        } catch (_) {}
                    }

                    const page = await pdfDoc.getPage(pageNum);
                    const viewport = page.getViewport({ scale: currentScale });

                    // Size all three canvases identically
                    [pdfCanvas, overlayCanvas, interactionCanvas].forEach(
                        (c) => {
                            c.width = viewport.width;
                            c.height = viewport.height;
                        },
                    );

                    // Size wrapper
                    canvasWrapper.style.width = viewport.width + "px";
                    canvasWrapper.style.height = viewport.height + "px";

                    // Render PDF page
                    renderTask = page.render({
                        canvasContext: pdfCtx,
                        viewport,
                    });
                    await renderTask.promise;
                    renderTask = null;

                    // Cache text content for keyword search
                    if (!pageTextContent[pageNum]) {
                        const tc = await page.getTextContent();
                        pageTextContent[pageNum] = {
                            items: tc.items,
                            viewport,
                        };
                    }

                    // Draw redaction zones for this page
                    drawOverlay();

                    // Draw keyword highlights for this page
                    drawKeywordHighlights();

                    pageIndicator.textContent = `${pageNum} / ${totalPages}`;
                    prevBtn.disabled = pageNum <= 1;
                    nextBtn.disabled = pageNum >= totalPages;
                }

                // ── Draw all redaction zones on overlay canvas ──
                function drawOverlay() {
                    overlayCtx.clearRect(
                        0,
                        0,
                        overlayCanvas.width,
                        overlayCanvas.height,
                    );
                    const zonesOnPage = redactZones.filter(
                        (z) => z.page === currentPage,
                    );
                    zonesOnPage.forEach((zone) => {
                        overlayCtx.fillStyle = zone.color;
                        overlayCtx.fillRect(zone.x, zone.y, zone.w, zone.h);

                        // White border on dark boxes so user can see them
                        if (
                            zone.color === "#000000" ||
                            zone.color === "#1a1a2e"
                        ) {
                            overlayCtx.strokeStyle = "rgba(255,255,255,0.3)";
                        } else {
                            overlayCtx.strokeStyle = "rgba(0,0,0,0.3)";
                        }
                        overlayCtx.lineWidth = 1;
                        overlayCtx.strokeRect(zone.x, zone.y, zone.w, zone.h);
                    });
                }

                // ── Draw keyword highlights (yellow pre-redaction markers) ──
                function drawKeywordHighlights() {
                    const matches = keywordMatches[currentPage] || [];
                    matches.forEach((m) => {
                        overlayCtx.fillStyle = "rgba(255, 200, 0, 0.35)";
                        overlayCtx.fillRect(m.x, m.y, m.w, m.h);
                        overlayCtx.strokeStyle = "rgba(200, 150, 0, 0.8)";
                        overlayCtx.lineWidth = 1.5;
                        overlayCtx.strokeRect(m.x, m.y, m.w, m.h);
                    });
                }

                // ── Draw active drag rectangle ──
                function drawDragRect(x, y, w, h) {
                    interactionCtx.clearRect(
                        0,
                        0,
                        interactionCanvas.width,
                        interactionCanvas.height,
                    );
                    if (w === 0 || h === 0) return;

                    // Semi-transparent fill
                    interactionCtx.fillStyle =
                        selectedColor === "#ffffff" ||
                        selectedColor === "#f5f3ee"
                            ? "rgba(0,0,0,0.15)"
                            : hexToRgba(selectedColor, 0.5);
                    interactionCtx.fillRect(x, y, w, h);

                    // Dashed border
                    interactionCtx.strokeStyle =
                        selectedColor === "#ffffff" ||
                        selectedColor === "#f5f3ee"
                            ? "#666"
                            : selectedColor;
                    interactionCtx.lineWidth = 1.5;
                    interactionCtx.setLineDash([4, 3]);
                    interactionCtx.strokeRect(x, y, w, h);
                    interactionCtx.setLineDash([]);
                }

                function hexToRgba(hex, alpha) {
                    const r = parseInt(hex.slice(1, 3), 16);
                    const g = parseInt(hex.slice(3, 5), 16);
                    const b = parseInt(hex.slice(5, 7), 16);
                    return `rgba(${r},${g},${b},${alpha})`;
                }

                // ── Canvas mouse events (draw mode) ──
                function getCanvasPos(e) {
                    const rect = interactionCanvas.getBoundingClientRect();
                    return {
                        x:
                            (e.clientX - rect.left) *
                            (interactionCanvas.width / rect.width),
                        y:
                            (e.clientY - rect.top) *
                            (interactionCanvas.height / rect.height),
                    };
                }

                interactionCanvas.addEventListener("mousedown", (e) => {
                    if (currentMode !== "draw") return;
                    isDrawing = true;
                    drawStart = getCanvasPos(e);
                    e.preventDefault();
                });

                interactionCanvas.addEventListener("mousemove", (e) => {
                    if (!isDrawing) return;
                    const pos = getCanvasPos(e);
                    currentRect = {
                        x: Math.min(drawStart.x, pos.x),
                        y: Math.min(drawStart.y, pos.y),
                        w: Math.abs(pos.x - drawStart.x),
                        h: Math.abs(pos.y - drawStart.y),
                    };
                    drawDragRect(
                        currentRect.x,
                        currentRect.y,
                        currentRect.w,
                        currentRect.h,
                    );
                });

                interactionCanvas.addEventListener("mouseup", (e) => {
                    if (!isDrawing) return;
                    isDrawing = false;
                    interactionCtx.clearRect(
                        0,
                        0,
                        interactionCanvas.width,
                        interactionCanvas.height,
                    );

                    if (currentRect && currentRect.w > 5 && currentRect.h > 5) {
                        const zone = {
                            id: uid(),
                            page: currentPage,
                            x: currentRect.x,
                            y: currentRect.y,
                            w: currentRect.w,
                            h: currentRect.h,
                            color: selectedColor,
                            source: "draw",
                        };
                        redactZones.push(zone);
                        drawOverlay();
                        updateZonesList();
                    }
                    currentRect = null;
                });

                // Touch support
                interactionCanvas.addEventListener(
                    "touchstart",
                    (e) => {
                        if (currentMode !== "draw") return;
                        e.preventDefault();
                        const touch = e.touches[0];
                        isDrawing = true;
                        drawStart = getCanvasPos(touch);
                    },
                    { passive: false },
                );

                interactionCanvas.addEventListener(
                    "touchmove",
                    (e) => {
                        if (!isDrawing) return;
                        e.preventDefault();
                        const touch = e.touches[0];
                        const pos = getCanvasPos(touch);
                        currentRect = {
                            x: Math.min(drawStart.x, pos.x),
                            y: Math.min(drawStart.y, pos.y),
                            w: Math.abs(pos.x - drawStart.x),
                            h: Math.abs(pos.y - drawStart.y),
                        };
                        drawDragRect(
                            currentRect.x,
                            currentRect.y,
                            currentRect.w,
                            currentRect.h,
                        );
                    },
                    { passive: false },
                );

                interactionCanvas.addEventListener("touchend", () => {
                    if (!isDrawing) return;
                    isDrawing = false;
                    interactionCtx.clearRect(
                        0,
                        0,
                        interactionCanvas.width,
                        interactionCanvas.height,
                    );
                    if (currentRect && currentRect.w > 5 && currentRect.h > 5) {
                        redactZones.push({
                            id: uid(),
                            page: currentPage,
                            x: currentRect.x,
                            y: currentRect.y,
                            w: currentRect.w,
                            h: currentRect.h,
                            color: selectedColor,
                            source: "draw",
                        });
                        drawOverlay();
                        updateZonesList();
                    }
                    currentRect = null;
                });

                // ── Keyword Search ──
                async function searchKeyword(keyword) {
                    if (!pdfDoc) return 0;
                    let totalMatches = 0;

                    for (let p = 1; p <= totalPages; p++) {
                        if (!pageTextContent[p]) {
                            const page = await pdfDoc.getPage(p);
                            const tc = await page.getTextContent();
                            const vp = page.getViewport({
                                scale: currentScale,
                            });
                            pageTextContent[p] = {
                                items: tc.items,
                                viewport: vp,
                            };
                        }

                        const { items, viewport } = pageTextContent[p];
                        const lower = keyword.toLowerCase();

                        // Remove existing keyword matches for this keyword on this page
                        if (!keywordMatches[p]) keywordMatches[p] = [];
                        keywordMatches[p] = keywordMatches[p].filter(
                            (m) => m.keyword !== keyword,
                        );

                        items.forEach((item) => {
                            if (
                                !item.str ||
                                !item.str.toLowerCase().includes(lower)
                            )
                                return;

                            // PDF.js transform: [scaleX, skewX, skewY, scaleY, translateX, translateY]
                            const tx = item.transform;
                            const x = tx[4];
                            const y = tx[5];
                            const w = item.width * currentScale;
                            const h =
                                (item.height || Math.abs(tx[3])) * currentScale;

                            // Convert PDF coordinates (bottom-left origin) to canvas (top-left origin)
                            const canvasX = x * currentScale;
                            const canvasY =
                                viewport.height - y * currentScale - h;

                            keywordMatches[p].push({
                                x: canvasX - 2,
                                y: canvasY - 2,
                                w: w + 4,
                                h: h + 4,
                                keyword,
                                page: p,
                            });

                            totalMatches++;
                        });
                    }

                    return totalMatches;
                }

                async function addKeyword() {
                    const text = keywordInput.value.trim();
                    if (!text || keywords.find((k) => k.text === text)) {
                        keywordInput.value = "";
                        return;
                    }

                    const kw = { text, color: selectedColor, count: 0 };
                    keywords.push(kw);
                    keywordInput.value = "";
                    renderKeywordList();

                    // Search across all pages
                    if (pdfDoc) {
                        kw.count = await searchKeyword(text);
                        renderKeywordList();

                        // Add keyword matches as zones on all pages
                        for (let p = 1; p <= totalPages; p++) {
                            const matches = (keywordMatches[p] || []).filter(
                                (m) => m.keyword === text,
                            );
                            matches.forEach((m) => {
                                redactZones.push({
                                    id: uid(),
                                    page: m.page,
                                    x: m.x,
                                    y: m.y,
                                    w: m.w,
                                    h: m.h,
                                    color: selectedColor,
                                    source: "keyword",
                                    keyword: text,
                                });
                            });
                        }

                        updateZonesList();
                        drawOverlay();
                    }
                }

                function removeKeyword(text) {
                    keywords = keywords.filter((k) => k.text !== text);
                    // Remove all zones from this keyword
                    redactZones = redactZones.filter((z) => z.keyword !== text);
                    // Clear keyword matches
                    Object.keys(keywordMatches).forEach((p) => {
                        keywordMatches[p] = keywordMatches[p].filter(
                            (m) => m.keyword !== text,
                        );
                    });
                    renderKeywordList();
                    updateZonesList();
                    drawOverlay();
                }

                function renderKeywordList() {
                    keywordList.innerHTML = "";
                    if (keywords.length === 0) {
                        keywordList.appendChild(keywordEmpty);
                        keywordEmpty.style.display = "block";
                        return;
                    }
                    keywords.forEach((kw) => {
                        const chip = document.createElement("div");
                        chip.className = "keyword-chip";
                        chip.innerHTML = `
              <span class="keyword-chip-text">${kw.text}</span>
              <span class="keyword-chip-count ${kw.count === 0 ? "zero" : ""}">${kw.count}</span>
              <button class="keyword-remove" data-kw="${kw.text}" title="Remove keyword">×</button>
            `;
                        keywordList.appendChild(chip);
                    });
                }

                // ── Zones list UI ──
                function updateZonesList() {
                    const count = redactZones.length;
                    zonesBadge.textContent = count;
                    statZones.textContent = count;

                    const pagesAffected = new Set(
                        redactZones.map((z) => z.page),
                    ).size;
                    statPages.textContent = pagesAffected;

                    applyBtn.disabled = count === 0;

                    zonesList.innerHTML = "";
                    if (count === 0) {
                        zonesList.appendChild(zonesEmpty);
                        zonesEmpty.style.display = "block";
                        return;
                    }

                    // Group by page for cleaner display
                    const byPage = {};
                    redactZones.forEach((z) => {
                        if (!byPage[z.page]) byPage[z.page] = [];
                        byPage[z.page].push(z);
                    });

                    Object.keys(byPage)
                        .sort((a, b) => a - b)
                        .forEach((page) => {
                            // Page header
                            const ph = document.createElement("div");
                            ph.style.cssText =
                                "font-size:10px;font-family:var(--mono);color:var(--ink-3);text-transform:uppercase;letter-spacing:0.06em;padding:4px 2px 3px;margin-top:4px;";
                            ph.textContent = `Page ${page}`;
                            zonesList.appendChild(ph);

                            byPage[page].forEach((zone) => {
                                const item = document.createElement("div");
                                item.className = "zone-item";
                                item.dataset.zoneId = zone.id;
                                item.innerHTML = `
                <div class="zone-item-dot" style="background:${zone.color === "#ffffff" || zone.color === "#f5f3ee" ? "#ccc" : zone.color};"></div>
                <span class="zone-item-label">${zone.source === "keyword" ? '"' + zone.keyword + '"' : Math.round(zone.w) + "×" + Math.round(zone.h) + "px"}</span>
                <button class="zone-remove" data-zone-id="${zone.id}" title="Remove zone">×</button>
              `;
                                zonesList.appendChild(item);
                            });
                        });
                }

                // ── Zone removal via list click ──
                zonesList.addEventListener("click", (e) => {
                    const btn = e.target.closest(".zone-remove");
                    if (!btn) return;
                    const id = btn.dataset.zoneId;
                    redactZones = redactZones.filter((z) => z.id !== id);
                    updateZonesList();
                    drawOverlay();
                });

                // ── Color selector ──
                document.querySelectorAll(".color-opt").forEach((opt) => {
                    opt.addEventListener("click", () => {
                        document
                            .querySelectorAll(".color-opt")
                            .forEach((o) => o.classList.remove("selected"));
                        opt.classList.add("selected");
                        selectedColor = opt.dataset.color;
                    });
                });

                // ── Mode tabs ──
                modeDrawBtn.addEventListener("click", () => {
                    currentMode = "draw";
                    modeDrawBtn.classList.add("active");
                    modeKeywordBtn.classList.remove("active");
                    drawContent.style.display = "block";
                    keywordContent.style.display = "none";
                    canvasWrapper.className = "canvas-wrapper mode-draw";
                    toolbarModeLabel.textContent = "Draw Mode";
                    cursorHint.textContent =
                        "Click and drag to draw a redaction box";
                    interactionCanvas.style.pointerEvents = "auto";
                });

                modeKeywordBtn.addEventListener("click", () => {
                    currentMode = "keyword";
                    modeKeywordBtn.classList.add("active");
                    modeDrawBtn.classList.remove("active");
                    drawContent.style.display = "none";
                    keywordContent.style.display = "block";
                    canvasWrapper.className = "canvas-wrapper mode-keyword";
                    toolbarModeLabel.textContent = "Keyword Mode";
                    cursorHint.textContent =
                        "Add keywords in the sidebar to redact all matches";
                    interactionCanvas.style.pointerEvents = "none";
                });

                // ── Keyword events ──
                keywordAddBtn.addEventListener("click", addKeyword);
                keywordInput.addEventListener("keydown", (e) => {
                    if (e.key === "Enter") addKeyword();
                });

                keywordList.addEventListener("click", (e) => {
                    const btn = e.target.closest(".keyword-remove");
                    if (!btn) return;
                    removeKeyword(btn.dataset.kw);
                });

                // ── Page navigation ──
                prevBtn.addEventListener("click", () => {
                    if (currentPage > 1) {
                        currentPage--;
                        renderPage(currentPage);
                    }
                });

                nextBtn.addEventListener("click", () => {
                    if (currentPage < totalPages) {
                        currentPage++;
                        renderPage(currentPage);
                    }
                });

                // ── Zoom ──
                zoomSelect.addEventListener("change", () => {
                    currentScale = parseFloat(zoomSelect.value);
                    // Clear text content cache — viewport changed
                    pageTextContent = {};
                    renderPage(currentPage);
                });

                // ── Clear all ──
                clearAllBtn.addEventListener("click", () => {
                    if (redactZones.length === 0) return;
                    if (
                        !confirm(
                            "Remove all " +
                                redactZones.length +
                                " redaction zone(s)?",
                        )
                    )
                        return;
                    redactZones = [];
                    keywords = [];
                    keywordMatches = {};
                    renderKeywordList();
                    updateZonesList();
                    drawOverlay();
                });

                // ─────────────────────────────────────────────────
                // APPLY REDACTIONS — pdf-lib flatten
                // This is the production-grade part:
                // For each zone, we draw a filled rectangle in the PDF
                // coordinate space, then save with useObjectStreams:false
                // so the output is maximally compatible.
                // ─────────────────────────────────────────────────
                applyBtn.addEventListener("click", async () => {
                    if (redactZones.length === 0) return;

                    applyBtn.disabled = true;
                    applyBtn.textContent = "Applying...";
                    showProgress(5);

                    try {
                        const { PDFDocument, rgb, degrees } = PDFLib;

                        // Ensure bytes are Uint8Array
                        const uint8 =
                            currentFileBytes instanceof Uint8Array
                                ? currentFileBytes
                                : new Uint8Array(currentFileBytes);

                        showProgress(15);

                        const doc = await PDFDocument.load(uint8, {
                            ignoreEncryption: false,
                            updateMetadata: false,
                        });

                        showProgress(30);

                        const pages = doc.getPages();
                        const pagesCount = pages.length;

                        // Group zones by page
                        const zonesByPage = {};
                        redactZones.forEach((z) => {
                            if (!zonesByPage[z.page]) zonesByPage[z.page] = [];
                            zonesByPage[z.page].push(z);
                        });

                        let processed = 0;

                        for (const [pageNumStr, zones] of Object.entries(
                            zonesByPage,
                        )) {
                            const pageNum = parseInt(pageNumStr);
                            const pdfPage = pages[pageNum - 1];
                            if (!pdfPage) continue;

                            const { width: pdfW, height: pdfH } =
                                pdfPage.getSize();

                            // Get the rendered canvas size for this page to compute scale ratio
                            // We need to map canvas coordinates back to PDF coordinates
                            const pdfJsPage = await pdfDoc.getPage(pageNum);
                            const renderedVP = pdfJsPage.getViewport({
                                scale: currentScale,
                            });
                            const scaleX = pdfW / renderedVP.width;
                            const scaleY = pdfH / renderedVP.height;

                            zones.forEach((zone) => {
                                // Convert canvas coords → PDF coords
                                // Canvas: top-left origin. PDF: bottom-left origin.
                                const pdfX = zone.x * scaleX;
                                const pdfY = pdfH - (zone.y + zone.h) * scaleY;
                                const pdfRectW = zone.w * scaleX;
                                const pdfRectH = zone.h * scaleY;

                                // Parse hex color to rgb
                                const hex = zone.color.replace("#", "");
                                const r = parseInt(hex.slice(0, 2), 16) / 255;
                                const g = parseInt(hex.slice(2, 4), 16) / 255;
                                const b = parseInt(hex.slice(4, 6), 16) / 255;

                                // Draw filled rectangle over the sensitive area
                                pdfPage.drawRectangle({
                                    x: pdfX,
                                    y: pdfY,
                                    width: Math.max(pdfRectW, 1),
                                    height: Math.max(pdfRectH, 1),
                                    color: rgb(r, g, b),
                                    opacity: 1,
                                    borderWidth: 0,
                                });
                            });

                            processed++;
                            showProgress(
                                30 + Math.round((processed / pagesCount) * 50),
                            );
                        }

                        showProgress(85);

                        // Add FileIntel producer tag
                        doc.setProducer("FileIntel — fileintel.me");
                        doc.setCreator("FileIntel Redactor");

                        // Save — useObjectStreams:false = widest reader compatibility
                        const cleanBytes = await doc.save({
                            useObjectStreams: false,
                            addDefaultPage: false,
                        });

                        showProgress(100);

                        // Download
                        const blob = new Blob([cleanBytes], {
                            type: "application/pdf",
                        });
                        const url = URL.createObjectURL(blob);
                        const a = document.createElement("a");
                        a.href = url;
                        a.download =
                            currentFileName.replace(/\.pdf$/i, "") +
                            "-redacted.pdf";
                        document.body.appendChild(a);
                        a.click();
                        setTimeout(() => {
                            URL.revokeObjectURL(url);
                            a.remove();
                        }, 1500);

                        hideProgress();

                        // Visual feedback — mark zones as applied
                        redactZones.forEach((z) => {
                            z.applied = true;
                        });
                        drawOverlay();

                        applyBtn.textContent = "Downloaded! Apply more?";
                        setTimeout(() => {
                            applyBtn.textContent = "Apply & Download";
                            applyBtn.disabled = false;
                        }, 3000);
                    } catch (err) {
                        hideProgress();
                        console.error("Redaction error:", err);
                        alert(
                            "Failed to apply redactions: " +
                                (err?.message || "Unknown error") +
                                "\n\nPlease try re-uploading the file.",
                        );
                        applyBtn.disabled = false;
                        applyBtn.textContent = "Apply & Download";
                    }
                    await renderRedactorDiff(redactZones, currentPage);
                });

                // ── Load PDF ──
                async function loadPDF(file) {
                    if (!file || file.type !== "application/pdf") {
                        alert("Please upload a valid PDF file (.pdf).");
                        return;
                    }
                    if (file.size > MAX_FILE_SIZE) {
                        alert("File exceeds 50MB limit.");
                        return;
                    }

                    // Reset state
                    redactZones = [];
                    keywords = [];
                    keywordMatches = {};
                    pageTextContent = {};
                    currentPage = 1;
                    currentFileName = file.name;

                    showLoading("Reading PDF...");

                    try {
                        // Read buffer once — slice for PDF.js, keep original for pdf-lib
                        const buffer = await file.arrayBuffer();
                        currentFileBytes = new Uint8Array(buffer);

                        // Wait for PDF.js
                        let pdfjsLib = window["pdfjs-dist/build/pdf"];
                        if (!pdfjsLib) {
                            await new Promise((resolve, reject) => {
                                let tries = 0;
                                const t = setInterval(() => {
                                    pdfjsLib = window["pdfjs-dist/build/pdf"];
                                    if (pdfjsLib) {
                                        clearInterval(t);
                                        resolve();
                                    }
                                    if (++tries > 25) {
                                        clearInterval(t);
                                        reject(
                                            new Error("PDF.js failed to load"),
                                        );
                                    }
                                }, 200);
                            });
                        }

                        // Set workerSrc BEFORE any getDocument call
                        // Using CDN worker that exactly matches the library version loaded below
                        pdfjsLib.GlobalWorkerOptions.workerSrc =
                            "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";

                        loadingMsg.textContent = "Rendering pages...";

                        pdfDoc = await pdfjsLib.getDocument({
                            data: currentFileBytes.slice(0),
                            useWorkerFetch: false,
                            isEvalSupported: false,
                            useSystemFonts: true,
                        }).promise;
                        totalPages = pdfDoc.numPages;

                        sbFilename.textContent =
                            file.name.length > 30
                                ? file.name.slice(0, 27) + "..."
                                : file.name;
                        sbFileinfo.textContent = `${formatBytes(file.size)} · ${totalPages} page${totalPages !== 1 ? "s" : ""}`;

                        showSidebar();
                        showCanvas();
                        renderKeywordList();
                        updateZonesList();
                        await renderPage(1);
                    } catch (err) {
                        console.error("PDF load error:", err);
                        showUpload();
                        const msg = err?.message?.includes("password")
                            ? "This PDF is password-protected. Please unlock it first."
                            : "Could not read this PDF: " +
                              (err?.message || "Unknown error");
                        alert(msg);
                    }
                }

                // ── Upload zone events ──
                uploadDropZone.addEventListener("click", (e) => {
                    e.stopPropagation();
                    fileInput.click();
                });

                uploadDropZone.addEventListener("keydown", (e) => {
                    if (e.key === "Enter" || e.key === " ") {
                        e.preventDefault();
                        fileInput.click();
                    }
                });

                fileInput.addEventListener("click", (e) => e.stopPropagation());

                fileInput.addEventListener("change", (e) => {
                    const file = e.target.files[0];
                    if (file) loadPDF(file);
                    fileInput.value = "";
                });

                uploadDropZone.addEventListener("dragover", (e) => {
                    e.preventDefault();
                    uploadDropZone.classList.add("drag-active");
                });

                uploadDropZone.addEventListener("dragleave", (e) => {
                    if (!uploadDropZone.contains(e.relatedTarget))
                        uploadDropZone.classList.remove("drag-active");
                });

                uploadDropZone.addEventListener("drop", (e) => {
                    e.preventDefault();
                    uploadDropZone.classList.remove("drag-active");
                    const file = e.dataTransfer.files[0];
                    if (file) loadPDF(file);
                });

                document.addEventListener("dragover", (e) =>
                    e.preventDefault(),
                );
                document.addEventListener("drop", (e) => e.preventDefault());

                // ── New file ──
                newFileBtn.addEventListener("click", () => {
                    pdfDoc = null;
                    currentFileBytes = null;
                    redactZones = [];
                    keywords = [];
                    keywordMatches = {};
                    pageTextContent = {};
                    pdfCtx.clearRect(0, 0, pdfCanvas.width, pdfCanvas.height);
                    overlayCtx.clearRect(
                        0,
                        0,
                        overlayCanvas.width,
                        overlayCanvas.height,
                    );
                    interactionCtx.clearRect(
                        0,
                        0,
                        interactionCanvas.width,
                        interactionCanvas.height,
                    );
                    renderKeywordList();
                    updateZonesList();
                    [
                        "file-info-card",
                        "mode-card",
                        "zones-card",
                        "action-card",
                    ].forEach((id) => {
                        const el = $(id);
                        if (el) el.style.display = "none";
                    });
                    showUpload();
                });

                // ── Keyboard shortcuts ──
                document.addEventListener("keydown", (e) => {
                    if (!pdfDoc) return;
                    if (e.target.tagName === "INPUT") return;
                    if (e.key === "ArrowRight" || e.key === "ArrowDown") {
                        if (currentPage < totalPages) {
                            currentPage++;
                            renderPage(currentPage);
                        }
                    }
                    if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
                        if (currentPage > 1) {
                            currentPage--;
                            renderPage(currentPage);
                        }
                    }
                    // Escape cancels current draw
                    if (e.key === "Escape" && isDrawing) {
                        isDrawing = false;
                        currentRect = null;
                        interactionCtx.clearRect(
                            0,
                            0,
                            interactionCanvas.width,
                            interactionCanvas.height,
                        );
                    }
                });
            })();
        </script>

        <!-- PDF.js and pdf-lib — load synchronously so they're ready before any interaction -->
        <script
            src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"
        ></script>
        <script
            src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js"
        ></script>
        <script src="https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js"
        ></script>
    </body>
</html>
