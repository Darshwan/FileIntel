---
// src/pages/blog/view-pdf-metadata-mac-windows-linux.astro
// Target keyword: "how to view pdf metadata" / "view pdf metadata mac"
// Secondary: "check pdf metadata windows", "pdf metadata linux", "see pdf metadata"
// Intent: Navigational + Informational — people want step-by-step for their specific OS
// Monthly searches: 2,800+ primary cluster + 4,200 long-tail OS-specific
// Gap competitors miss: No single article covers all three OSes with real screenshots
// AND offers a browser-based fallback that works on all three simultaneously

import Footer from "../../components/Footer.astro";
import Navbar from "../../components/Navbar.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>
      How to View PDF Metadata on Mac, Windows & Linux (2026) | FileIntel
    </title>
    <meta
      name="description"
      content="Step-by-step guide to viewing hidden PDF metadata on any operating system. See author names, GPS coordinates, edit history and more — free tools included."
    />
    <link
      rel="canonical"
      href="https://fileintel.me/blog/view-pdf-metadata-mac-windows-linux"
    />

    <meta property="og:type" content="article" />
    <meta
      property="og:url"
      content="https://fileintel.me/blog/view-pdf-metadata-mac-windows-linux"
    />
    <meta
      property="og:title"
      content="How to View PDF Metadata on Mac, Windows & Linux (2026)"
    />
    <meta
      property="og:description"
      content="See exactly what hidden data is inside any PDF — on Mac, Windows, or Linux. Free tools, real steps, no software required."
    />
    <meta
      property="og:image"
      content="https://fileintel.me/og-blog-view-metadata.png"
    />
    <meta property="article:published_time" content="2026-05-01T00:00:00Z" />
    <meta property="article:author" content="FileIntel" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="How to View PDF Metadata on Mac, Windows & Linux"
    />
    <meta
      name="twitter:description"
      content="Step-by-step guide for every OS. See hidden author names, GPS data, and edit history inside any PDF."
    />

    <!-- Article Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "How to View PDF Metadata on Mac, Windows & Linux",
        "description": "Step-by-step guide to viewing hidden PDF metadata on Mac, Windows, and Linux using free tools — including a browser-based option that works on all platforms.",
        "url": "https://fileintel.me/blog/view-pdf-metadata-mac-windows-linux",
        "datePublished": "2026-05-01",
        "dateModified": "2026-05-01",
        "author": {
          "@type": "Organization",
          "name": "FileIntel",
          "url": "https://fileintel.me"
        },
        "publisher": { "@type": "Organization", "name": "FileIntel" },
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://fileintel.me/blog/view-pdf-metadata-mac-windows-linux"
        }
      }
    </script>

    <!-- HowTo Schema — Google can show this as a rich result -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "HowTo",
        "name": "How to View PDF Metadata on Any Platform",
        "description": "View hidden metadata inside any PDF file — works on Mac, Windows, Linux, and all browsers.",
        "totalTime": "PT1M",
        "tool": [
          { "@type": "HowToTool", "name": "FileIntel PDF Metadata Inspector" }
        ],
        "step": [
          {
            "@type": "HowToStep",
            "name": "Open FileIntel PDF Metadata Inspector",
            "text": "Go to fileintel.me/pdf-metadata-remover in any browser on any operating system.",
            "url": "https://fileintel.me/pdf-metadata-remover"
          },
          {
            "@type": "HowToStep",
            "name": "Upload your PDF",
            "text": "Click the upload zone or drag and drop your PDF. Processing happens in your browser — the file never leaves your device."
          },
          {
            "@type": "HowToStep",
            "name": "Read the metadata",
            "text": "FileIntel shows every metadata field with a Privacy Risk Score — author name, company, GPS coordinates, modification dates, and more."
          }
        ]
      }
    </script>

    <!-- FAQPage Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "How do I view PDF metadata on a Mac?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "On Mac, open the PDF in Preview and go to Tools → Show Inspector → Info tab. This shows basic metadata fields. For full metadata including XMP data and GPS coordinates, use FileIntel's free browser-based PDF Metadata Inspector or the command-line tool exiftool installed via Homebrew."
            }
          },
          {
            "@type": "Question",
            "name": "How do I check PDF metadata on Windows?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "On Windows, right-click the PDF file and select Properties → Details tab to see basic metadata. For full metadata, open it in Adobe Acrobat Reader and go to File → Properties → Description tab. For comprehensive metadata including hidden XMP fields, use FileIntel's free online PDF Metadata Inspector — no software installation required."
            }
          },
          {
            "@type": "Question",
            "name": "What is the best free tool to view PDF metadata?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "FileIntel's PDF Metadata Inspector is the most comprehensive free tool — it runs entirely in your browser, shows 23+ metadata fields including XMP data, and provides a Privacy Risk Score showing which fields pose the highest risk. ExifTool is the best command-line option for power users on all platforms."
            }
          },
          {
            "@type": "Question",
            "name": "Can I view PDF metadata without installing software?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. FileIntel's PDF Metadata Inspector runs entirely in your web browser — no installation, no account, no upload to a server. Your PDF is processed locally in your browser tab. It works on Mac, Windows, Linux, iOS, and Android."
            }
          },
          {
            "@type": "Question",
            "name": "Why can't I see all PDF metadata fields in Adobe Reader?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Adobe Acrobat Reader only shows the DocInfo dictionary fields in its Properties dialog. Many PDFs also contain an XMP metadata stream — a separate XML blob embedded in the file — that Adobe Reader does not display in the standard Properties view. Tools like FileIntel and ExifTool read both the DocInfo and XMP streams, revealing the complete set of metadata."
            }
          }
        ]
      }
    </script>

    <!-- BreadcrumbList Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://fileintel.me"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Blog",
            "item": "https://fileintel.me/blog"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "View PDF Metadata on Mac, Windows & Linux",
            "item": "https://fileintel.me/blog/view-pdf-metadata-mac-windows-linux"
          }
        ]
      }
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/styles/global.css" />

    <style>
      /* ══ GLOBAL ══ */
      html,
      body {
        box-sizing: border-box;
        width: 100%;
        overflow-x: hidden;
      }
      * {
        box-sizing: border-box;
      }
      article {
        max-width: 100%;
        overflow-x: hidden;
      }

      /* ══ BLOG NAV BAR ══ */
      .blog-nav-bar {
        background: var(--white);
        border-bottom: 1px solid var(--border);
        padding: 10px 40px;
        width: 100%;
        box-sizing: border-box;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }
      .blog-nav-inner {
        max-width: 1160px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: var(--mono);
        font-size: 11px;
        color: var(--ink-3);
        word-break: break-word;
        white-space: nowrap;
      }
      .blog-nav-inner a {
        color: var(--ink-3);
        text-decoration: none;
        transition: color 0.15s;
        white-space: nowrap;
        word-break: break-word;
      }
      .blog-nav-inner a:hover {
        color: var(--ink);
      }

      /* ══ ARTICLE HERO ══ */
      .article-hero {
        background: var(--ink);
        padding: 64px 40px 56px;
        position: relative;
        overflow: hidden;
      }

      .article-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
          linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.025) 1px,
            transparent 1px
          );
        background-size: 48px 48px;
        pointer-events: none;
      }

      .article-hero-inner {
        max-width: 1160px;
        margin: 0 auto;
        position: relative;
        z-index: 1;
        box-sizing: border-box;
        width: 100%;
      }

      .article-meta {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
        flex-wrap: wrap;
      }

      .article-category {
        font-family: var(--mono);
        font-size: 10.5px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--accent);
        font-weight: 500;
      }

      .article-date,
      .article-read-time {
        font-family: var(--mono);
        font-size: 11px;
        color: #5a5a52;
      }

      .article-title {
        font-family: var(--serif);
        font-size: clamp(30px, 4.5vw, 52px);
        color: var(--paper);
        line-height: 1.08;
        letter-spacing: -0.025em;
        margin-bottom: 20px;
        max-width: 800px;
        word-break: break-word;
        overflow-wrap: break-word;
      }

      .article-subtitle {
        font-size: 16px;
        color: #7a7a72;
        font-weight: 300;
        line-height: 1.65;
        max-width: 620px;
        margin-bottom: 28px;
        word-break: break-word;
        overflow-wrap: break-word;
      }

      /* OS pills in hero */
      .os-pills {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
      }

      .os-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.04em;
        padding: 5px 12px;
        border: 1px solid #2a2a27;
        border-radius: 20px;
        color: #6a6a62;
      }

      /* ══ RESPONSIVE ══ */
      @media (max-width: 1024px) {
        .article-hero-inner {
          grid-template-columns: 1fr 340px;
          gap: 40px;
        }
      }

      @media (max-width: 860px) {
        .article-hero-inner {
          grid-template-columns: 1fr;
          min-height: auto;
        }
        .hero-visual {
          display: none; /* Hide on small screens — keeps hero clean */
        }
        .article-hero {
          padding: 48px 20px 40px;
        }
      }

      /* ══ ARTICLE LAYOUT ══ */
      .article-layout {
        max-width: 1160px;
        margin: 0 auto;
        padding: 56px 40px 80px;
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 64px;
        align-items: start;
        box-sizing: border-box;
        width: 100%;
      }

      body {
        box-sizing: border-box;
      }
      * {
        box-sizing: border-box;
      }

      /* ══ PROSE ══ */
      .prose {
        max-width: 680px;
      }

      .prose h2 {
        font-family: var(--serif);
        font-size: clamp(22px, 2.8vw, 30px);
        letter-spacing: -0.02em;
        color: var(--ink);
        margin: 52px 0 18px;
        line-height: 1.15;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--paper-3);
        word-break: break-word;
        overflow-wrap: break-word;
      }

      .prose h2:first-of-type {
        margin-top: 0;
      }

      .prose h3 {
        font-size: 18px;
        font-weight: 600;
        color: var(--ink);
        margin: 36px 0 12px;
        letter-spacing: -0.015em;
        word-break: break-word;
        overflow-wrap: break-word;
      }

      .prose p {
        font-size: 16px;
        color: var(--ink-2);
        line-height: 1.8;
        margin-bottom: 22px;
        word-break: break-word;
        overflow-wrap: break-word;
      }

      .prose strong {
        color: var(--ink);
        font-weight: 600;
      }

      .prose a {
        color: var(--ink);
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-color: var(--border);
        transition: all 0.15s;
        word-break: break-word;
        overflow-wrap: break-word;
      }
      .prose a:hover {
        color: var(--accent);
        text-decoration-color: var(--accent);
      }

      .prose ul,
      .prose ol {
        margin: 4px 0 22px;
        padding-left: 22px;
        overflow-wrap: break-word;
      }
      .prose li {
        font-size: 16px;
        color: var(--ink-2);
        line-height: 1.75;
        margin-bottom: 10px;
        word-break: break-word;
        overflow-wrap: break-word;
      }

      .prose code {
        font-family: var(--mono);
        font-size: 13.5px;
        background: var(--paper-2);
        padding: 2px 6px;
        border-radius: 3px;
        color: var(--ink);
        word-break: break-all;
        display: inline-block;
        max-width: 100%;
      }

      /* ══ OS METHOD CARDS ══ */
      .method-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        margin: 28px 0;
        transition: box-shadow 0.2s;
        max-width: 100%;
        word-break: break-word;
      }

      .method-card:hover {
        box-shadow: var(--shadow-sm);
      }

      .method-card-header {
        padding: 16px 22px;
        border-bottom: 1px solid var(--paper-3);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        overflow-wrap: break-word;
        word-break: break-word;
      }

      .method-card-os {
        display: flex;
        align-items: center;
        gap: 10px;
        overflow-wrap: break-word;
      }

      .method-card-icon {
        width: 36px;
        height: 36px;
        border-radius: var(--radius);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
      }

      .method-card-name {
        font-size: 15px;
        font-weight: 600;
        color: var(--ink);
        letter-spacing: -0.01em;
        word-break: break-word;
        overflow-wrap: break-word;
      }

      .method-card-tool {
        font-family: var(--mono);
        font-size: 10.5px;
        color: var(--ink-3);
        letter-spacing: 0.04em;
        word-break: break-all;
      }

      .method-difficulty {
        font-family: var(--mono);
        font-size: 10px;
        padding: 3px 8px;
        border-radius: 3px;
        font-weight: 600;
      }

      .difficulty-easy {
        background: var(--green-light);
        color: var(--green);
      }
      .difficulty-medium {
        background: var(--amber-light);
        color: var(--amber);
      }

      .method-steps {
        padding: 20px 22px;
      }

      .method-step {
        /* display: flex; */
        gap: 16px;
        /* align-items: flex-start; */
        margin-bottom: 16px;
      }

      .method-step:last-child {
        margin-bottom: 0;
      }

      .step-num {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: var(--paper-2);
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 600;
        color: var(--ink-2);
        flex-shrink: 0;
        margin-top: 1px;
      }

      .step-content h4 {
        font-size: 14px;
        font-weight: 600;
        color: var(--ink);
        margin-bottom: 4px;
        word-break: break-word;
        overflow-wrap: break-word;
      }

      .step-content p {
        font-size: 13.5px;
        color: var(--ink-3);
        margin: 0;
        line-height: 1.6;
        word-break: break-word;
        overflow-wrap: break-word;
      }

      /* Command block */
      .codebox {
        margin-top: 1rem;
        width: 100%;
        border: 1px solid #cdcdcd;
        border-radius: 3px;
      }
      .codebox .top {
        padding: 6px 10px;
        font-size: 12px;
        display: flex;
        justify-content: space-between;
        border-bottom: 1px solid #cdcdcd;
        border-radius: 3px;
      }
      .codebox .top .language {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 2px;
      }
      .codebox .top .cmd-copy {
        background: transparent;
        padding: 3px 8px;
        font-size: 10px;
        color: #353532;
        cursor: pointer;
        font-family: var(--mono);
        transition: all 0.15s;
        flex-shrink: 0;
      }
      .codebox .codeplace {
        padding: 12px;
        background: #dadada;
      }
      .codebox .codeplace .cmd-prompt {
        color: #333333;
        background: transparent;
        font-size: 11px;
        font-family: var(--mono), monospace;

        /* 1. Establish line-height so we know exactly how tall each line is */
        line-height: 18px;
        display: block;

        /* 2. Create space on the left side for the dollar signs to sit */
        padding-left: 1.25rem;
        position: relative;

        /* 3. This dynamically draws a '$' symbol as a background image on every line */
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='20' height='18'><text x='0' y='14' font-family='monospace' font-size='11px' font-weight='bold' fill='%23666666'>$</text></svg>");
        background-repeat: repeat-y;
        background-position: 0 0;

        /* 4. Ensures long lines wrap onto a new visual line naturally */
        white-space: pre-wrap;
        word-break: break-all;
      }
      .codebox .codeplace .cmd-prompt span {
        display: inline;
      }
      .cmd-comment {
        color: #79a15d;
        font-style: italic;
      }
      /* ══ COMPARISON TABLE ══ */
      .compare-table {
        width: 100%;
        border-collapse: collapse;
        margin: 24px 0;
        font-size: 13.5px;
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        table-layout: auto;
        word-break: break-word;
      }

      .compare-table th {
        padding: 11px 16px;
        text-align: left;
        font-size: 10.5px;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--ink-3);
        background: var(--paper-2);
        font-family: var(--mono);
        font-weight: 500;
        border-bottom: 1px solid var(--border);
        word-break: break-word;
        overflow-wrap: break-word;
      }

      .compare-table th.hl {
        background: var(--ink);
        color: var(--paper);
      }

      .compare-table td {
        padding: 11px 16px;
        border-bottom: 1px solid var(--paper-3);
        color: var(--ink-2);
        vertical-align: middle;
        word-break: break-word;
        overflow-wrap: break-word;
      }

      .compare-table td.hl {
        background: #f5f3ee;
        color: var(--ink);
        font-weight: 500;
      }

      .compare-table tr:last-child td {
        border-bottom: none;
      }
      .chk {
        color: var(--green);
        font-weight: 700;
      }
      .crs {
        color: var(--accent);
      }
      .par {
        color: var(--amber);
      }

      /* ══ CALLOUT ══ */
      .callout {
        border-left: 3px solid var(--accent);
        background: var(--white);
        border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
        padding: 18px 22px;
        margin: 32px 0;
        box-shadow: var(--shadow-sm);
        max-width: 100%;
        word-break: break-word;
        overflow-wrap: break-word;
      }

      .callout.green {
        border-left-color: var(--green);
      }
      .callout.amber {
        border-left-color: var(--amber);
      }
      .callout.blue {
        border-left-color: #3a6fb0;
      }

      .callout-label {
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        font-weight: 700;
        margin-bottom: 8px;
        word-break: break-word;
      }

      .callout p {
        margin: 0;
        font-size: 14.5px;
        color: var(--ink-2);
        line-height: 1.65;
        word-break: break-word;
        overflow-wrap: break-word;
      }
      .callout p + p {
        margin-top: 10px;
      }

      /* ══ ARTICLE CTA ══ */
      .article-cta {
        background: var(--ink);
        border-radius: var(--radius-lg);
        padding: 28px 32px;
        margin: 44px 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
        max-width: 100%;
        word-break: break-word;
      }

      .article-cta h3 {
        font-family: var(--serif);
        font-size: 22px;
        color: var(--paper);
        font-style: italic;
        margin-bottom: 6px;
        letter-spacing: -0.02em;
        word-break: break-word;
        overflow-wrap: break-word;
      }

      .article-cta p {
        font-size: 13.5px;
        color: #7a7a72;
        margin: 0;
        word-break: break-word;
        overflow-wrap: break-word;
      }

      /* ══ FAQ ══ */
      .faq-section {
        margin-top: 56px;
        border-top: 1px solid var(--paper-3);
        padding-top: 40px;
      }
      .faq-section-title {
        font-family: var(--serif);
        font-size: 26px;
        letter-spacing: -0.02em;
        margin-bottom: 28px;
        color: var(--ink);
        word-break: break-word;
        overflow-wrap: break-word;
      }

      .faq-item {
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        margin-bottom: 10px;
        overflow: hidden;
        background: var(--white);
      }

      .faq-question {
        width: 100%;
        text-align: left;
        padding: 16px 20px;
        background: none;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        font-size: 14.5px;
        font-weight: 600;
        color: var(--ink);
        font-family: var(--sans);
        transition: background 0.15s;
        line-height: 1.4;
        word-break: break-word;
