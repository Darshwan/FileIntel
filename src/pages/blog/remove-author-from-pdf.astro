<script>
  document.getElementById('footer-year').textContent = new Date().getFullYear();

  // Reading progress
  const bar = document.getElementById('reading-progress');
  window.addEventListener('scroll', () => {
    const docH = document.documentElement.scrollHeight - window.innerHeight;
    const pct = docH > 0 ? (window.scrollY / docH) * 100 : 0;
    bar.style.width = Math.min(pct, 100) + '%';
    bar.style.background = pct >= 99 ? 'var(--green)' : 'var(--accent)';
  }, { passive: true });

  // FAQ accordion
  function toggleFaq(item) {
    const isOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item.open').forEach(el => el.classList.remove('open'));
    if (!isOpen) item.classList.add('open');
  }

  // Checklist
  function toggleCheck(item) {
    item.classList.toggle('done');
    item.querySelector('.check-box').textContent = item.classList.contains('done') ? '\u2713' : '';
    const done = document.querySelectorAll('.checklist-item.done').length;
    document.getElementById('done-count').textContent = done;
  }

  // Demo widget
  function runStrip() {
    const fields = [
      { id: 'd1', after: '[empty]' },
      { id: 'd2', after: '[empty]' },
      { id: 'd3', after: '[empty]' },
      { id: 'd4', after: '[empty]' }
    ];
    fields.forEach((f, i) => {
      setTimeout(() => {
        const el = document.getElementById(f.id);
        el.style.opacity = '0';
        setTimeout(() => {
          el.textContent = f.after;
          el.className = 'demo-field-val cleared';
          el.style.opacity = '1';
        }, 200);
      }, i * 120);
    });
    setTimeout(() => {
      const status = document.getElementById('demo-status');
      status.textContent = '\u2713 Clean';
      status.className = 'demo-status status-clean';
    }, fields.length * 120 + 200);
  }

  function resetDemo() {
    const originals = [
      { id: 'd1', val: 'Jane Smith' },
      { id: 'd2', val: 'Jane Smith' },
      { id: 'd3', val: 'Mark Fellowes' },
      { id: 'd4', val: 'Clarke Insurance Ltd' }
    ];
    originals.forEach(f => {
      const el = document.getElementById(f.id);
      el.textContent = f.val;
      el.className = 'demo-field-val exposed';
    });
    const status = document.getElementById('demo-status');
    status.textContent = '\u25cf Exposed';
    status.className = 'demo-status status-exposed';
  }

  // Copy code
  function copyCode(btn) {
    const block = btn.parentElement;
    const text = block.innerText.replace('Copy', '').replace('\u2713 Copied', '').trim();
    navigator.clipboard.writeText(text).then(() => {
      btn.textContent = '\u2713 Copied';
      setTimeout(() => btn.textContent = 'Copy', 2000);
    });
  }

  // Active TOC
  const sections = ['where-author-comes-from','two-places-it-hides','method-1-fileintel','method-2-exiftool','method-3-acrobat','method-4-word-source','comparison','changing-vs-removing','gdpr-and-author','verification-checklist'];
  const tocLinks = document.querySelectorAll('.toc-link');
  window.addEventListener('scroll', () => {
    let current = 0;
    sections.forEach((id, i) => {
      const el = document.getElementById(id);
      if (el && window.scrollY >= el.offsetTop - 140) current = i;
    });
    tocLinks.forEach((l, i) => l.classList.toggle('active', i === current));
  }, { passive: true });
</script>

