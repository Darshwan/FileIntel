    .os-icon { font-size: 20px; flex-shrink: 0; }
    .os-name { font-size: 14px; font-weight: 700; color: var(--ink); }
    .os-sub { font-family: var(--mono); font-size: 10.5px; color: var(--ink-3); margin-top: 1px; }
    .os-difficulty { font-family: var(--mono); font-size: 10px; padding: 2px 8px; border-radius: 3px; margin-left: auto; flex-shrink: 0; }
    .diff-easy { background: var(--green-light); color: var(--green); border: 1px solid var(--green-border); }
    .diff-medium { background: var(--amber-light); color: var(--amber); }
    .os-card-body { padding: 14px 18px; font-size: 14px; color: var(--ink-2); line-height: 1.7; }
    .os-card-body p { margin-bottom: 8px; }
    .os-card-body p:last-child { margin-bottom: 0; }
    .os-steps { list-style: none; padding: 0; margin: 8px 0 0; display: flex; flex-direction: column; gap: 4px; }
    .os-steps li { display: flex; align-items: flex-start; gap: 8px; font-size: 13.5px; color: var(--ink-2); }
    .os-steps li::before { content: counter(step); counter-increment: step; font-family: var(--mono); font-size: 10px; background: var(--paper-2); border: 1px solid var(--border); border-radius: 50%; width: 18px; height: 18px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px; color: var(--ink-3); }
    .os-steps { counter-reset: step; }

    /* CODE BLOCK */
    .code-block { background: #0a0a08; border-radius: var(--radius-lg); padding: 18px 22px; margin: 16px 0; font-family: var(--mono); font-size: 13px; color: #7acc99; line-height: 1.9; overflow-x: auto; position: relative; }
    .c-comment { color: #3a5a42; }
    .c-cmd { color: #88ccaa; }
    .c-arg { color: #f0c060; }
    .c-prompt { color: #4a6a52; }
    .c-warn { color: #c8432a; }
    .copy-btn { position: absolute; top: 10px; right: 12px; background: #1a1a17; border: 1px solid #2a2a27; border-radius: 3px; padding: 3px 9px; font-size: 10px; color: #5a5a52; cursor: pointer; font-family: var(--mono); transition: all 0.15s; }
    .copy-btn:hover { background: #252522; color: #9a9a92; }

    /* STEP LIST */
    .step-list { display: flex; flex-direction: column; gap: 10px; margin: 24px 0; }
    .step-box { display: flex; gap: 18px; align-items: flex-start; padding: 16px 20px; background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); transition: box-shadow 0.15s; }
    .step-box:hover { box-shadow: 0 4px 16px rgba(15,15,13,0.10); }
    .step-num { width: 28px; height: 28px; border-radius: 50%; background: var(--paper-2); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; font-family: var(--mono); font-size: 12px; font-weight: 600; color: var(--ink-2); flex-shrink: 0; }
    .step-content h4 { font-size: 14.5px; font-weight: 600; color: var(--ink); margin-bottom: 5px; }
    .step-content p { font-size: 13.5px; color: var(--ink-3); margin: 0; line-height: 1.6; }

    /* COMPARISON TABLE */
    .table-wrapper { overflow-x: auto; margin: 24px 0; }
    .data-table { width: 100%; border-collapse: collapse; font-size: 13.5px; border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; }
    .data-table th { padding: 11px 16px; text-align: left; font-size: 10.5px; letter-spacing: 0.07em; text-transform: uppercase; color: var(--ink-3); background: var(--paper-2); font-family: var(--mono); border-bottom: 1px solid var(--border); }
    .data-table th.dark { background: var(--ink); color: var(--paper); }
    .data-table td { padding: 11px 16px; border-bottom: 1px solid var(--paper-3); color: var(--ink-2); vertical-align: top; line-height: 1.55; }
    .data-table tr:last-child td { border-bottom: none; }
    .data-table tr:nth-child(even) td { background: var(--paper); }
    .check { color: var(--green); font-weight: 700; }
    .cross { color: var(--accent); font-weight: 700; }
    .partial { color: var(--amber); font-weight: 700; }

    /* LIVE DEMO WIDGET */
    .demo-widget { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; margin: 28px 0; }
    .demo-header { padding: 14px 18px; background: var(--paper-2); border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }
    .demo-title { font-family: var(--mono); font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-3); }
