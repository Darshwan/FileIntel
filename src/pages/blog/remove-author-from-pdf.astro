  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --ink: #0f0f0d; --ink-2: #3a3a35; --ink-3: #7a7a72;
      --paper: #f5f3ee; --paper-2: #eceae3; --paper-3: #e2dfd6;
      --accent: #c8432a; --green: #2a6b4a; --green-light: #e8f2ec;
      --green-border: #b8ddc8; --amber: #b06820; --amber-light: #fef3e2;
      --border: #d4d1c8; --white: #fafaf8;
      --serif: 'Instrument Serif', Georgia, serif;
      --mono: 'DM Mono', 'Courier New', monospace;
      --sans: 'Geist', system-ui, sans-serif;
      --radius: 4px; --radius-lg: 8px;
    }
    body { font-family: var(--sans); background: var(--paper); color: var(--ink); line-height: 1.6; }

    #reading-progress { position: fixed; top: 0; left: 0; width: 0%; height: 3px; background: var(--accent); z-index: 9999; transition: width 0.08s linear; border-radius: 0 2px 2px 0; pointer-events: none; }

    .blog-nav-bar { background: var(--white); border-bottom: 1px solid var(--border); padding: 10px 40px; }
    .blog-nav-inner { max-width: 1160px; margin: 0 auto; display: flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 11px; color: var(--ink-3); }
    .blog-nav-inner a { color: var(--ink-3); text-decoration: none; }
    .blog-nav-inner a:hover { color: var(--ink); }
    @media (max-width: 700px) { .blog-nav-bar { padding: 10px 20px; } }

    .article-hero { background: var(--ink); padding: 64px 40px 56px; position: relative; overflow: hidden; }
    .article-hero::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px); background-size: 48px 48px; pointer-events: none; }
    .article-hero-inner { max-width: 1160px; margin: 0 auto; position: relative; z-index: 1; }
    .article-category { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); margin-bottom: 18px; }
    .article-title { font-family: var(--serif); font-size: clamp(30px, 4.5vw, 52px); color: var(--paper); line-height: 1.08; letter-spacing: -0.025em; margin-bottom: 20px; max-width: 820px; }
    .article-subtitle { font-size: 16px; color: #7a7a72; font-weight: 300; line-height: 1.65; max-width: 620px; }
    .hero-meta { display: flex; align-items: center; gap: 20px; margin-top: 32px; font-family: var(--mono); font-size: 10.5px; color: #4a4a42; flex-wrap: wrap; }
    @media (max-width: 700px) { .article-hero { padding: 40px 20px 36px; } }

    .article-layout { max-width: 1160px; margin: 0 auto; padding: 56px 40px 80px; display: grid; grid-template-columns: 1fr 300px; gap: 64px; align-items: start; }
    .prose { max-width: 680px; }
    .article-sidebar { position: sticky; top: 80px; align-self: start; display: flex; flex-direction: column; gap: 16px; }
    @media (max-width: 960px) { .article-layout { grid-template-columns: 1fr; gap: 40px; padding: 32px 20px 60px; } .article-sidebar { position: static; } .prose { max-width: 100%; } }

    .prose h2 { font-family: var(--serif); font-size: clamp(22px, 2.8vw, 30px); letter-spacing: -0.02em; color: var(--ink); margin: 52px 0 18px; padding-bottom: 12px; border-bottom: 1px solid var(--paper-3); }
    .prose h3 { font-size: 18px; font-weight: 600; color: var(--ink); margin: 36px 0 12px; letter-spacing: -0.015em; }
    .prose p { font-size: 16px; color: var(--ink-2); line-height: 1.8; margin-bottom: 22px; }
    .prose ul, .prose ol { padding-left: 22px; margin-bottom: 22px; }
