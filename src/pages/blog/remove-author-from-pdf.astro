      {"@type": "HowToStep", "position": 3, "name": "Check the Author field in the Privacy Risk Score", "text": "The tool shows your Author name exactly as it appears in the metadata, scored at 25/999 risk points."},
      {"@type": "HowToStep", "position": 4, "name": "Click Strip Metadata", "text": "Removes Author from both the Info dictionary and the XMP stream — the two places PDFs store this field."},
      {"@type": "HowToStep", "position": 5, "name": "Verify: open in Acrobat Reader, File > Properties > Description", "text": "The Author field should be blank. Also run exiftool document.pdf to confirm the XMP dc:creator field was also cleared."}
    ]
