        <span class="demo-field-name">XMP stream</span>
        <span class="demo-field-val exposed" id="d2">Jane Smith</span>
        <span class="demo-field-source">ExifTool dc:creator</span>
      </div>
      <div class="demo-field">
        <span class="demo-field-name">Manager</span>
        <span class="demo-field-val exposed" id="d3">Mark Fellowes</span>
        <span class="demo-field-source">Info dict</span>
      </div>
