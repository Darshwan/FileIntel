  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --ink: #0f0f0d; --ink-2: #3a3a35; --ink-3: #7a7a72;
      --paper: #f5f3ee; --paper-2: #eceae3; --paper-3: #e2dfd6;
      --accent: #c8432a; --green: #2a6b4a; --green-light: #e8f2ec;
      --green-border: #b8ddc8; --amber: #b06820; --amber-light: #fef3e2;
      --border: #d4d1c8; --white: #fafaf8;
      --serif: 'Instrument Serif', Georgia, serif;
      --mono: 'DM Mono', 'Courier New', monospace;
      --sans: 'Geist', system-ui, sans-serif;
      --radius: 4px; --radius-lg: 8px;
    }
    body { font-family: var(--sans); background: var(--paper); color: var(--ink); line-height: 1.6; }
    #reading-progress { position: fixed; top: 0; left: 0; width: 0%; height: 3px; background: var(--accent); z-index: 9999; transition: width 0.08s linear; border-radius: 0 2px 2px 0; pointer-events: none; }

    /* BREADCRUMB */
    .blog-nav-bar { background: var(--white); border-bottom: 1px solid var(--border); padding: 10px 40px; }
    .blog-nav-inner { max-width: 1160px; margin: 0 auto; display: flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 11px; color: var(--ink-3); }
    .blog-nav-inner a { color: var(--ink-3); text-decoration: none; }
    .blog-nav-inner a:hover { color: var(--ink); }
    @media (max-width: 700px) { .blog-nav-bar { padding: 10px 20px; } }

    /* HERO */
    .article-hero { background: var(--ink); padding: 0 40px; position: relative; overflow: hidden; min-height: 460px; }
    .article-hero::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px); background-size: 48px 48px; pointer-events: none; }
    .hero-inner { max-width: 1160px; margin: 0 auto; position: relative; z-index: 1; }
    .hero-layout { min-height: 460px; display: grid; grid-template-columns: minmax(0, 1fr) 390px; gap: 64px; align-items: center; }
    .hero-content { min-width: 0; padding: 56px 0; }
    .article-category { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); margin-bottom: 18px; }
    .article-title { font-family: var(--serif); font-size: clamp(28px, 4.2vw, 50px); color: var(--paper); line-height: 1.08; letter-spacing: -0.025em; margin-bottom: 20px; max-width: 820px; }
    .hero-visual { position: relative; min-height: 390px; display: flex; align-items: center; justify-content: center; }
    .hero-visual-inner { position: relative; width: min(100%, 360px); height: 390px; will-change: transform; transition: transform 0.1s linear; }
    .article-thumbnail { display: block; width: 100%; height: 390px; object-fit: cover; object-position: center top; border: 1px solid #34342f; border-radius: var(--radius-lg); box-shadow: 0 32px 80px rgba(0,0,0,0.5), 0 8px 24px rgba(0,0,0,0.3), 0 0 0 1px rgba(255,255,255,0.08); animation: heroFloat 6s ease-in-out infinite; }
    .hero-img-fade { position: absolute; right: 0; bottom: 0; left: 0; height: 72px; background: linear-gradient(to top, var(--ink), transparent); border-radius: 0 0 var(--radius-lg) var(--radius-lg); pointer-events: none; }
    @keyframes heroFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }
    .hero-visual-inner.scrolling { animation: none; }
    .article-subtitle { font-size: 16px; color: #c2c0b8; font-weight: 300; line-height: 1.65; max-width: 600px; }
    .hero-meta { display: flex; align-items: center; gap: 20px; margin-top: 28px; font-family: var(--mono); font-size: 10.5px; color: #a7a49c; flex-wrap: wrap; }
    @media (max-width: 900px) { .article-hero { padding: 0 20px; } .hero-layout { grid-template-columns: minmax(0, 1fr) 320px; gap: 36px; } }
    @media (max-width: 720px) { .article-hero { min-height: 0; } .hero-layout { display: block; min-height: 0; } .hero-content { padding: 40px 0 36px; } .hero-visual { display: none; } }

    /* AUTHOR BAR */
    .author-bar { background: var(--white); border-bottom: 1px solid var(--border); padding: 12px 40px; }
    .author-bar-inner { max-width: 1160px; margin: 0 auto; display: flex; align-items: center; gap: 12px; }
    .author-avatar { width: 36px; height: 36px; border-radius: 50%; background: var(--ink); color: var(--paper); font-family: var(--mono); font-size: 12px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .author-name { font-size: 13.5px; font-weight: 600; color: var(--ink); }
    .author-name a { color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--border); transition: border-color 0.15s; }
    .author-name a:hover { border-bottom-color: var(--ink); }
    .author-meta { font-family: var(--mono); font-size: 10.5px; color: var(--ink-3); margin-top: 2px; }
    @media (max-width: 700px) { .author-bar { padding: 12px 20px; } }

    /* LAYOUT */
    .article-layout { max-width: 1160px; margin: 0 auto; padding: 56px 40px 80px; display: grid; grid-template-columns: 1fr 300px; gap: 64px; align-items: start; }
    .prose { max-width: 680px; }
    .article-sidebar { position: sticky; top: 80px; align-self: start; display: flex; flex-direction: column; gap: 16px; }
    @media (max-width: 960px) { .article-layout { grid-template-columns: 1fr; gap: 40px; padding: 32px 20px 60px; } .article-sidebar { position: static; } .prose { max-width: 100%; } }

    /* PROSE */
    .prose h2 { font-family: var(--serif); font-size: clamp(22px, 2.8vw, 30px); letter-spacing: -0.02em; color: var(--ink); margin: 52px 0 18px; padding-bottom: 12px; border-bottom: 1px solid var(--paper-3); }
    .prose h3 { font-size: 18px; font-weight: 600; color: var(--ink); margin: 36px 0 12px; letter-spacing: -0.015em; }
    .prose p { font-size: 16px; color: var(--ink-2); line-height: 1.8; margin-bottom: 22px; }
    .prose ul, .prose ol { padding-left: 22px; margin-bottom: 22px; }
    .prose li { font-size: 15.5px; color: var(--ink-2); line-height: 1.75; margin-bottom: 8px; }
    .prose a { color: var(--accent); text-decoration: none; border-bottom: 1px solid rgba(200,67,42,0.3); transition: border-color 0.15s; }
    .prose a:hover { border-bottom-color: var(--accent); }
    .prose strong { color: var(--ink); font-weight: 600; }
    .prose code { font-family: var(--mono); font-size: 13px; background: var(--paper-2); border: 1px solid var(--border); padding: 1px 6px; border-radius: 3px; color: var(--ink); }

    /* DIRECT ANSWER */
    .direct-answer { background: var(--white); border: 2px solid var(--ink); border-radius: var(--radius-lg); padding: 22px 26px; margin: 0 0 36px; }
    .da-label { font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 10px; font-weight: 600; }
    .direct-answer p { font-size: 15.5px; color: var(--ink); line-height: 1.75; margin: 0; font-weight: 500; }
    .direct-answer p + p { margin-top: 10px; }
    .direct-answer code { font-family: var(--mono); font-size: 13.5px; background: var(--paper-2); border: 1px solid var(--border); padding: 2px 8px; border-radius: 3px; color: var(--accent); font-weight: 600; }

    /* KEY INSIGHT — AI extraction target */
    .key-insight { background: var(--paper-2); border-left: 3px solid var(--ink); border-radius: 0 var(--radius-lg) var(--radius-lg) 0; padding: 16px 20px; margin: 28px 0; }
    .ki-label { font-family: var(--mono); font-size: 9.5px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--ink-3); margin-bottom: 8px; font-weight: 600; }
    .key-insight p { font-size: 14.5px; color: var(--ink-2); line-height: 1.7; margin: 0; }
    .key-insight p strong { color: var(--ink); }

    /* CODE BLOCKS */
    .code-block { background: #060605; border-radius: var(--radius-lg); padding: 18px 22px; margin: 16px 0; font-family: var(--mono); font-size: 13px; color: #7acc99; line-height: 2; overflow-x: auto; position: relative; border: 1px solid #1a1a17; }
    .code-label { font-size: 9.5px; text-transform: uppercase; letter-spacing: 0.1em; color: #8cae98; margin-bottom: 8px; padding-bottom: 8px; border-bottom: 1px solid #1a1a17; display: block; }
    .c-comment { color: #3a5a42; }
    .c-cmd { color: #88ccaa; }
    .c-flag { color: #f0c060; }
    .c-file { color: #9ab8cc; }
    .c-prompt { color: #4a6a52; }
    .c-ok { color: #5a9a72; }
    .c-warn { color: #c8432a; }
    .c-out { color: #5a6a5a; }
    .copy-btn { position: absolute; top: 10px; right: 12px; background: #1a1a17; border: 1px solid #2a2a27; border-radius: 3px; padding: 3px 9px; font-size: 10px; color: #c0c8c0; cursor: pointer; font-family: var(--mono); transition: all 0.15s; }
    .copy-btn:hover { background: #222; color: #9a9a92; }

    /* BEFORE / AFTER COMPARISON */
    .before-after { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 24px 0; }
    @media (max-width: 640px) { .before-after { grid-template-columns: 1fr; } }
    .ba-panel { border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border); }
    .ba-header { padding: 10px 16px; display: flex; align-items: center; justify-content: space-between; }
    .ba-header.before { background: #1a0a08; border-bottom: 1px solid rgba(200,67,42,0.2); }
    .ba-header.after { background: #081a0d; border-bottom: 1px solid rgba(42,107,74,0.2); }
    .ba-title { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; }
    .ba-header.before .ba-title { color: var(--accent); }
    .ba-header.after .ba-title { color: var(--green); }
    .ba-status { font-family: var(--mono); font-size: 9px; padding: 2px 7px; border-radius: 3px; }
    .ba-header.before .ba-status { background: rgba(200,67,42,0.15); color: var(--accent); }
    .ba-header.after .ba-status { background: rgba(42,107,74,0.15); color: var(--green); }
    .ba-body { background: #060605; padding: 14px 16px; font-family: var(--mono); font-size: 11.5px; line-height: 1.9; }
    .ba-field { color: #4a6a52; }
    .ba-val-exposed { color: var(--accent); }
    .ba-val-clean { color: #3a5a42; font-style: italic; }

    /* OS TABS */
    .os-tabs { margin: 20px 0; }
    .os-tab-buttons { display: flex; gap: 4px; margin-bottom: 0; }
    .os-tab-btn { font-family: var(--mono); font-size: 11px; padding: 6px 16px; border: 1px solid var(--border); background: var(--paper-2); border-bottom: none; border-radius: var(--radius) var(--radius) 0 0; cursor: pointer; color: var(--ink-3); transition: all 0.15s; position: relative; z-index: 1; }
    .os-tab-btn.active { background: #060605; color: #7acc99; border-color: #1a1a17; border-bottom-color: #060605; }
    .os-tab-content { display: none; }
    .os-tab-content.active { display: block; }

    /* TOOL COMPARISON */
    .tool-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 24px 0; }
    @media (max-width: 640px) { .tool-grid { grid-template-columns: 1fr; } }
    .tool-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 16px 18px; }
    .tool-card.pass { border-top: 3px solid var(--green); }
    .tool-card.fail { border-top: 3px solid var(--accent); }
    .tool-card.partial { border-top: 3px solid var(--amber); }
    .tool-name { font-size: 14px; font-weight: 700; color: var(--ink); margin-bottom: 4px; }
    .tool-verdict { font-family: var(--mono); font-size: 10px; font-weight: 700; margin-bottom: 10px; }
    .tool-card.pass .tool-verdict { color: var(--green); }
    .tool-card.fail .tool-verdict { color: var(--accent); }
    .tool-card.partial .tool-verdict { color: var(--amber); }
    .tool-desc { font-size: 13px; color: var(--ink-3); line-height: 1.6; }

    /* CALLOUT */
    .callout { border-left: 3px solid var(--accent); background: var(--white); border-radius: 0 var(--radius-lg) var(--radius-lg) 0; padding: 18px 22px; margin: 32px 0; box-shadow: 0 1px 3px rgba(15,15,13,0.06); }
    .callout.green { border-left-color: var(--green); }
    .callout.amber { border-left-color: var(--amber); }
    .callout-label { font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; margin-bottom: 8px; color: var(--accent); }
    .callout.green .callout-label { color: var(--green); }
    .callout.amber .callout-label { color: var(--amber); }
    .callout p { margin: 0; font-size: 14.5px; color: var(--ink-2); line-height: 1.65; }
    .callout p + p { margin-top: 8px; }

    /* TABLE */
    .table-wrapper { overflow-x: auto; margin: 24px 0; }
    .data-table { width: 100%; border-collapse: collapse; font-size: 13.5px; border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; }
    .data-table th { padding: 11px 16px; text-align: left; font-size: 10.5px; letter-spacing: 0.07em; text-transform: uppercase; color: var(--ink-3); background: var(--paper-2); font-family: var(--mono); border-bottom: 1px solid var(--border); }
    .data-table th.dark { background: var(--ink); color: var(--paper); }
    .data-table td { padding: 11px 16px; border-bottom: 1px solid var(--paper-3); color: var(--ink-2); vertical-align: top; line-height: 1.55; }
    .data-table tr:last-child td { border-bottom: none; }
    .data-table tr:nth-child(even) td { background: var(--paper); }
    .check { color: var(--green); font-weight: 700; }
    .cross { color: var(--accent); font-weight: 700; }
    .partial-mark { color: var(--amber); font-weight: 700; }

