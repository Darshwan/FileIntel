  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --ink: #0f0f0d; --ink-2: #3a3a35; --ink-3: #7a7a72;
      --paper: #f5f3ee; --paper-2: #eceae3; --paper-3: #e2dfd6;
      --accent: #c8432a; --green: #2a6b4a; --green-light: #e8f2ec;
      --green-border: #b8ddc8; --amber: #b06820; --amber-light: #fef3e2;
      --border: #d4d1c8; --white: #fafaf8;
      --serif: 'Instrument Serif', Georgia, serif;
      --mono: 'DM Mono', 'Courier New', monospace;
      --sans: 'Geist', system-ui, sans-serif;
      --radius: 4px; --radius-lg: 8px;
    }
    body { font-family: var(--sans); background: var(--paper); color: var(--ink); line-height: 1.6; }
    #reading-progress { position: fixed; top: 0; left: 0; width: 0%; height: 3px; background: var(--accent); z-index: 9999; transition: width 0.08s linear; border-radius: 0 2px 2px 0; pointer-events: none; }

    .blog-nav-bar { background: var(--white); border-bottom: 1px solid var(--border); padding: 10px 40px; }
    .blog-nav-inner { max-width: 1160px; margin: 0 auto; display: flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 11px; color: var(--ink-3); }
    .blog-nav-inner a { color: var(--ink-3); text-decoration: none; }
    .blog-nav-inner a:hover { color: var(--ink); }
    @media (max-width: 700px) { .blog-nav-bar { padding: 10px 20px; } }

    /* HERO */
    .article-hero { background: var(--ink); padding: 64px 40px 56px; position: relative; overflow: hidden; }
    .article-hero::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px); background-size: 48px 48px; pointer-events: none; }
    .hero-inner { max-width: 1160px; margin: 0 auto; position: relative; z-index: 1; }
    .article-category { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); margin-bottom: 18px; }
    .article-title { font-family: var(--serif); font-size: clamp(28px, 4.2vw, 50px); color: var(--paper); line-height: 1.08; letter-spacing: -0.025em; margin-bottom: 20px; max-width: 820px; }
    .article-subtitle { font-size: 16px; color: #7a7a72; font-weight: 300; line-height: 1.65; max-width: 600px; }
    .hero-meta { display: flex; align-items: center; gap: 20px; margin-top: 28px; font-family: var(--mono); font-size: 10.5px; color: #4a4a42; flex-wrap: wrap; }
    @media (max-width: 700px) { .article-hero { padding: 40px 20px 36px; } }

    /* AUTHOR BAR */
    .author-bar { background: var(--white); border-bottom: 1px solid var(--border); padding: 12px 40px; }
    .author-bar-inner { max-width: 1160px; margin: 0 auto; display: flex; align-items: center; gap: 12px; }
    .author-avatar { width: 36px; height: 36px; border-radius: 50%; background: var(--ink); color: var(--paper); font-family: var(--mono); font-size: 12px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .author-name { font-size: 13.5px; font-weight: 600; color: var(--ink); }
    .author-name a { color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--border); }
    .author-name a:hover { border-bottom-color: var(--ink); }
    .author-meta { font-family: var(--mono); font-size: 10.5px; color: var(--ink-3); margin-top: 2px; }
    @media (max-width: 700px) { .author-bar { padding: 12px 20px; } }

    /* LAYOUT */
    .article-layout { max-width: 1160px; margin: 0 auto; padding: 56px 40px 80px; display: grid; grid-template-columns: 1fr 300px; gap: 64px; align-items: start; }
    .prose { max-width: 680px; }
    .article-sidebar { position: sticky; top: 80px; align-self: start; display: flex; flex-direction: column; gap: 16px; }
    @media (max-width: 960px) { .article-layout { grid-template-columns: 1fr; gap: 40px; padding: 32px 20px 60px; } .article-sidebar { position: static; } .prose { max-width: 100%; } }

    /* PROSE */
    .prose h2 { font-family: var(--serif); font-size: clamp(22px, 2.8vw, 30px); letter-spacing: -0.02em; color: var(--ink); margin: 52px 0 18px; padding-bottom: 12px; border-bottom: 1px solid var(--paper-3); }
    .prose h3 { font-size: 18px; font-weight: 600; color: var(--ink); margin: 36px 0 12px; letter-spacing: -0.015em; }
    .prose p { font-size: 16px; color: var(--ink-2); line-height: 1.8; margin-bottom: 22px; }
    .prose ul, .prose ol { padding-left: 22px; margin-bottom: 22px; }
    .prose li { font-size: 15.5px; color: var(--ink-2); line-height: 1.75; margin-bottom: 8px; }
    .prose a { color: var(--accent); text-decoration: none; border-bottom: 1px solid rgba(200,67,42,0.3); transition: border-color 0.15s; }
    .prose a:hover { border-bottom-color: var(--accent); }
    .prose strong { color: var(--ink); font-weight: 600; }
    .prose code { font-family: var(--mono); font-size: 13px; background: var(--paper-2); border: 1px solid var(--border); padding: 1px 6px; border-radius: 3px; color: var(--ink); }

    /* DIRECT ANSWER */
    .direct-answer { background: var(--white); border: 2px solid var(--ink); border-radius: var(--radius-lg); padding: 22px 26px; margin: 0 0 36px; }
    .da-label { font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 10px; font-weight: 600; }
    .direct-answer p { font-size: 15.5px; color: var(--ink); line-height: 1.75; margin: 0; font-weight: 500; }
    .direct-answer p + p { margin-top: 10px; font-weight: 400; color: var(--ink-2); font-size: 14.5px; }

    /* KEY FACT — AI extraction */
    .key-fact { background: #fdecea; border: 1px solid rgba(200,67,42,0.2); border-radius: var(--radius-lg); padding: 18px 22px; margin: 28px 0; }
    .kf-label { font-family: var(--mono); font-size: 9.5px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--accent); margin-bottom: 8px; font-weight: 700; }
    .key-fact p { font-size: 15px; color: var(--ink); line-height: 1.7; margin: 0; font-weight: 500; }

    /* BEFORE/AFTER COMPARISON */
    .comparison-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 28px 0; }
    @media (max-width: 640px) { .comparison-grid { grid-template-columns: 1fr; } }
    .comp-panel { border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border); }
    .comp-header { padding: 10px 16px; display: flex; align-items: center; justify-content: space-between; }
    .comp-header.before { background: #1a0a08; border-bottom: 1px solid rgba(200,67,42,0.2); }
    .comp-header.after { background: #0a1a10; border-bottom: 1px solid rgba(42,107,74,0.2); }
    .comp-header.neutral { background: #0f0f0d; border-bottom: 1px solid #1a1a17; }
    .comp-title { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; }
    .comp-header.before .comp-title { color: var(--accent); }
    .comp-header.after .comp-title { color: var(--green); }
    .comp-header.neutral .comp-title { color: #5a5a52; }
    .comp-badge { font-family: var(--mono); font-size: 9px; padding: 2px 7px; border-radius: 3px; }
    .comp-header.before .comp-badge { background: rgba(200,67,42,0.15); color: var(--accent); }
    .comp-header.after .comp-badge { background: rgba(42,107,74,0.15); color: var(--green); }
    .comp-body { background: #060605; padding: 14px 16px; font-family: var(--mono); font-size: 11.5px; line-height: 1.9; }
    .cf { color: #4a6a52; }
    .cv-danger { color: #c8432a; }
    .cv-warn { color: #c8a840; }
    .cv-clean { color: #5a9a72; font-style: italic; }
    .cv-new { color: #88aacc; }
    .c-note { color: #2a3a2a; font-size: 10px; }

    /* PROCESS FLOW */
    .process-flow { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; margin: 28px 0; }
    .pf-header { padding: 12px 18px; background: var(--paper-2); border-bottom: 1px solid var(--border); font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-3); font-weight: 600; }
    .pf-steps { padding: 18px; display: flex; flex-direction: column; gap: 0; }
    .pf-step { display: flex; gap: 14px; align-items: flex-start; position: relative; padding-bottom: 20px; }
    .pf-step:last-child { padding-bottom: 0; }
    .pf-step:not(:last-child)::after { content: ''; position: absolute; left: 15px; top: 32px; bottom: 0; width: 1px; background: var(--border); }
    .pf-dot { width: 30px; height: 30px; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-family: var(--mono); font-size: 11px; font-weight: 700; position: relative; z-index: 1; }
    .pf-dot.input { background: var(--paper-2); border: 1px solid var(--border); color: var(--ink-3); }
    .pf-dot.process { background: var(--amber-light); border: 1px solid var(--amber); color: var(--amber); }
    .pf-dot.danger { background: #fdecea; border: 1px solid rgba(200,67,42,0.3); color: var(--accent); }
    .pf-dot.result { background: var(--green-light); border: 1px solid var(--green-border); color: var(--green); }
    .pf-content { flex: 1; padding-top: 4px; }
    .pf-title { font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 3px; }
    .pf-desc { font-size: 13px; color: var(--ink-3); line-height: 1.55; }
    .pf-desc code { font-family: var(--mono); font-size: 11.5px; background: var(--paper-2); border: 1px solid var(--border); padding: 1px 5px; border-radius: 3px; color: var(--ink-2); }

    /* MYTH/FACT TABLE */
    .myth-table { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; margin: 28px 0; }
    .mt-header { padding: 12px 18px; background: var(--paper-2); border-bottom: 1px solid var(--border); font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-3); font-weight: 600; }
    .mt-row { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1px solid var(--paper-3); }
    .mt-row:last-child { border-bottom: none; }
    .mt-row.head-row { background: var(--paper-2); }
    .mt-cell { padding: 12px 16px; font-size: 13.5px; color: var(--ink-2); border-right: 1px solid var(--paper-3); line-height: 1.55; }
    .mt-cell:last-child { border-right: none; }
    .mt-cell.myth { color: var(--accent); font-weight: 600; }
    .mt-cell.fact { color: var(--green); font-weight: 600; }
    .mt-cell.head { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-3); font-weight: 600; }

    /* CODE BLOCK */
    .code-block { background: #060605; border-radius: var(--radius-lg); padding: 18px 22px; margin: 16px 0; font-family: var(--mono); font-size: 13px; color: #7acc99; line-height: 2; overflow-x: auto; position: relative; border: 1px solid #1a1a17; }
    .code-label { font-size: 9.5px; text-transform: uppercase; letter-spacing: 0.1em; color: #2a3a2a; margin-bottom: 8px; padding-bottom: 8px; border-bottom: 1px solid #1a1a17; display: block; }
    .c-comment { color: #3a5a42; }
    .c-cmd { color: #88ccaa; }
    .c-arg { color: #f0c060; }
    .c-prompt { color: #4a6a52; }
    .c-ok { color: #5a9a72; }
    .c-warn { color: #c8432a; }
    .copy-btn { position: absolute; top: 10px; right: 12px; background: #1a1a17; border: 1px solid #2a2a27; border-radius: 3px; padding: 3px 9px; font-size: 10px; color: #5a5a52; cursor: pointer; font-family: var(--mono); transition: all 0.15s; }
    .copy-btn:hover { background: #222; color: #9a9a92; }

    /* CALLOUT */
    .callout { border-left: 3px solid var(--accent); background: var(--white); border-radius: 0 var(--radius-lg) var(--radius-lg) 0; padding: 18px 22px; margin: 32px 0; box-shadow: 0 1px 3px rgba(15,15,13,0.06); }
    .callout.green { border-left-color: var(--green); }
    .callout.amber { border-left-color: var(--amber); }
    .callout-label { font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; margin-bottom: 8px; color: var(--accent); }
    .callout.green .callout-label { color: var(--green); }
    .callout.amber .callout-label { color: var(--amber); }
    .callout p { margin: 0; font-size: 14.5px; color: var(--ink-2); line-height: 1.65; }
    .callout p + p { margin-top: 8px; }

    /* TABLE */
    .table-wrapper { overflow-x: auto; margin: 24px 0; }
    .data-table { width: 100%; border-collapse: collapse; font-size: 13.5px; border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; }
    .data-table th { padding: 11px 16px; text-align: left; font-size: 10.5px; letter-spacing: 0.07em; text-transform: uppercase; color: var(--ink-3); background: var(--paper-2); font-family: var(--mono); border-bottom: 1px solid var(--border); }
    .data-table th.dark { background: var(--ink); color: var(--paper); }
    .data-table td { padding: 11px 16px; border-bottom: 1px solid var(--paper-3); color: var(--ink-2); vertical-align: top; line-height: 1.55; }
    .data-table tr:last-child td { border-bottom: none; }
    .data-table tr:nth-child(even) td { background: var(--paper); }
    .check { color: var(--green); font-weight: 700; }
    .cross { color: var(--accent); font-weight: 700; }

    /* CTA */
    .article-cta { background: var(--ink); border-radius: var(--radius-lg); padding: 28px 32px; margin: 44px 0; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
    .article-cta h3 { font-family: var(--serif); font-size: 22px; color: var(--paper); font-style: italic; margin-bottom: 6px; letter-spacing: -0.02em; }
    .article-cta p { font-size: 13.5px; color: #7a7a72; margin: 0; }
    .btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 20px; border-radius: var(--radius); font-size: 13.5px; font-weight: 600; text-decoration: none; transition: all 0.15s; font-family: var(--sans); }
    .btn-light { background: var(--paper); color: var(--ink); }
    .btn-light:hover { background: #fff; }

    /* FAQ */
    .faq-section { margin-top: 56px; border-top: 1px solid var(--paper-3); padding-top: 40px; }
    .faq-title { font-family: var(--serif); font-size: 26px; letter-spacing: -0.02em; margin-bottom: 28px; color: var(--ink); }
    .faq-item { border: 1px solid var(--border); border-radius: var(--radius-lg); margin-bottom: 10px; overflow: hidden; background: var(--white); }
    .faq-q { width: 100%; text-align: left; padding: 16px 20px; background: none; border: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 16px; font-size: 14.5px; font-weight: 600; color: var(--ink); font-family: var(--sans); transition: background 0.15s; line-height: 1.4; }
    .faq-q:hover { background: var(--paper); }
    .faq-q svg { flex-shrink: 0; transition: transform 0.2s; color: var(--ink-3); }
    .faq-item.open .faq-q svg { transform: rotate(180deg); }
    .faq-item.open .faq-q { background: var(--paper); }
    .faq-a { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
    .faq-item.open .faq-a { max-height: 400px; }
    .faq-a-inner { padding: 16px 20px 18px; font-size: 14.5px; color: var(--ink-2); line-height: 1.75; border-top: 1px solid var(--paper-3); }

