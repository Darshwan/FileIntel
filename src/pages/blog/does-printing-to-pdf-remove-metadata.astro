        </a>
        <a href="/blog/pdf-metadata-fields-explained" class="rel-post">
          <div class="rel-cat">Reference</div>
          <div class="rel-title">Every PDF metadata field explained</div>
        </a>
      </div>
    </div>

  </aside>
</div>

<Footer />

<script>
  // Reading progress
  const bar = document.getElementById('reading-progress');
  window.addEventListener('scroll', () => {
    const d = document.documentElement;
    const pct = d.scrollHeight - window.innerHeight > 0
      ? (window.scrollY / (d.scrollHeight - window.innerHeight)) * 100 : 0;
    bar.style.width = Math.min(pct, 100) + '%';
    bar.style.background = pct >= 99 ? 'var(--green)' : 'var(--accent)';
  }, { passive: true });

  // FAQ accordion — event listener based
  document.querySelectorAll('.faq-q').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item.open').forEach(el => el.classList.remove('open'));
      if (!isOpen) item.classList.add('open');
    });
  });

  // Copy buttons — event listener based
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const block = btn.closest('.code-block');
      const text = Array.from(block.childNodes)
        .filter(n => n.nodeType === Node.TEXT_NODE ||
          (n.tagName && n.className !== 'copy-btn' && n.className !== 'code-label'))
        .map(n => n.textContent).join('').trim();
      navigator.clipboard.writeText(text).then(() => {
        btn.textContent = '\u2713 Copied';
        setTimeout(() => btn.textContent = 'Copy', 2000);
      });
    });
  });

  // Active TOC scroll
  const sections = ['what-actually-happens','the-real-output','what-also-doesnt-work','what-actually-works','when-print-to-pdf-is-useful','verifying-your-output'];
  const tocLinks = document.querySelectorAll('.toc-link');
  window.addEventListener('scroll', () => {
    let current = 0;
    sections.forEach((id, i) => {
      const el = document.getElementById(id);
      if (el && window.scrollY >= el.offsetTop - 140) current = i;
    });
    tocLinks.forEach((l, i) => l.classList.toggle('active', i === current));
  }, { passive: true });
</script>

</body>
</html>