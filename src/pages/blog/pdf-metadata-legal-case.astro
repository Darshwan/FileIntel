      <div class="sidebar-widget-body">
        <a href="/blog/remove-metadata-from-pdf" class="related-post">
          <div class="related-post-cat">Legal</div>
          <div class="related-post-title">PDF metadata risks every lawyer should know before sending a document</div>
        </a>
        <a href="/blog/check-if-pdf-has-been-edited" class="related-post">
          <div class="related-post-cat">Forensics</div>
          <div class="related-post-title">How to check if a PDF has been edited</div>
