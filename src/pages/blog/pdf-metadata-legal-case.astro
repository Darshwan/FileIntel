<Footer />

<script>
  // Reading progress bar
  const bar = document.getElementById('reading-progress');
  window.addEventListener('scroll', () => {
    const docH = document.documentElement.scrollHeight - window.innerHeight;
    const pct = docH > 0 ? (window.scrollY / docH) * 100 : 0;
    bar.style.width = Math.min(pct, 100) + '%';
    bar.style.background = pct >= 99 ? 'var(--green)' : 'var(--accent)';
  }, { passive: true });

  // FAQ accordion — event listener based (NEVER onclick="")
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item.open').forEach(el => el.classList.remove('open'));
      if (!isOpen) item.classList.add('open');
    });
  });

  // Checklist — event listener based
  document.querySelectorAll('.checklist-item').forEach(item => {
    item.addEventListener('click', () => {
      item.classList.toggle('done');
      item.querySelector('.check-box').textContent = item.classList.contains('done') ? '✓' : '';
      const done = document.querySelectorAll('.checklist-item.done').length;
      document.getElementById('done-count').textContent = done;
    });
  });

  // Copy code button — event listener based
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const block = btn.parentElement;
      const text = block.innerText.replace('Copy', '').replace('✓ Copied', '').trim();
      navigator.clipboard.writeText(text).then(() => {
        btn.textContent = '✓ Copied';
        setTimeout(() => btn.textContent = 'Copy', 2000);
      });
    });
  });

  // Hero image parallax and float pause while scrolling
  const heroVisualInner = document.getElementById('hero-visual-inner');
  if (heroVisualInner) {
    let scrollTimer = null;
    window.addEventListener('scroll', () => {
      const scrollY = window.scrollY;
      const heroHeight = document.querySelector('.article-hero')?.getBoundingClientRect().height || 500;
      if (scrollY < heroHeight + 100) {
        heroVisualInner.style.transform = `translateY(${scrollY * 0.28}px)`;
      }
      heroVisualInner.classList.add('scrolling');
      if (scrollTimer !== null) window.clearTimeout(scrollTimer);
      scrollTimer = window.setTimeout(() => heroVisualInner.classList.remove('scrolling'), 150);
    }, { passive: true });
  }

  // Active TOC on scroll
  const sections = ['section-1', 'section-2', 'section-3', 'section-4', 'section-5', 'section-6'];
  const tocLinks = document.querySelectorAll('.toc-link');
  window.addEventListener('scroll', () => {
    let current = 0;
    sections.forEach((id, i) => {
      const el = document.getElementById(id);
      if (el && window.scrollY >= el.offsetTop - 140) current = i;
    });
    tocLinks.forEach((l, i) => l.classList.toggle('active', i === current));
  }, { passive: true });

  // Footer year
  document.getElementById('footer-year').textContent = new Date().getFullYear();
</script>
</body>
</html>
