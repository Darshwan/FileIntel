    .me-comment { color: #4a7a5a; }
    .me-key     { color: #88ccaa; }
    .me-val     { color: #f0c060; }
    .me-risk    { color: #c8432a; }

    /* ── Callout ── */
    .callout {
      border-left: 3px solid var(--accent);
      background: var(--white);
      border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
      padding: 18px 22px;
      margin: 32px 0;
