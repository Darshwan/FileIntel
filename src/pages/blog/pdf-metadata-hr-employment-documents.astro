  <style>
    /* ── Blog nav ── */
    .blog-nav-bar { background:var(--white); border-bottom:1px solid var(--border); padding:10px 40px; }
    .blog-nav-inner { max-width:1160px; margin:0 auto; display:flex; align-items:center; gap:8px; font-family:var(--mono); font-size:11px; color:var(--ink-3); }
    .blog-nav-inner a { color:var(--ink-3); text-decoration:none; transition:color 0.15s; }
    .blog-nav-inner a:hover { color:var(--ink); }

    /* ── Hero ── */
