    }

    .audience-panel-label.hr  { color: var(--accent); }
    .audience-panel-label.job { color: var(--green); }

    .audience-panel-body { padding: 18px 20px; background: var(--white); }
    .audience-panel-body p { font-size:13.5px; color:var(--ink-2); line-height:1.65; margin:0; }
