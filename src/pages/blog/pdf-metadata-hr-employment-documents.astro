  <!-- NAV -->
  <Navbar activePage="blog" />

  <!-- BREADCRUMB -->
  <div class="blog-nav-bar">
    <div class="blog-nav-inner">
      <a href="/">Home</a>
      <span>›</span>
      <a href="/blog">Blog</a>
      <span>›</span>
      <span>PDF Metadata in HR & Employment Documents</span>
    </div>
