    /* ── Audience split section ── */
    .audience-split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin: 32px 0;
    }

    .audience-panel {
      border-radius: var(--radius-lg);
      overflow: hidden;
      border: 1px solid var(--border);
    }

    .audience-panel-head {
      padding: 14px 20px;
