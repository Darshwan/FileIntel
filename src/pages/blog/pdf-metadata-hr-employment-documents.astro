    /* ── Risk document table ── */
    .risk-table {
      width: 100%;
      border-collapse: collapse;
      margin: 24px 0;
      font-size: 13.5px;
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
    }

    .risk-table th {
      padding: 11px 16px;
      text-align: left;
      font-size: 10.5px;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      color: var(--ink-3);
      background: var(--paper-2);
      font-family: var(--mono);
      font-weight: 500;
      border-bottom: 1px solid var(--border);
    }

    .risk-table td {
      padding: 11px 16px;
      border-bottom: 1px solid var(--paper-3);
      color: var(--ink-2);
      vertical-align: top;
    }

    .risk-table tr:last-child td { border-bottom: none; }
    .risk-table tr:nth-child(even) td { background: var(--paper); }

    .risk-pill {
      display: inline-block;
      font-family: var(--mono);
      font-size: 10px;
      padding: 2px 7px;
      border-radius: 3px;
      font-weight: 600;
    }

    .risk-high   { background: #fdecea; color: var(--accent); }
    .risk-medium { background: #fef3e2; color: var(--amber); }
    .risk-low    { background: var(--green-light); color: var(--green); }

