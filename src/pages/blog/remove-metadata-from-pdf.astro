<script>
  document.getElementById('footer-year').textContent = new Date().getFullYear();

  // Reading progress bar
  const bar = document.getElementById('reading-progress');
  window.addEventListener('scroll', () => {
    const docH = document.documentElement.scrollHeight - window.innerHeight;
    const pct = docH > 0 ? (window.scrollY / docH) * 100 : 0;
    bar.style.width = Math.min(pct, 100) + '%';
    bar.style.background = pct >= 99 ? 'var(--green)' : 'var(--accent)';
  }, { passive: true });

  // FAQ accordion
  function toggleFaq(item) {
    const isOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item.open').forEach(el => el.classList.remove('open'));
    if (!isOpen) item.classList.add('open');
  }

  // Checklist
  function toggleCheck(item) {
    item.classList.toggle('done');
    item.querySelector('.check-box').textContent = item.classList.contains('done') ? '\u2713' : '';
    const done = document.querySelectorAll('.checklist-item.done').length;
    document.getElementById('done-count').textContent = done;
  }

  // Before/after field scanner
  function showState(state, btn) {
    document.getElementById('state-before').style.display = state === 'before' ? '' : 'none';
    document.getElementById('state-after').style.display = state === 'after' ? '' : 'none';
    document.querySelectorAll('.toggle-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
  }

  // Animate risk bars on scroll into view
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.querySelectorAll('.risk-bar-fill').forEach(bar => {
          const w = bar.dataset.width;
          bar.style.width = '0%';
          setTimeout(() => { bar.style.width = w + '%'; }, 100);
        });
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.3 });
  const riskWidget = document.querySelector('.risk-score-widget');
  if (riskWidget) observer.observe(riskWidget);

  // Copy code blocks
  function copyCode(btn) {
    const block = btn.parentElement;
    const text = block.innerText.replace('Copy', '').replace('\u2713 Copied', '').trim();
    navigator.clipboard.writeText(text).then(() => {
      btn.textContent = '\u2713 Copied';
      setTimeout(() => btn.textContent = 'Copy', 2000);
    });
  }

  // Active TOC on scroll
  const sections = ['what-youre-actually-removing','method-1-browser-tool','method-2-exiftool','method-3-adobe-acrobat','method-4-qpdf-command-line','which-method-when','what-doesnt-work','privacy-risk-score','compliance-why-it-matters','before-you-send-checklist'];
  const tocLinks = document.querySelectorAll('.toc-link');
  window.addEventListener('scroll', () => {
    let current = 0;
    sections.forEach((id, i) => {
      const el = document.getElementById(id);
      if (el && window.scrollY >= el.offsetTop - 140) current = i;
    });
    tocLinks.forEach((l, i) => l.classList.toggle('active', i === current));
  }, { passive: true });
</script>

