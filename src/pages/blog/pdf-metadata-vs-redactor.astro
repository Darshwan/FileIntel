<script>
  // Footer year
  document.getElementById('footer-year').textContent = new Date().getFullYear();

  // FAQ accordion — ensure proper toggle
  function toggleFaq(element) {
    const faqItem = element.closest('.faq-item');
    if (!faqItem) return;
    
    const isOpen = faqItem.classList.contains('open');
    
    // Close all FAQ items
    document.querySelectorAll('.faq-item.open').forEach(item => {
      item.classList.remove('open');
    });
    
    // Open clicked item if it was closed
    if (!isOpen) {
      faqItem.classList.add('open');
    }
  }

  // Active TOC on scroll
  const sections = ['what-is-redaction', 'what-is-metadata', 'the-difference', 'when-you-need-both', 'how-to-do-both', 'compliance'];
  const tocLinks = document.querySelectorAll('.toc-link');
  window.addEventListener('scroll', () => {
    let current = 0;
    sections.forEach((id, i) => {
      const el = document.getElementById(id);
      if (el && window.scrollY >= el.offsetTop - 140) current = i;
    });
    tocLinks.forEach((l, i) => l.classList.toggle('active', i === current));
  }, { passive: true });

  // Copy code block — fixed to handle text extraction properly
  function copyCmd(btn) {
    const codeBlock = btn.closest('.code-block');
    if (!codeBlock) return;
    
    // Get all text content except the button
    const allText = Array.from(codeBlock.childNodes)
      .filter(node => node !== btn)
      .map(node => {
        if (node.nodeType === Node.TEXT_NODE) {
          return node.textContent;
        } else if (node.nodeType === Node.ELEMENT_NODE) {
          return node.textContent;
        }
        return '';
      })
      .join('')
      .trim();
    
    // Clean up the text
    const lines = allText.split('\n')
      .filter(line => !line.includes('Copy'))
      .map(line => line.replace(/^#.*/, '').trim())
      .filter(line => line.length > 0);
    
    const cleanText = lines.join('\n').trim();
    
    navigator.clipboard.writeText(cleanText).then(() => {
      btn.textContent = '✓ Copied';
      setTimeout(() => btn.textContent = 'Copy', 2000);
    }).catch(() => {
      btn.textContent = 'Failed to copy';
      setTimeout(() => btn.textContent = 'Copy', 2000);
    });
  }

  // Nav dropdown (if needed for tools)
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') document.querySelectorAll('[aria-expanded="true"]').forEach(el => el.setAttribute('aria-expanded', 'false'));
  });
</script>

