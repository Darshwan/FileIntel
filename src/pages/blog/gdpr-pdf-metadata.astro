    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/styles/global.css" />

    <style>
      /* ══ BLOG LAYOUT ══ */
      .blog-page {
        background: var(--paper);
        min-height: 100vh;
      }

      /* ══ ARTICLE HERO — SPLIT WITH VISUAL ══ */
      .article-hero {
        background: var(--ink);
        padding: 64px 40px 56px;
        position: relative;
        overflow: hidden;
      }

      /* Grid texture */
      .article-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
        background-size: 48px 48px;
        pointer-events: none;
      }

      .article-hero-inner {
        max-width: 1160px;
        margin: 0 auto;
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: 1fr 420px;
        gap: 64px;
        align-items: center;
        min-height: 420px;
      }

      /* LEFT */
      .hero-content {
        display: flex;
        flex-direction: column;
        gap: 0;
      }

      /* RIGHT: visual container */
      .hero-visual {
        position: relative;
        height: 100%;
        min-height: 380px;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .hero-visual-inner {
        position: relative;
        width: 100%;
        will-change: transform;
        transition: transform 0.1s linear;
      }

      .hero-img {
        width: 100%;
        height: auto;
        border-radius: var(--radius-lg);
        box-shadow:
          0 32px 80px rgba(0, 0, 0, 0.5),
          0 8px 24px rgba(0, 0, 0, 0.3),
          0 0 0 1px rgba(255, 255, 255, 0.06);
        display: block;
        /* Initial float position */
        animation: heroFloat 6s ease-in-out infinite;
      }

      /* Soft gradient fade at bottom of image — blends into hero bg */
      .hero-img-fade {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 80px;
        background: linear-gradient(to top, var(--ink), transparent);
        border-radius: 0 0 var(--radius-lg) var(--radius-lg);
        pointer-events: none;
      }

      /* Floating animation — subtle up/down breathing */
      @keyframes heroFloat {
        0% {
          transform: translateY(0px);
        }
        50% {
          transform: translateY(-12px);
        }
        100% {
          transform: translateY(0px);
        }
      }

      /* Pause float during scroll (JS adds this class) */
      .hero-visual-inner.scrolling {
        animation: none;
      }

      /* ══ RESPONSIVE ══ */
      @media (max-width: 1024px) {
        .article-hero-inner {
          grid-template-columns: 1fr 340px;
          gap: 40px;
        }
      }

      @media (max-width: 860px) {
        .article-hero-inner {
          grid-template-columns: 1fr;
          min-height: auto;
        }
        .hero-visual {
          display: none; /* Hide on small screens — keeps hero clean */
        }
        .article-hero {
          padding: 48px 20px 40px;
        }
      }

      /* Subtle grid texture */
      .article-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
        background-size: 48px 48px;
        pointer-events: none;
      }

      .article-hero-inner {
        max-width: 1160px;
        margin: 0 auto;
        position: relative;
        z-index: 1;
      }

      .breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 28px;
        font-family: var(--mono);
        font-size: 11px;
        color: #4a4a42;
      }

      .breadcrumb a {
        color: #5a5a52;
        text-decoration: none;
        transition: color 0.15s;
      }
      .breadcrumb a:hover {
        color: #9a9a92;
      }
      .breadcrumb-sep {
        color: #3a3a35;
      }

      .article-meta {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
        flex-wrap: wrap;
      }

      .article-category {
        font-family: var(--mono);
        font-size: 10.5px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--accent);
        font-weight: 500;
      }

      .article-date,
      .article-read-time {
        font-family: var(--mono);
        font-size: 11px;
        color: #5a5a52;
      }

      .article-title {
        font-family: var(--serif);
        font-size: clamp(30px, 4.5vw, 52px);
        color: var(--paper);
        line-height: 1.08;
        letter-spacing: -0.025em;
        margin-bottom: 20px;
        max-width: 760px;
      }

      .article-subtitle {
        font-size: 16.5px;
        color: #7a7a72;
        font-weight: 300;
        line-height: 1.65;
        max-width: 620px;
        margin-bottom: 32px;
      }

      .article-tags {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
      }

      .article-tag {
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 3px 10px;
        border: 1px solid #2a2a27;
        border-radius: 20px;
        color: #5a5a52;
      }

      /* ── Article Layout ── */
      .article-layout {
        max-width: 1160px;
        margin: 0 auto;
        padding: 56px 40px 80px;
        display: grid;
        grid-template-columns: 1fr 308px;
        gap: 64px;
        align-items: start;
      }

      /* ── Prose ── */
      .prose {
        max-width: 680px;
      }

      .prose h2 {
        font-family: var(--serif);
        font-size: clamp(22px, 2.8vw, 30px);
        letter-spacing: -0.02em;
        color: var(--ink);
        margin: 52px 0 18px;
        line-height: 1.15;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--paper-3);
      }

      .prose h2,
      .faq-section-title {
        scroll-margin-top: calc(var(--nav-height) + 24px);
      }

      .prose h2:first-of-type {
        margin-top: 0;
      }

      .prose h3 {
        font-size: 18px;
        font-weight: 600;
        color: var(--ink);
        margin: 36px 0 12px;
        letter-spacing: -0.015em;
        line-height: 1.3;
      }

      .prose p {
        font-size: 16px;
        color: var(--ink-2);
        line-height: 1.8;
        margin-bottom: 22px;
      }

      .prose strong {
        color: var(--ink);
        font-weight: 600;
      }
      .prose em {
        font-style: italic;
      }

      .prose a {
        color: var(--ink);
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-color: var(--border);
        transition: all 0.15s;
      }

      .prose a:hover {
        color: var(--accent);
        text-decoration-color: var(--accent);
      }

      .prose ul,
      .prose ol {
        margin: 4px 0 22px;
        padding-left: 22px;
      }

      .prose li {
        font-size: 16px;
        color: var(--ink-2);
        line-height: 1.75;
        margin-bottom: 10px;
      }

      .prose code {
        font-family: var(--mono);
        font-size: 13.5px;
        background: var(--paper-2);
        padding: 2px 6px;
        border-radius: 3px;
        color: var(--ink);
      }

      /* ── Callout boxes ── */
      .callout {
        border-left: 3px solid var(--accent);
        background: var(--white);
        border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
        padding: 18px 22px;
        margin: 32px 0;
        box-shadow: var(--shadow-sm);
      }

      .callout.green {
        border-left-color: var(--green);
      }
      .callout.amber {
        border-left-color: var(--amber);
      }
      .callout.blue {
        border-left-color: #3a6fb0;
      }
      .callout.purple {
        border-left-color: #6a4fb0;
      }

      .callout-label {
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        font-weight: 700;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .callout p {
        margin: 0;
        font-size: 14.5px;
        color: var(--ink-2);
        line-height: 1.65;
      }

      .callout p + p {
        margin-top: 10px;
      }

      /* ── GDPR Article reference boxes ── */
      .gdpr-article-box {
        background: #0f1a2e;
        border: 1px solid #1a3050;
        border-radius: var(--radius-lg);
        padding: 20px 22px;
        margin: 28px 0;
      }

      .gdpr-article-label {
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #4a7ab0;
        margin-bottom: 8px;
        font-weight: 600;
      }

      .gdpr-article-num {
        font-family: var(--serif);
        font-size: 15px;
        color: #88b8e8;
        margin-bottom: 8px;
        font-style: italic;
      }

      .gdpr-article-text {
        font-size: 13.5px;
        color: #6a8aaa;
        line-height: 1.65;
        font-style: italic;
      }

      .gdpr-article-source {
        font-family: var(--mono);
        font-size: 10px;
        color: #3a5a7a;
        margin-top: 8px;
      }

      /* ── Data flow diagram ── */
      .data-flow {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 24px;
        margin: 28px 0;
      }

      .data-flow-title {
        font-family: var(--mono);
        font-size: 10.5px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-3);
        margin-bottom: 18px;
      }

      .flow-steps {
        display: flex;
        flex-direction: column;
        gap: 3px;
      }

      .flow-step {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 14px;
        border-radius: var(--radius);
        border: 1px solid var(--paper-3);
        background: var(--paper);
        transition: background 0.15s;
      }

      .flow-step:hover {
        background: var(--paper-2);
      }

      .flow-step-icon {
        width: 32px;
        height: 32px;
        border-radius: var(--radius);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        flex-shrink: 0;
      }

      .flow-step-text h4 {
        font-size: 13px;
        font-weight: 600;
        color: var(--ink);
        margin-bottom: 2px;
      }
      .flow-step-text p {
        font-size: 11.5px;
        color: var(--ink-3);
        margin: 0;
        font-family: var(--mono);
      }

      .flow-arrow {
        text-align: center;
        color: var(--paper-3);
        font-size: 14px;
        padding: 2px 0;
      }

      .flow-risk-badge {
        margin-left: auto;
        font-family: var(--mono);
        font-size: 9.5px;
        padding: 2px 7px;
        border-radius: 3px;
        font-weight: 600;
        flex-shrink: 0;
      }

      /* ── Compliance checklist ── */
      .checklist {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        margin: 28px 0;
      }

      .checklist-header {
        padding: 14px 20px;
        background: var(--paper-2);
        border-bottom: 1px solid var(--border);
        font-family: var(--mono);
        font-size: 10.5px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-3);
        font-weight: 600;
      }

      .checklist-item {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 14px 20px;
        border-bottom: 1px solid var(--paper-3);
        transition: background 0.12s;
      }

      .checklist-item:last-child {
        border-bottom: none;
      }
      .checklist-item:hover {
        background: var(--paper);
      }

      .checklist-box {
        width: 18px;
        height: 18px;
        border: 1.5px solid var(--border);
        border-radius: 3px;
        flex-shrink: 0;
        margin-top: 2px;
        cursor: pointer;
        transition: all 0.15s;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .checklist-box:hover {
        border-color: var(--green);
      }
      .checklist-box.checked {
        background: var(--green);
        border-color: var(--green);
      }
      .checklist-box.checked::after {
        content: "✓";
        color: white;
        font-size: 11px;
        font-weight: 700;
        line-height: 1;
      }

      .checklist-text h4 {
        font-size: 13.5px;
        font-weight: 600;
        color: var(--ink);
        margin-bottom: 3px;
      }
      .checklist-text p {
        font-size: 12.5px;
        color: var(--ink-3);
        margin: 0;
        line-height: 1.5;
      }

      /* ── Article CTA ── */
      .article-cta {
        background: var(--ink);
        border-radius: var(--radius-lg);
        padding: 0px 32px 28px 32px;
        margin: 44px 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
        position: relative;
        overflow: hidden;
      }

      .article-cta::before {
        content: "🔒";
        position: absolute;
        right: 140px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 80px;
        opacity: 0.04;
        pointer-events: none;
      }

      .article-cta h3 {
        font-family: var(--serif);
        font-size: 22px;
        color: var(--paper);
        font-style: italic;
        margin-bottom: 6px;
        letter-spacing: -0.02em;
      }
      .article-cta p {
        font-size: 13.5px;
        color: #7a7a72;
        margin: 0;
      }

      /* ── FAQ section ── */
      .faq-section {
        margin-top: 56px;
        border-top: 1px solid var(--paper-3);
        padding-top: 40px;
      }

      .faq-section-title {
        font-family: var(--serif);
        font-size: 26px;
        letter-spacing: -0.02em;
        margin-bottom: 28px;
        color: var(--ink);
      }

      .faq-item {
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        margin-bottom: 10px;
        overflow: hidden;
        background: var(--white);
      }

      .faq-question {
        width: 100%;
        text-align: left;
        padding: 16px 20px;
        background: none;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        font-size: 14.5px;
        font-weight: 600;
        color: var(--ink);
        font-family: var(--sans);
        transition: background 0.15s;
        line-height: 1.4;
      }

      .faq-question:hover {
        background: var(--paper);
      }

      .faq-question svg {
        flex-shrink: 0;
        transition: transform 0.2s ease;
        color: var(--ink-3);
      }

      .faq-item.open .faq-question svg {
        transform: rotate(180deg);
      }
      .faq-item.open .faq-question {
        background: var(--paper);
      }

      .faq-answer {
        max-height: 0;
        overflow: hidden;
        transition:
          max-height 0.3s ease,
          padding 0.2s ease;
      }

      .faq-item.open .faq-answer {
        max-height: 1000px;
      }

      .faq-answer-inner {
        padding: 0 20px 18px;
        font-size: 14.5px;
