    <script>
      // ── Scroll progress bar ──
      (function () {
  const progressBar = document.createElement("div");

  progressBar.className = "scroll-progress";

  document.body.insertBefore(
    progressBar,
    document.body.firstChild
  );

  const updateProgress = () => {
    const windowHeight =
      document.documentElement.scrollHeight -
      window.innerHeight;

    const scrolled = window.scrollY;

    const scrollPercent =
      windowHeight > 0
        ? scrolled / windowHeight
        : 0;

    progressBar.style.transform =
      `scaleX(${scrollPercent})`;
  };

  window.addEventListener(
    "scroll",
    updateProgress,
    { passive: true }
  );

  updateProgress();
})();

      // ── FAQ accordion ──
      document.querySelectorAll(".faq-question").forEach((button) => {
  button.addEventListener("click", () => {
    const item = button.parentElement;
    if (!item) return;

    const isOpen = item.classList.contains("open");

    document.querySelectorAll(".faq-item.open").forEach((el) => {
      el.classList.remove("open");
    });

    if (!isOpen) {
      item.classList.add("open");
    }
  });
});

  // ── Compliance checklist ──
  const checklistContainer = document.getElementById("compliance-checklist");

  const totalCount = checklistContainer
    ? checklistContainer.querySelectorAll(".checklist-box").length
    : 0;

  function toggleCheck(box: HTMLElement) {
    // 1. Toggle visual state
    box.classList.toggle("checked");

    // 2. Accessibility
    const isChecked = box.classList.contains("checked");

    box.setAttribute(
      "aria-checked",
      isChecked ? "true" : "false"
    );

    // 3. Progress
    const checkedCount =
      document.querySelectorAll(".checklist-box.checked").length;

    updateProgressBar(checkedCount, totalCount);
  }

  // Attach click listeners
  const checklistBoxes =
    document.querySelectorAll<HTMLElement>(".checklist-box");

  checklistBoxes.forEach((box) => {
    // Mouse click
    box.addEventListener("click", () => {
      toggleCheck(box);
    });

    // Keyboard accessibility
    box.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        toggleCheck(box);
      }
    });
  });


function updateProgressBar(checked: number, total: number) {
  // Your progress UI logic here (e.g., "3 of 7 completed")
  console.log(`${checked} of ${total} tasks completed`);
}

      // ── Active TOC on scroll (simple version) ──
      const tocLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>(".toc-link"),
      );
      const headings = Array.from(
        document.querySelectorAll<HTMLElement>(".prose h2[id]"),
      );

      const updateActiveTocLink = () => {
        let currentId = headings[0]?.id ?? "";

        headings.forEach((heading) => {
          if (window.scrollY >= heading.offsetTop - 120) {
            currentId = heading.id;
          }
        });

        tocLinks.forEach((link) => {
          const targetId = link.getAttribute("href")?.slice(1) ?? "";
          link.classList.toggle("active", targetId === currentId);
        });
      };

      window.addEventListener("scroll", updateActiveTocLink, {
        passive: true,
      });
      updateActiveTocLink();

      // ── Hero image parallax on scroll ──
      const heroVisualInner = document.getElementById("hero-visual-inner");

      if (heroVisualInner) {
        let scrollTimer: ReturnType<typeof window.setTimeout> | null = null;
        let lastScrollY = window.scrollY;

        window.addEventListener(
          "scroll",
          () => {
            const scrollY = window.scrollY;
            const heroHeight =
              (document.querySelector(".article-hero") as HTMLElement | null)
                ?.offsetHeight || 500;

            // Only apply within hero range — past hero it stops
            if (scrollY < heroHeight + 100) {
              // Parallax: image moves UP slower than page scrolls — creates depth
              const parallaxY = scrollY * 0.28;
              heroVisualInner.style.transform = `translateY(${parallaxY}px)`;
            }

            // Pause float animation while scrolling
            heroVisualInner.classList.add("scrolling");
            if (scrollTimer) {
              window.clearTimeout(scrollTimer);
            }
            scrollTimer = window.setTimeout(() => {
              heroVisualInner.classList.remove("scrolling");
            }, 150);

            lastScrollY = scrollY;
          },
          { passive: true },
        );
      }
    </script>
