---
import Navbar from "../../components/Navbar.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>Articles | FileIntel</title>
        <meta
            name="description"
            content="Expert guides on PDF metadata, GDPR compliance, document security, and file privacy for lawyers, journalists, freelancers, and compliance teams."
        />
        <link rel="canonical" href="https://fileintel.me/blog" />

        <meta property="og:type" content="website" />
        <meta property="og:url" content="https://fileintel.me/blog" />
        <meta
            property="og:title"
            content="FileIntel Blog — File Privacy & Document Security"
        />
        <meta
            property="og:description"
            content="Expert guides on PDF metadata, GDPR, and document security for professionals."
        />
        <meta property="og:image" content="https://fileintel.me/og-blog.png" />

        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "Blog",
                "name": "FileIntel Blog",
                "description": "Expert guides on PDF metadata, GDPR compliance, document security, and file privacy.",
                "url": "https://fileintel.me/blog",
                "publisher": {
                    "@type": "Organization",
                    "name": "FileIntel",
                    "url": "https://fileintel.me"
                }
            }
        </script>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link
            href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Mono:wght@400;500&family=Geist:wght@300;400;500;600&display=swap"
            rel="stylesheet"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="stylesheet" href="/styles/global.css" />

        <style>
            /* ══ BLOG PAGE TOKENS ══ */
            :root {
                --col-gap: 24px;
                --hero-h: 540px;
            }

            /* ══ HERO ══ */
            /* ══ HERO ══ */
            .blog-hero {
                background: var(--ink);
                min-height: 520px;
                display: flex;
                align-items: stretch;
                position: relative;
                overflow: hidden;
            }

            /* Decorative lines */
            .blog-hero-bg {
                position: absolute;
                inset: 0;
                pointer-events: none;
                overflow: hidden;
            }

            .bg-line {
                position: absolute;
                background: rgba(255, 255, 255, 0.1);
            }

            .bg-line-1 {
                width: 1px;
                height: 100%;
                left: 33.33%;
                top: 0;
            }

            .bg-line-2 {
                width: 1px;
                height: 100%;
                left: 66.66%;
                top: 0;
            }

            .bg-line-3 {
                width: 100%;
                height: 1px;
                top: 56%;
                left: 0;
            }

            .bg-orb {
                position: absolute;
                width: 600px;
                height: 600px;
                border-radius: 50%;
                background: radial-gradient(
                    circle,
                    rgba(200, 67, 42, 0.06) 0%,
                    transparent 70%
                );
                right: -100px;
                top: -100px;
                pointer-events: none;
            }

            .hero-inner {
                max-width: var(--max-width);
                width: 100%;
                margin: 0 auto;
                padding: 56px 40px 48px;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                gap: 36px;
                position: relative;
                z-index: 1;
            }

            .hero-issue {
                font-family: var(--mono);
                font-size: 10.5px;
                letter-spacing: 0.14em;
                text-transform: uppercase;
                color: #777;
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .hero-issue-dot {
                display: block;
                width: 5px;
                height: 5px;
                border-radius: 50%;
                background: #3a3a35;
                flex-shrink: 0;
            }

            .hero-headline-wrap {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 40px;
                align-items: end;
            }

            .hero-title {
                font-family: var(--serif);
                font-size: clamp(44px, 6vw, 76px);
                line-height: 1.02;
                letter-spacing: -0.03em;
                color: var(--paper);
            }

            .hero-title em {
                font-style: italic;
                color: var(--accent);
            }

            .hero-desc {
                font-size: 15.5px;
                color: #9c9b93;
                line-height: 1.8;
                font-weight: 300;
                max-width: 460px;
                align-self: end;
            }

            .hero-actions {
                display: flex;
                align-items: center;
                gap: 14px;
                margin-top: 20px;
                flex-wrap: wrap;
            }

            .hero-action-primary,
            .hero-action-secondary {
                text-decoration: none;
                transition: all 0.18s ease;
            }

            .hero-action-primary {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 12px 18px;
                border-radius: 999px;
                background: var(--paper);
                color: var(--ink);
                font-family: var(--sans);
                font-size: 13px;
                font-weight: 600;
                letter-spacing: -0.01em;
                box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
            }

            .hero-action-primary:hover {
                transform: translateY(-1px);
                background: var(--white);
            }

            .hero-action-secondary {
                font-family: var(--mono);
                font-size: 11px;
                color: #7d7a72;
                letter-spacing: 0.08em;
                text-transform: uppercase;
            }

            .hero-action-secondary:hover {
                color: var(--paper);
            }

            /* Bottom row */
            .hero-bottom {
                display: flex;
                align-items: stretch;
                justify-content: space-between;
                gap: 24px;
                border-top: 1px solid #1e1e1a;
                padding-top: 28px;
                flex-wrap: wrap;
            }

            .hero-stats {
                display: flex;
                align-items: center;
                gap: 20px;
                opacity: 0.72;
            }

            .hero-stat-num {
                font-family: var(--serif);
                font-size: 22px;
                font-style: italic;
                color: var(--paper);
                line-height: 1;
                margin-bottom: 4px;
            }

            .hero-stat-label {
                font-family: var(--mono);
                font-size: 9px;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                color: #888;
            }

            .hero-stat-divider {
                width: 1px;
                height: 32px;
                background: #1e1e1a;
                flex-shrink: 0;
            }

            /* Featured article link in bottom row */
            .hero-featured-link {
                text-decoration: none;
                display: flex;
                align-items: center;
            }

            .hero-featured-link-inner {
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: var(--radius-lg);
                padding: 18px 22px;
                display: flex;
                flex-direction: column;
                gap: 8px;
                max-width: 460px;
                transition: all 0.2s;
                background: rgba(255, 255, 255, 0.035);
                box-shadow: 0 18px 40px rgba(0, 0, 0, 0.16);
            }

            .hero-featured-link:hover .hero-featured-link-inner {
                border-color: rgba(255, 255, 255, 0.16);
                background: rgba(255, 255, 255, 0.05);
                transform: translateY(-1px);
            }

            .hero-featured-eyebrow {
                display: flex;
                align-items: center;
                gap: 6px;
                font-family: var(--mono);
                font-size: 9.5px;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                color: #f0c060;
            }

            .hero-featured-dot {
                width: 5px;
                height: 5px;
                border-radius: 50%;
                background: #f0c060;
                flex-shrink: 0;
            }

            .hero-featured-title {
                font-size: 14px;
                font-weight: 600;
                color: var(--paper);
                line-height: 1.45;
                letter-spacing: -0.01em;
            }

            .hero-featured-arrow {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                font-size: 12px;
                color: #87837a;
                font-family: var(--mono);
                margin-top: 2px;
                transition:
                    gap 0.18s,
                    color 0.18s;
            }

            .hero-featured-link:hover .hero-featured-arrow {
                gap: 9px;
                color: var(--paper);
            }

            /* ══ SECTION DIVIDER ══ */
            .section-rule {
                display: flex;
                align-items: center;
                gap: 16px;
                max-width: 1160px;
                margin: 0 auto;
                padding: 0 40px;
            }

            .section-rule-line {
                flex: 1;
                height: 1px;
                background: var(--border);
            }

            .section-rule-label {
                font-family: var(--mono);
                font-size: 10px;
                letter-spacing: 0.12em;
                text-transform: uppercase;
                color: var(--ink-3);
                white-space: nowrap;
                padding: 0 4px;
            }

            /* ══ ARTICLES GRID ══ */
            .articles-section {
                max-width: 1160px;
                margin: 0 auto;
                padding: 56px 40px 80px;
            }

            .articles-grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: var(--col-gap);
                margin-top: 40px;
            }

            /* ── Article Card ── */
            .article-card {
                background: var(--white);
                border: 1px solid var(--border);
                border-radius: var(--radius-lg);
                overflow: hidden;
                text-decoration: none;
                color: inherit;
                display: flex;
                flex-direction: column;
                transition: all 0.22s ease;
                position: relative;
            }

            .article-card:hover {
                border-color: var(--ink-2);
                box-shadow: var(--shadow-md);
                transform: translateY(-3px);
            }

            /* Category color accent bar */
            .article-card-accent {
                height: 3px;
                width: 100%;
            }

            .article-card-body {
                padding: 24px 24px 20px;
                flex: 1;
                display: flex;
                flex-direction: column;
            }

            .article-card-category {
                font-family: var(--mono);
                font-size: 10px;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                font-weight: 600;
                margin-bottom: 12px;
            }

            .article-card-title {
                font-family: var(--serif);
                font-size: 19px;
                line-height: 1.25;
                letter-spacing: -0.015em;
                color: var(--ink);
                margin-bottom: 10px;
                flex: 1;
                transition: color 0.15s;
            }

            .article-card:hover .article-card-title {
                color: var(--accent);
            }

            .article-card-excerpt {
                font-size: 13px;
                color: var(--ink-3);
                line-height: 1.6;
                margin-bottom: 20px;
            }

            .article-card-footer {
                padding: 14px 24px;
                border-top: 1px solid var(--paper-3);
                display: flex;
                align-items: center;
                justify-content: space-between;
                background: var(--paper);
            }

            .article-card-meta {
                font-family: var(--mono);
                font-size: 11px;
                color: var(--ink-3);
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .article-card-read {
                font-size: 12px;
                color: var(--ink-2);
                font-weight: 500;
                display: flex;
                align-items: center;
                gap: 4px;
                transition: gap 0.18s;
            }

            .article-card:hover .article-card-read {
                gap: 8px;
            }

            /* ── Article Card — Wide (spans 2 cols) ── */
            .article-card.wide {
                grid-column: span 2;
                flex-direction: row;
            }

            .article-card.wide .article-card-accent {
                width: 3px;
                height: auto;
                flex-shrink: 0;
            }

            .article-card.wide .article-card-body {
                padding: 28px;
            }
            .article-card.wide .article-card-title {
                font-size: 22px;
            }
            .article-card.wide .article-card-footer {
                border-top: none;
                border-left: 1px solid var(--paper-3);
                flex-direction: column;
                align-items: flex-start;
                gap: 12px;
                min-width: 160px;
                justify-content: center;
            }

            /* ══ TOPIC FILTER ══ */
            .topic-filter {
                display: flex;
                align-items: center;
                gap: 8px;
                flex-wrap: wrap;
            }

            .topic-btn {
                padding: 6px 14px;
                border-radius: 20px;
                border: 1px solid var(--border);
                background: var(--white);
                font-size: 12.5px;
                font-family: var(--sans);
                color: var(--ink-2);
                cursor: pointer;
                transition: all 0.15s;
                font-weight: 400;
            }

            .topic-btn:hover {
                border-color: var(--ink-3);
                color: var(--ink);
                background: var(--paper-2);
            }
            .topic-btn.active {
                background: var(--ink);
                color: var(--white);
                border-color: var(--ink);
                font-weight: 500;
            }

            /* ══ NEWSLETTER ══ */
            .newsletter-section {
                background: var(--ink);
                padding: 64px 40px;
                position: relative;
                overflow: hidden;
            }

            .newsletter-section::before {
                content: "";
                position: absolute;
                inset: 0;
                background-image: radial-gradient(
                    circle,
                    rgba(255, 255, 255, 0.03) 1px,
                    transparent 1px
                );
                background-size: 28px 28px;
                pointer-events: none;
            }

            .newsletter-inner {
                max-width: 1160px;
                margin: 0 auto;
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 80px;
                align-items: center;
                position: relative;
                z-index: 1;
            }

            .newsletter-title {
                font-family: var(--serif);
                font-size: clamp(28px, 3.5vw, 42px);
                color: var(--paper);
                line-height: 1.1;
                letter-spacing: -0.02em;
                margin-bottom: 12px;
            }

            .newsletter-title em {
                font-style: italic;
                color: #f0c060;
            }

            .newsletter-desc {
                font-size: 14px;
                color: #6a6a62;
                line-height: 1.65;
                font-weight: 300;
            }

            .newsletter-form {
                display: flex;
                flex-direction: column;
                gap: 12px;
            }

            .newsletter-input-row {
                display: flex;
                gap: 8px;
            }

            .newsletter-input {
                flex: 1;
                padding: 12px 16px;
                background: #0a0a08;
                border: 1px solid #2a2a27;
                border-radius: var(--radius);
                font-size: 14px;
                font-family: var(--sans);
                color: var(--paper);
                outline: none;
                transition: border-color 0.15s;
            }

            .newsletter-input::placeholder {
                color: #4a4a42;
            }
            .newsletter-input:focus {
                border-color: #5a5a52;
            }

            .newsletter-submit {
                padding: 12px 24px;
                background: var(--paper);
                color: var(--ink);
                border: none;
                border-radius: var(--radius);
                font-size: 13.5px;
                font-weight: 600;
                cursor: pointer;
                font-family: var(--sans);
                transition: all 0.2s;
                white-space: nowrap;
            }

            .newsletter-submit:hover {
                background: var(--white);
                transform: translateY(-1px);
            }

            .newsletter-note {
                font-family: var(--mono);
                font-size: 10.5px;
                color: #3a3a35;
                letter-spacing: 0.04em;
            }

            /* ══ TOPICS ROW ══ */
            .topics-section {
                background: var(--white);
                border-top: 1px solid var(--border);
                border-bottom: 1px solid var(--border);
                padding: 0;
            }

            .topics-row {
                max-width: 1160px;
                margin: 0 auto;
                display: grid;
                grid-template-columns: repeat(4, 1fr);
            }

            .topic-cell {
                padding: 28px 32px;
                border-right: 1px solid var(--border);
                text-decoration: none;
                color: inherit;
                transition: background 0.15s;
                display: flex;
                flex-direction: column;
                gap: 6px;
            }

            .topic-cell:last-child {
                border-right: none;
            }
            .topic-cell:hover {
                background: var(--paper);
            }

            .topic-cell-icon {
                font-size: 20px;
                margin-bottom: 8px;
            }
            .topic-cell-name {
                font-size: 13.5px;
                font-weight: 600;
                color: var(--ink);
                letter-spacing: -0.01em;
            }
            .topic-cell-count {
                font-family: var(--mono);
                font-size: 10.5px;
                color: var(--ink-3);
            }

            /* ══ COMING SOON ARTICLES ══ */
            .coming-soon-grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: var(--col-gap);
                margin-top: 40px;
            }

            .coming-card {
                border: 1px dashed var(--border);
                border-radius: var(--radius-lg);
                padding: 24px;
                display: flex;
                flex-direction: column;
                gap: 10px;
                background: transparent;
                transition: background 0.15s;
            }

            .coming-card:hover {
                background: var(--white);
            }

            .coming-cat {
                font-family: var(--mono);
                font-size: 10px;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                color: #c8432a;
            }

            .coming-title {
                font-family: var(--serif);
                font-size: 17px;
                color: var(--ink-2);
                line-height: 1.3;
                letter-spacing: -0.01em;
            }

            .coming-badge {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                font-family: var(--mono);
                font-size: 10px;
                letter-spacing: 0.07em;
                text-transform: uppercase;
                color: var(--ink-3);
                margin-top: auto;
            }

            .coming-badge::before {
                content: "";
                width: 5px;
                height: 5px;
                border-radius: 50%;
                background: var(--paper-3);
                flex-shrink: 0;
            }

            /* ══ ANIMATIONS ══ */
            @keyframes fadeUp {
                from {
                    opacity: 0;
                    transform: translateY(16px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .article-card {
                animation: fadeUp 0.4s ease both;
            }

            .article-card:nth-child(1) {
                animation-delay: 0.05s;
            }
            .article-card:nth-child(2) {
                animation-delay: 0.1s;
            }
            .article-card:nth-child(3) {
                animation-delay: 0.15s;
            }
            .article-card:nth-child(4) {
                animation-delay: 0.2s;
            }

            /* ══ RESPONSIVE ══ */
            /* ══ FULLY RESPONSIVE ══ */
            @media (max-width: 1024px) {
                .articles-grid {
                    grid-template-columns: 1fr 1fr;
                }
                .article-card.wide {
                    grid-column: span 2;
                }
                .newsletter-inner {
                    grid-template-columns: 1fr;
                    gap: 36px;
                }
                .topics-row {
                    grid-template-columns: 1fr 1fr;
                }
                .coming-soon-grid {
                    grid-template-columns: 1fr 1fr;
                }
            }

            @media (max-width: 900px) {
                .hero-headline-wrap {
                    grid-template-columns: 1fr;
                    gap: 20px;
                }
                .hero-desc {
                    max-width: 100%;
                }
                .hero-actions {
                    margin-top: 16px;
                }
                .hero-bottom {
                    flex-direction: column;
                    gap: 20px;
                }
                .hero-featured-link-inner {
                    max-width: 100%;
                }
            }

            @media (max-width: 768px) {
                .hero-inner {
                    padding: 32px 20px 30px;
                    gap: 28px;
                }
                .hero-title {
                    font-size: clamp(36px, 8.5vw, 52px);
                }
                .hero-desc {
                    font-size: 15px;
                    color: #a7a49c;
                }
                .hero-stats {
                    gap: 16px;
                }
                .hero-stat-num {
                    font-size: 20px;
                }
                .hero-featured-link-inner {
                    padding: 16px 18px;
                }
                .bg-orb {
                    width: 420px;
                    height: 420px;
                    right: -160px;
                    top: -160px;
                    opacity: 0.7;
                }
                .bg-line-2 {
                    opacity: 0.55;
                }

                .articles-section {
                    padding: 36px 20px 56px;
                }
                .articles-grid {
                    grid-template-columns: 1fr;
                }
                .article-card.wide {
                    grid-column: span 1;
                    flex-direction: column;
                }
                .article-card.wide .article-card-accent {
                    width: 100%;
                    height: 3px;
                }
                .article-card.wide .article-card-footer {
                    border-left: none;
                    border-top: 1px solid var(--paper-3);
                    flex-direction: row;
                    min-width: auto;
                    padding: 14px 24px;
                }

                .topics-row {
                    grid-template-columns: 1fr 1fr;
                }
                .topic-cell {
                    padding: 20px;
                }

                .coming-soon-grid {
                    grid-template-columns: 1fr;
                }
                .newsletter-section {
                    padding: 40px 20px;
                }
                .newsletter-input-row {
                    flex-direction: column;
                }
                .newsletter-submit {
                    width: 100%;
                    padding: 13px;
                }

                .section-rule {
                    padding: 0 20px;
                }

                .footer-inner {
                    grid-template-columns: 1fr 1fr;
                    gap: 32px;
                }
            }

            @media (max-width: 480px) {
                .hero-issue {
                    font-size: 10px;
                }
                .hero-headline-wrap {
                    gap: 14px;
                }
                .hero-actions {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 10px;
                }
                .hero-action-primary {
                    width: 100%;
                    justify-content: center;
                }
                .hero-action-secondary {
                    font-size: 10px;
                }
                .hero-stats {
                    flex-wrap: wrap;
                    gap: 12px;
                }
                .hero-stat-divider {
                    display: none;
                }
                .bg-line-1,
                .bg-line-2 {
                    display: none;
                }
                .bg-line-3 {
                    opacity: 0.45;
                }
                .bg-orb {
                    width: 320px;
                    height: 320px;
                    right: -180px;
                    top: -160px;
                    opacity: 0.45;
                }
                .topics-row {
                    grid-template-columns: 1fr;
                }
                .topic-cell {
                    border-right: none;
                    border-bottom: 1px solid var(--border);
                }
                .topic-cell:last-child {
                    border-bottom: none;
                }
                .footer-inner {
                    grid-template-columns: 1fr;
                }
                .topic-filter {
                    gap: 6px;
                }
                .topic-btn {
                    font-size: 11.5px;
                    padding: 5px 11px;
                }
            }
        </style>
    </head>

    <body>
