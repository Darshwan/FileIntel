        <script>
            // ── Topic filter ──
            const filterBtns = document.querySelectorAll(".topic-btn");
            const articleCards = document.querySelectorAll(
                ".article-card[data-topic]",
            );

            filterBtns.forEach((btn) => {
                btn.addEventListener("click", () => {
                    filterBtns.forEach((b) => b.classList.remove("active"));
                    btn.classList.add("active");

                    const filter = btn.dataset.filter;

                    articleCards.forEach((card) => {
                        const match =
                            filter === "all" || card.dataset.topic === filter;
                        card.style.display = match ? "" : "none";
                        // Reset wide on single column
                        if (match && filter !== "all") {
                            card.classList.remove("wide");
                        }
                    });
                });
            });

            // ── Newsletter subscribe ──
            function handleSubscribe(btn) {
                const input = btn.previousElementSibling;
                const email = input.value.trim();

                if (!email || !email.includes("@")) {
                    input.style.borderColor = "var(--accent)";
                    input.focus();
                    setTimeout(() => (input.style.borderColor = ""), 2000);
                    return;
                }

                btn.textContent = "✓ Subscribed";
                btn.style.background = "#e8f2ec";
                btn.style.color = "var(--green)";
                btn.disabled = true;
                input.disabled = true;
                input.value = email;

                // In production: POST to your email list endpoint
                // fetch('/api/subscribe', { method: 'POST', body: JSON.stringify({ email }) });
            }
        </script>
