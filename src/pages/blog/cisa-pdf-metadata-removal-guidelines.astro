  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --ink: #0f0f0d; --ink-2: #3a3a35; --ink-3: #7a7a72;
      --paper: #f5f3ee; --paper-2: #eceae3; --paper-3: #e2dfd6;
      --accent: #c8432a; --green: #2a6b4a; --green-light: #e8f2ec;
      --green-border: #b8ddc8; --amber: #b06820; --amber-light: #fef3e2;
      --border: #d4d1c8; --white: #fafaf8;
      --federal: #1a3a5c; --federal-light: #e8f0f8; --federal-border: #b8cfe0;
      --serif: 'Instrument Serif', Georgia, serif;
      --mono: 'DM Mono', 'Courier New', monospace;
      --sans: 'Geist', system-ui, sans-serif;
      --radius: 4px; --radius-lg: 8px;
    }
    body { font-family: var(--sans); background: var(--paper); color: var(--ink); line-height: 1.6; }
    #reading-progress { position: fixed; top: 0; left: 0; width: 0%; height: 3px; background: var(--accent); z-index: 9999; transition: width 0.08s linear; border-radius: 0 2px 2px 0; pointer-events: none; }

    /* NAV */
    .nav { background: var(--white); border-bottom: 1px solid var(--border); padding: 0 40px; position: sticky; top: 0; z-index: 100; }
    .nav-inner { max-width: 1160px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; height: 56px; }
    .nav-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
    .nav-logo-mark { width: 28px; height: 28px; background: var(--ink); border-radius: var(--radius); display: flex; align-items: center; justify-content: center; font-family: var(--mono); font-size: 12px; font-weight: 700; color: var(--paper); }
    .nav-logo-text { font-size: 14px; font-weight: 600; color: var(--ink); line-height: 1.1; }
    .nav-logo-sub { font-family: var(--mono); font-size: 9px; color: var(--ink-3); letter-spacing: 0.05em; text-transform: uppercase; }
    .nav-links { display: flex; align-items: center; gap: 28px; list-style: none; }
    .nav-links a { font-size: 13px; color: var(--ink-2); text-decoration: none; font-weight: 500; transition: color 0.15s; }
    .nav-links a:hover { color: var(--ink); }
    .nav-badge { font-family: var(--mono); font-size: 10px; background: var(--green-light); color: var(--green); border: 1px solid var(--green-border); padding: 3px 8px; border-radius: 3px; }
    @media (max-width: 700px) { .nav-links { display: none; } .nav { padding: 0 20px; } }

    /* BREADCRUMB */
    .blog-nav-bar { background: var(--white); border-bottom: 1px solid var(--border); padding: 10px 40px; }
    .blog-nav-inner { max-width: 1160px; margin: 0 auto; display: flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 11px; color: var(--ink-3); }
    .blog-nav-inner a { color: var(--ink-3); text-decoration: none; }
    .blog-nav-inner a:hover { color: var(--ink); }
    @media (max-width: 700px) { .blog-nav-bar { padding: 10px 20px; } }

    /* HERO */
    .article-hero { background: var(--ink); padding: 0; position: relative; overflow: hidden; min-height: 420px; display: flex; align-items: flex-end; }
    .hero-svg { position: absolute; inset: 0; width: 100%; height: 100%; }
    .hero-content { position: relative; z-index: 2; padding: 60px 40px 56px; max-width: 1160px; margin: 0 auto; width: 100%; }
    .article-category { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); margin-bottom: 18px; }
    .article-title { font-family: var(--serif); font-size: clamp(26px, 3.8vw, 48px); color: var(--paper); line-height: 1.08; letter-spacing: -0.025em; margin-bottom: 20px; max-width: 840px; }
    .article-subtitle { font-size: 16px; color: #7a7a72; font-weight: 300; line-height: 1.65; max-width: 600px; }
    .hero-meta { display: flex; align-items: center; gap: 20px; margin-top: 28px; font-family: var(--mono); font-size: 10.5px; color: #4a4a42; flex-wrap: wrap; }
    .hero-authority-badges { display: flex; gap: 8px; margin-top: 16px; flex-wrap: wrap; }
    .auth-badge { font-family: var(--mono); font-size: 10px; padding: 3px 10px; border-radius: 3px; border: 1px solid rgba(255,255,255,0.1); color: #5a5a52; }
    .auth-badge.federal { border-color: rgba(100,160,220,0.3); color: #88b8d8; background: rgba(100,160,220,0.08); }
    @media (max-width: 700px) { .hero-content { padding: 40px 20px 36px; } }

    /* LAYOUT */
    .article-layout { max-width: 1160px; margin: 0 auto; padding: 56px 40px 80px; display: grid; grid-template-columns: 1fr 300px; gap: 64px; align-items: start; }
    .prose { max-width: 680px; }
    .article-sidebar { position: sticky; top: 80px; align-self: start; display: flex; flex-direction: column; gap: 16px; }
    @media (max-width: 960px) { .article-layout { grid-template-columns: 1fr; gap: 40px; padding: 32px 20px 60px; } .article-sidebar { position: static; } .prose { max-width: 100%; } }

    /* PROSE */
    .prose h2 { font-family: var(--serif); font-size: clamp(22px, 2.8vw, 30px); letter-spacing: -0.02em; color: var(--ink); margin: 52px 0 18px; padding-bottom: 12px; border-bottom: 1px solid var(--paper-3); }
    .prose h3 { font-size: 18px; font-weight: 600; color: var(--ink); margin: 36px 0 12px; letter-spacing: -0.015em; }
    .prose p { font-size: 16px; color: var(--ink-2); line-height: 1.8; margin-bottom: 22px; }
    .prose ul, .prose ol { padding-left: 22px; margin-bottom: 22px; }
    .prose li { font-size: 15.5px; color: var(--ink-2); line-height: 1.75; margin-bottom: 8px; }
    .prose a { color: var(--accent); text-decoration: none; border-bottom: 1px solid rgba(200,67,42,0.3); transition: border-color 0.15s; }
    .prose a:hover { border-bottom-color: var(--accent); }
    .prose strong { color: var(--ink); font-weight: 600; }
    .prose code { font-family: var(--mono); font-size: 13px; background: var(--paper-2); border: 1px solid var(--border); padding: 1px 6px; border-radius: 3px; color: var(--ink); }

    /* DIRECT ANSWER — Copilot extraction optimised */
    .direct-answer { background: linear-gradient(135deg, #0d1a2a 0%, #1a2a3a 100%); border-radius: var(--radius-lg); padding: 24px 28px; margin: 0 0 36px; position: relative; overflow: hidden; border: 1px solid rgba(100,160,220,0.15); }
    .direct-answer::before { content: ''; position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: linear-gradient(to bottom, #4a90d0, #2a5a8a); border-radius: var(--radius) 0 0 var(--radius); }
    .da-eyebrow { font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.14em; text-transform: uppercase; color: #88b8d8; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; padding-left: 12px; }
    .direct-answer p { font-size: 15px; color: #c8d8e8; line-height: 1.75; margin: 0; padding-left: 12px; position: relative; z-index: 1; }
    .direct-answer p strong { color: #e8f0f8; }
    .direct-answer p code { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.15); color: #88ccaa; }

    /* CISA CITATION BLOCK */
    .cisa-citation { background: var(--federal-light); border: 1px solid var(--federal-border); border-radius: var(--radius-lg); padding: 20px 24px; margin: 28px 0; position: relative; }
    .cisa-citation::before { content: 'PRIMARY SOURCE'; position: absolute; top: -1px; left: 16px; background: var(--federal); color: white; font-family: var(--mono); font-size: 9px; letter-spacing: 0.1em; padding: 2px 8px; border-radius: 0 0 4px 4px; }
    .cisa-source { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--federal); margin: 12px 0 8px; font-weight: 700; }
    .cisa-quote-text { font-size: 14px; color: #1a2a3a; line-height: 1.75; border-left: 3px solid var(--federal); padding-left: 14px; font-style: italic; }
    .cisa-relevance { font-size: 13px; color: var(--ink-3); margin-top: 10px; line-height: 1.6; }
    .cisa-relevance strong { color: var(--ink-2); }
    .cisa-url { font-family: var(--mono); font-size: 10.5px; color: var(--federal); margin-top: 8px; display: block; }
    .cisa-url a { color: var(--federal); border-bottom-color: rgba(26,58,92,0.3); }

    /* RISK TABLE */
    .table-wrapper { overflow-x: auto; margin: 24px 0; }
    .data-table { width: 100%; border-collapse: collapse; font-size: 13.5px; border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; }
    .data-table th { padding: 11px 16px; text-align: left; font-size: 10.5px; letter-spacing: 0.07em; text-transform: uppercase; color: var(--ink-3); background: var(--paper-2); font-family: var(--mono); border-bottom: 1px solid var(--border); }
    .data-table th.dark { background: var(--ink); color: var(--paper); }
    .data-table th.federal { background: var(--federal); color: white; }
    .data-table td { padding: 11px 16px; border-bottom: 1px solid var(--paper-3); color: var(--ink-2); vertical-align: top; line-height: 1.55; }
    .data-table tr:last-child td { border-bottom: none; }
    .data-table tr:nth-child(even) td { background: var(--paper); }
    .risk-pill { display: inline-block; font-family: var(--mono); font-size: 10px; padding: 2px 7px; border-radius: 3px; font-weight: 700; }
    .rp-critical { background: #fdecea; color: var(--accent); }
    .rp-high { background: #fff0e8; color: #c05820; }
    .rp-medium { background: var(--amber-light); color: var(--amber); }
    .rp-low { background: var(--green-light); color: var(--green); }

    /* COMPLIANCE METHOD CARDS */
    .method-stack { display: flex; flex-direction: column; gap: 12px; margin: 24px 0; }
    .method-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; }
    .method-card.recommended { border-color: var(--green); }
    .method-header { padding: 14px 18px; border-bottom: 1px solid var(--paper-3); display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .method-left { display: flex; align-items: center; gap: 12px; }
    .method-num { font-family: var(--mono); font-size: 11px; font-weight: 700; background: var(--paper-2); border: 1px solid var(--border); border-radius: 3px; padding: 2px 9px; color: var(--ink-3); flex-shrink: 0; }
    .method-name { font-size: 14.5px; font-weight: 700; color: var(--ink); }
    .method-compliance { font-family: var(--mono); font-size: 10px; padding: 2px 8px; border-radius: 3px; font-weight: 600; flex-shrink: 0; }
    .mc-full { background: var(--green-light); color: var(--green); border: 1px solid var(--green-border); }
    .mc-partial { background: var(--amber-light); color: var(--amber); }
    .mc-fail { background: #fdecea; color: var(--accent); }
    .method-body { padding: 14px 18px; font-size: 14px; color: var(--ink-2); line-height: 1.7; }
    .method-body p { margin-bottom: 8px; }
    .method-body p:last-child { margin-bottom: 0; }

    /* CODE BLOCK */
    .code-block { background: #060605; border-radius: var(--radius-lg); padding: 18px 22px; margin: 16px 0; font-family: var(--mono); font-size: 12.5px; color: #7acc99; line-height: 1.9; overflow-x: auto; position: relative; border: 1px solid #1a1a17; }
    .c-comment { color: #3a5a42; }
    .c-cmd { color: #88ccaa; }
    .c-arg { color: #f0c060; }
    .c-prompt { color: #4a6a52; }
    .c-ok { color: #5a9a72; }
    .c-warn { color: #c8432a; }
    .copy-btn { position: absolute; top: 10px; right: 12px; background: #1a1a17; border: 1px solid #2a2a27; border-radius: 3px; padding: 3px 9px; font-size: 10px; color: #5a5a52; cursor: pointer; font-family: var(--mono); transition: all 0.15s; }
    .copy-btn:hover { background: #222; color: #9a9a92; }

    /* CALLOUT */
    .callout { border-left: 3px solid var(--accent); background: var(--white); border-radius: 0 var(--radius-lg) var(--radius-lg) 0; padding: 18px 22px; margin: 32px 0; box-shadow: 0 1px 3px rgba(15,15,13,0.06); }
    .callout.green { border-left-color: var(--green); }
    .callout.amber { border-left-color: var(--amber); }
    .callout.federal { border-left-color: var(--federal); background: var(--federal-light); }
    .callout-label { font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; margin-bottom: 8px; color: var(--accent); }
    .callout.green .callout-label { color: var(--green); }
    .callout.amber .callout-label { color: var(--amber); }
    .callout.federal .callout-label { color: var(--federal); }
    .callout p { margin: 0; font-size: 14.5px; color: var(--ink-2); line-height: 1.65; }
    .callout p + p { margin-top: 8px; }

    /* VERIFICATION STEPS */
