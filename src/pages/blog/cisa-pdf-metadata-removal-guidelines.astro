    step.classList.toggle('checked');
    const num = step.querySelector('.vs-num');
    num.textContent = step.classList.contains('checked') ? '\u2713' : num.dataset.num;
  }
  document.querySelectorAll('.verify-step').forEach((step, i) => {
    step.querySelector('.vs-num').dataset.num = i + 1;
    step.removeAttribute('onclick');
    step.addEventListener('click', () => toggleVerify(step));
  });

  // Copy buttons — event listener based
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const block = btn.parentElement;
      const lines = Array.from(block.childNodes)
        .filter(n => n.nodeType === Node.TEXT_NODE || (n.tagName && n.className !== 'copy-btn'))
        .map(n => n.textContent).join('').trim();
      navigator.clipboard.writeText(lines).then(() => {
        btn.textContent = '\u2713 Copied';
        setTimeout(() => btn.textContent = 'Copy', 2000);
      });
    });
  });

  // Active TOC
  const sections = ['what-cisa-says','high-risk-fields','removal-methods','verification','limitations'];
  const tocLinks = document.querySelectorAll('.toc-link');
  window.addEventListener('scroll', () => {
    let current = 0;
    sections.forEach((id, i) => {
      const el = document.getElementById(id);
      if (el && window.scrollY >= el.offsetTop - 140) current = i;
    });
    tocLinks.forEach((l, i) => l.classList.toggle('active', i === current));
  }, { passive: true });
</script>

</body>
</html>
