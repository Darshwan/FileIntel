                    <div class="faq-item" onclick="toggleFaq(this)">
                        <button class="faq-question"
                            >What metadata does a freelance PDF proposal
                            contain?
                            <svg
                                width="16"
                                height="16"
                                viewBox="0 0 16 16"
                                fill="none"
