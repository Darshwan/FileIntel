                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"></path></svg
                            >
                        </button>
                        <div class="faq-answer">
                            <div class="faq-answer-inner">
                                Template reuse is the most common source of
                                metadata problems for freelancers. If the
                                Subject or Keywords field from a previous client
                                is still in your template, the new client can
                                see it. The ModDate also reveals the document's
                                history &mdash; when it was originally created
                                and how recently adapted.
                            </div>
                        </div>
