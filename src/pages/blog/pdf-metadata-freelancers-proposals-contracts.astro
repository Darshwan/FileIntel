                                    stroke-linejoin="round"></path></svg
                            >
                        </button>
                        <div class="faq-answer">
                            <div class="faq-answer-inner">
                                Yes, easily. In Adobe Acrobat Reader: File
                                &rarr; Properties &rarr; Description. On macOS:
                                right-click &rarr; Get Info &rarr; More Info. On
                                Windows: right-click &rarr; Properties &rarr;
                                Details tab. No technical knowledge required.
                                Three clicks from opening the file.
                            </div>
                        </div>
