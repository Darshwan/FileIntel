        <style>
            *,
            *::before,
            *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }
            :root {
                --ink: #0f0f0d;
                --ink-2: #3a3a35;
                --ink-3: #7a7a72;
                --paper: #f5f3ee;
                --paper-2: #eceae3;
                --paper-3: #e2dfd6;
                --accent: #c8432a;
                --green: #2a6b4a;
                --green-light: #e8f2ec;
                --green-border: #b8ddc8;
                --amber: #b06820;
                --amber-light: #fef3e2;
                --border: #d4d1c8;
                --white: #fafaf8;
                --serif: "Instrument Serif", Georgia, serif;
                --mono: "DM Mono", "Courier New", monospace;
                --sans: "Geist", system-ui, sans-serif;
                --radius: 4px;
                --radius-lg: 8px;
            }
            body {
                font-family: var(--sans);
                background: var(--paper);
                color: var(--ink);
                line-height: 1.6;
            }

            .nav {
                background: var(--white);
                border-bottom: 1px solid var(--border);
                padding: 0 40px;
                position: sticky;
                top: 0;
                z-index: 100;
            }
            .nav-inner {
                max-width: 1160px;
                margin: 0 auto;
                display: flex;
                align-items: center;
                justify-content: space-between;
                height: 56px;
            }
            .nav-logo {
                display: flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
            }
            .nav-logo-mark {
                width: 28px;
                height: 28px;
                background: var(--ink);
                border-radius: var(--radius);
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: var(--mono);
                font-size: 12px;
                font-weight: 700;
                color: var(--paper);
            }
            .nav-logo-text {
                font-size: 14px;
                font-weight: 600;
                color: var(--ink);
                line-height: 1.1;
            }
            .nav-logo-sub {
                font-family: var(--mono);
                font-size: 9px;
                color: var(--ink-3);
                letter-spacing: 0.05em;
                text-transform: uppercase;
            }
            .nav-links {
                display: flex;
                align-items: center;
                gap: 28px;
                list-style: none;
            }
            .nav-links a {
                font-size: 13px;
                color: var(--ink-2);
                text-decoration: none;
                font-weight: 500;
                transition: color 0.15s;
            }
            .nav-links a:hover {
                color: var(--ink);
            }
            .nav-badge {
                font-family: var(--mono);
                font-size: 10px;
                background: var(--green-light);
                color: var(--green);
                border: 1px solid var(--green-border);
                padding: 3px 8px;
                border-radius: 3px;
            }
            @media (max-width: 700px) {
                .nav-links {
                    display: none;
                }
                .nav {
                    padding: 0 20px;
                }
            }

            .blog-nav-bar {
                background: var(--white);
                border-bottom: 1px solid var(--border);
                padding: 10px 40px;
            }
            .blog-nav-inner {
                max-width: 1160px;
                margin: 0 auto;
                display: flex;
                align-items: center;
                gap: 8px;
                font-family: var(--mono);
                font-size: 11px;
                color: var(--ink-3);
            }
            .blog-nav-inner a {
                color: var(--ink-3);
                text-decoration: none;
            }
            .blog-nav-inner a:hover {
                color: var(--ink);
            }
            @media (max-width: 700px) {
                .blog-nav-bar {
                    padding: 10px 20px;
                }
            }

            .article-hero {
                background: var(--ink);
                padding: 64px 40px 56px;
                position: relative;
                overflow: hidden;
            }
            .article-hero::before {
                content: "";
                position: absolute;
                inset: 0;
                background-image:
                    linear-gradient(
                        rgba(255, 255, 255, 0.025) 1px,
                        transparent 1px
                    ),
                    linear-gradient(
                        90deg,
                        rgba(255, 255, 255, 0.025) 1px,
                        transparent 1px
                    );
                background-size: 48px 48px;
                pointer-events: none;
            }
            .article-hero-inner {
                max-width: 1160px;
                margin: 0 auto;
                position: relative;
                z-index: 1;
            }
            .article-category {
                font-family: var(--mono);
                font-size: 10.5px;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                color: var(--accent);
                margin-bottom: 18px;
            }
            .article-title {
                font-family: var(--serif);
                font-size: clamp(30px, 4.5vw, 52px);
                color: var(--paper);
                line-height: 1.08;
                letter-spacing: -0.025em;
                margin-bottom: 20px;
                max-width: 820px;
            }
            .article-subtitle {
                font-size: 16px;
                color: #7a7a72;
                font-weight: 300;
                line-height: 1.65;
                max-width: 620px;
            }
            .hero-meta {
                display: flex;
                align-items: center;
                gap: 20px;
                margin-top: 32px;
                font-family: var(--mono);
                font-size: 10.5px;
                color: #4a4a42;
                flex-wrap: wrap;
            }
            @media (max-width: 700px) {
                .article-hero {
                    padding: 40px 20px 36px;
                }
            }

            .article-layout {
                max-width: 1160px;
                margin: 0 auto;
                padding: 56px 40px 80px;
                display: grid;
                grid-template-columns: 1fr 300px;
                gap: 64px;
                align-items: start;
            }
            .prose {
                max-width: 680px;
            }
            .article-sidebar {
                position: sticky;
                top: calc(56px + 24px);
                display: flex;
                flex-direction: column;
                gap: 16px;
            }
            @media (max-width: 960px) {
                .article-layout {
                    grid-template-columns: 1fr;
                    gap: 40px;
                    padding: 32px 20px 60px;
                }
                .article-sidebar {
                    position: static;
                }
                .prose {
                    max-width: 100%;
                }
            }

            .prose h2 {
                font-family: var(--serif);
                font-size: clamp(22px, 2.8vw, 30px);
                letter-spacing: -0.02em;
                color: var(--ink);
                margin: 52px 0 18px;
                padding-bottom: 12px;
                border-bottom: 1px solid var(--paper-3);
            }
            .prose h3 {
                font-size: 18px;
                font-weight: 600;
                color: var(--ink);
                margin: 36px 0 12px;
                letter-spacing: -0.015em;
            }
            .prose p {
                font-size: 16px;
                color: var(--ink-2);
                line-height: 1.8;
                margin-bottom: 22px;
            }
            .prose ul,
            .prose ol {
                padding-left: 22px;
                margin-bottom: 22px;
            }
            .prose li {
                font-size: 15.5px;
                color: var(--ink-2);
                line-height: 1.75;
                margin-bottom: 8px;
            }
            .prose a {
                color: var(--accent);
                text-decoration: none;
                border-bottom: 1px solid rgba(200, 67, 42, 0.3);
                transition: border-color 0.15s;
            }
            .prose a:hover {
                border-bottom-color: var(--accent);
            }
            .prose strong {
                color: var(--ink);
                font-weight: 600;
            }
            .prose code {
                font-family: var(--mono);
                font-size: 13px;
                background: var(--paper-2);
                border: 1px solid var(--border);
                padding: 1px 6px;
                border-radius: 3px;
                color: var(--ink);
            }

            .callout {
                border-left: 3px solid var(--accent);
                background: var(--white);
                border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
                padding: 18px 22px;
                margin: 32px 0;
                box-shadow: 0 1px 3px rgba(15, 15, 13, 0.08);
            }
            .callout.green {
                border-left-color: var(--green);
            }
            .callout.amber {
                border-left-color: var(--amber);
            }
            .callout-label {
                font-family: var(--mono);
                font-size: 10px;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                font-weight: 700;
                margin-bottom: 8px;
                color: var(--accent);
            }
            .callout.green .callout-label {
                color: var(--green);
            }
            .callout.amber .callout-label {
                color: var(--amber);
            }
            .callout p {
                margin: 0;
                font-size: 14.5px;
                color: var(--ink-2);
                line-height: 1.65;
            }

            .step-list {
                display: flex;
                flex-direction: column;
                gap: 10px;
                margin: 24px 0;
            }
            .step-box {
                display: flex;
                gap: 18px;
                align-items: flex-start;
                padding: 16px 20px;
                background: var(--white);
                border: 1px solid var(--border);
                border-radius: var(--radius-lg);
                transition: box-shadow 0.15s;
            }
            .step-box:hover {
                box-shadow: 0 4px 16px rgba(15, 15, 13, 0.1);
            }
            .step-num {
                width: 28px;
                height: 28px;
                border-radius: 50%;
                background: var(--paper-2);
                border: 1px solid var(--border);
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: var(--mono);
                font-size: 12px;
                font-weight: 600;
                color: var(--ink-2);
                flex-shrink: 0;
            }
            .step-content h4 {
                font-size: 14.5px;
                font-weight: 600;
                color: var(--ink);
                margin-bottom: 5px;
            }
            .step-content p {
                font-size: 13.5px;
                color: var(--ink-3);
                margin: 0;
                line-height: 1.6;
            }

            .table-wrapper {
                overflow-x: auto;
                margin: 24px 0;
            }
            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 13.5px;
                border: 1px solid var(--border);
                border-radius: var(--radius-lg);
                overflow: hidden;
            }
            .data-table th {
                padding: 11px 16px;
                text-align: left;
                font-size: 10.5px;
                letter-spacing: 0.07em;
                text-transform: uppercase;
                color: var(--ink-3);
                background: var(--paper-2);
                font-family: var(--mono);
                border-bottom: 1px solid var(--border);
            }
            .data-table td {
                padding: 11px 16px;
                border-bottom: 1px solid var(--paper-3);
                color: var(--ink-2);
                vertical-align: top;
                line-height: 1.5;
            }
            .data-table tr:last-child td {
                border-bottom: none;
            }
            .data-table tr:nth-child(even) td {
                background: var(--paper);
            }
            .risk-pill {
                display: inline-block;
                font-family: var(--mono);
                font-size: 10px;
                padding: 2px 7px;
                border-radius: 3px;
                font-weight: 600;
                white-space: nowrap;
            }
            .risk-high {
                background: #fdecea;
                color: var(--accent);
            }
            .risk-medium {
                background: var(--amber-light);
                color: var(--amber);
            }
            .risk-low {
                background: var(--green-light);
                color: var(--green);
            }

            .checklist-widget {
                background: var(--white);
                border: 1px solid var(--border);
                border-radius: var(--radius-lg);
                overflow: hidden;
                margin: 28px 0;
            }
            .checklist-header {
                padding: 14px 20px;
                background: var(--paper-2);
                border-bottom: 1px solid var(--border);
                font-family: var(--mono);
                font-size: 10px;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                color: var(--ink-3);
                display: flex;
                align-items: center;
                justify-content: space-between;
            }
            .checklist-counter span {
                color: var(--green);
                font-weight: 600;
            }
            .checklist-item {
                display: flex;
                gap: 14px;
                padding: 14px 20px;
                border-bottom: 1px solid var(--paper-3);
                align-items: flex-start;
                cursor: pointer;
                transition: background 0.15s;
            }
            .checklist-item:last-child {
                border-bottom: none;
            }
            .checklist-item:hover {
                background: var(--paper);
            }
            .checklist-item.done {
                opacity: 0.65;
            }
            .checklist-item.done .check-title {
                text-decoration: line-through;
                color: var(--ink-3);
            }
            .check-box {
                width: 18px;
                height: 18px;
                border: 1.5px solid var(--border);
                border-radius: 3px;
                flex-shrink: 0;
                margin-top: 2px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 11px;
                color: white;
                font-weight: 700;
                transition: all 0.15s;
            }
            .checklist-item.done .check-box {
                background: var(--green);
                border-color: var(--green);
            }
            .checklist-item.done .check-box::before {
                content: "✓";
                color: white;
                font-size: 12px;
                font-weight: 700;
            }
            .check-content {
                flex: 1;
            }
            .check-title {
                font-size: 14px;
                font-weight: 600;
                color: var(--ink);
                margin-bottom: 3px;
                line-height: 1.4;
            }
            .check-desc {
                font-size: 12.5px;
                color: var(--ink-3);
                line-height: 1.5;
            }

            .scenario-card {
                background: var(--white);
                border: 1px solid var(--border);
                border-radius: var(--radius-lg);
                padding: 20px 22px;
                margin: 16px 0;
                position: relative;
                overflow: hidden;
            }
            .scenario-card::before {
                content: "";
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 3px;
                background: var(--accent);
            }
            .scenario-card.amber::before {
                background: var(--amber);
            }
            .scenario-card-label {
                font-family: var(--mono);
                font-size: 10px;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                color: var(--ink-3);
                margin-bottom: 8px;
            }
            .scenario-card h4 {
                font-size: 15px;
                font-weight: 600;
                color: var(--ink);
                margin-bottom: 8px;
            }
            .scenario-card p {
                font-size: 14px;
                color: var(--ink-2);
                line-height: 1.65;
                margin: 0;
            }

            .article-cta {
                background: var(--ink);
                border-radius: var(--radius-lg);
                padding: 28px 32px;
                margin: 44px 0;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 24px;
                flex-wrap: wrap;
            }
            .article-cta h3 {
                font-family: var(--serif);
                font-size: 22px;
                color: var(--paper);
                font-style: italic;
                margin-bottom: 6px;
                letter-spacing: -0.02em;
            }
            .article-cta p {
                font-size: 13.5px;
                color: #7a7a72;
                margin: 0;
            }
            .btn {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 10px 20px;
                border-radius: var(--radius);
                font-size: 13.5px;
                font-weight: 600;
                text-decoration: none;
                transition: all 0.15s;
                border: none;
                font-family: var(--sans);
            }
            .btn-light {
                background: var(--paper);
                color: var(--ink);
            }
            .btn-light:hover {
                background: #fff;
            }

            .faq-section {
                margin-top: 56px;
                border-top: 1px solid var(--paper-3);
                padding-top: 40px;
            }
            .faq-section-title {
                font-family: var(--serif);
