    .author-name a:hover { border-bottom-color: var(--ink); }
    .author-meta { font-family: var(--mono); font-size: 10.5px; color: var(--ink-3); margin-top: 2px; }
    @media (max-width: 700px) { .author-bar { padding: 12px 20px; } }

    /* LAYOUT */
    .article-layout { max-width: 1160px; margin: 0 auto; padding: 56px 40px 80px; display: grid; grid-template-columns: 1fr 300px; gap: 64px; align-items: start; }
    .prose { max-width: 680px; }
    .article-sidebar { position: sticky; top: 80px; align-self: start; display: flex; flex-direction: column; gap: 16px; }
    @media (max-width: 960px) { .article-layout { grid-template-columns: 1fr; gap: 40px; padding: 32px 20px 60px; } .article-sidebar { position: static; } .prose { max-width: 100%; } }

    /* PROSE */
    .prose h2 { font-family: var(--serif); font-size: clamp(22px, 2.8vw, 30px); letter-spacing: -0.02em; color: var(--ink); margin: 52px 0 18px; padding-bottom: 12px; border-bottom: 1px solid var(--paper-3); }
    .prose h3 { font-size: 18px; font-weight: 600; color: var(--ink); margin: 36px 0 12px; letter-spacing: -0.015em; }
    .prose p { font-size: 16px; color: var(--ink-2); line-height: 1.8; margin-bottom: 22px; }
    .prose ul, .prose ol { padding-left: 22px; margin-bottom: 22px; }
    .prose li { font-size: 15.5px; color: var(--ink-2); line-height: 1.75; margin-bottom: 8px; }
    .prose a { color: var(--accent); text-decoration: none; border-bottom: 1px solid rgba(200,67,42,0.3); transition: border-color 0.15s; }
    .prose a:hover { border-bottom-color: var(--accent); }
    .prose strong { color: var(--ink); font-weight: 600; }
    .prose code { font-family: var(--mono); font-size: 13px; background: var(--paper-2); border: 1px solid var(--border); padding: 1px 6px; border-radius: 3px; color: var(--ink); }

    /* DIRECT ANSWER */
    .direct-answer { background: var(--white); border: 2px solid var(--ink); border-radius: var(--radius-lg); padding: 20px 24px; margin: 0 0 32px; }
    .da-label { font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 10px; font-weight: 600; }
    .direct-answer p { font-size: 15.5px; color: var(--ink); line-height: 1.7; margin: 0; font-weight: 500; }

    /* PROFESSION SECTION */
    .profession-section { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; margin: 36px 0; }
    .profession-header { padding: 20px 24px; border-bottom: 1px solid var(--border); display: flex; align-items: flex-start; gap: 16px; }
    .profession-icon { font-size: 28px; flex-shrink: 0; }
    .profession-name { font-family: var(--serif); font-size: 24px; color: var(--ink); letter-spacing: -0.02em; margin-bottom: 4px; }
    .profession-sub { font-family: var(--mono); font-size: 10.5px; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.08em; }
    .profession-body { padding: 22px 24px; }
    .profession-body p { font-size: 15.5px; color: var(--ink-2); line-height: 1.8; margin-bottom: 16px; }
    .profession-body p:last-child { margin-bottom: 0; }

    /* PROFESSION ANSWER — Copilot/Bing extraction target */
    .profession-answer { background: var(--paper-2); border-radius: var(--radius); padding: 14px 18px; margin: 14px 0; border-left: 3px solid var(--border); }
    .pa-label { font-family: var(--mono); font-size: 9.5px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-3); margin-bottom: 6px; }
    .profession-answer p { font-size: 14px; color: var(--ink-2); line-height: 1.7; margin: 0; }

    /* EXIF OUTPUT */
    .exif-block { background: #0a0a08; border-radius: var(--radius-lg); padding: 16px 20px; margin: 16px 0; font-family: var(--mono); font-size: 12px; color: #7acc99; line-height: 2; overflow-x: auto; position: relative; border: 1px solid #1a1a17; }
    .exif-label { font-size: 9px; text-transform: uppercase; letter-spacing: 0.1em; color: #5a7a62; margin-bottom: 6px; padding-bottom: 6px; border-bottom: 1px solid #1a1a17; }
    .ef { color: #7acc99; }
    .ev-danger { color: #c8432a; }
    .ev-warn { color: #c8a840; }
    .ev-clean { color: #5a9a72; }
    .ef-note { color: #5a7a62; font-size: 10px; margin-left: 6px; }
    .copy-btn { position: absolute; top: 10px; right: 12px; background: #1a1a17; border: 1px solid #2a2a27; border-radius: 3px; padding: 3px 8px; font-size: 10px; color: #5a5a52; cursor: pointer; font-family: var(--mono); transition: all 0.15s; }
    .copy-btn:hover { background: #222; color: #9a9a92; }

    /* RISK MATRIX */
    .risk-matrix { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; margin: 20px 0; }
    .rm-header { padding: 12px 16px; background: var(--paper-2); border-bottom: 1px solid var(--border); font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-3); font-weight: 600; }
    .rm-row { display: grid; grid-template-columns: 140px 1fr 90px; gap: 0; border-bottom: 1px solid var(--paper-3); }
    .rm-row:last-child { border-bottom: none; }
    .rm-row.head { background: var(--paper-2); }
    .rm-cell { padding: 10px 14px; font-size: 13px; color: var(--ink-2); border-right: 1px solid var(--paper-3); line-height: 1.5; }
    .rm-cell:last-child { border-right: none; text-align: center; display: flex; align-items: center; justify-content: center; }
    .rm-cell.head { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-3); font-weight: 600; }
    .rm-cell code { font-family: var(--mono); font-size: 11px; background: var(--paper-2); border: 1px solid var(--border); padding: 1px 5px; border-radius: 3px; }
    .rp { font-family: var(--mono); font-size: 10px; padding: 2px 7px; border-radius: 3px; font-weight: 700; }
    .rp-critical { background: #fdecea; color: var(--accent); }
    .rp-high { background: #fff0e8; color: #c05820; }
    .rp-medium { background: var(--amber-light); color: var(--amber); }

    /* CALLOUT */
    .callout { border-left: 3px solid var(--accent); background: var(--white); border-radius: 0 var(--radius-lg) var(--radius-lg) 0; padding: 18px 22px; margin: 28px 0; box-shadow: 0 1px 3px rgba(15,15,13,0.06); }
    .callout.green { border-left-color: var(--green); }
    .callout.amber { border-left-color: var(--amber); }
    .callout-label { font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; margin-bottom: 8px; color: var(--accent); }
    .callout.green .callout-label { color: var(--green); }
    .callout.amber .callout-label { color: var(--amber); }
    .callout p { margin: 0; font-size: 14.5px; color: var(--ink-2); line-height: 1.65; }
    .callout p + p { margin-top: 8px; }

    /* UNIVERSAL CHECKLIST */
    .checklist-widget { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; margin: 28px 0; }
    .cw-header { padding: 14px 20px; background: var(--paper-2); border-bottom: 1px solid var(--border); font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); display: flex; justify-content: space-between; }
    .cw-counter { color: var(--green); font-weight: 600; }
    .cw-item { display: flex; gap: 14px; padding: 13px 20px; border-bottom: 1px solid var(--paper-3); align-items: flex-start; cursor: pointer; transition: background 0.15s; user-select: none; }
    .cw-item:last-child { border-bottom: none; }
    .cw-item:hover { background: var(--paper); }
    .cw-item.done { opacity: 0.6; }
    .cw-item.done .cw-title { text-decoration: line-through; color: var(--ink-3); }
    .cw-box { width: 18px; height: 18px; border: 1.5px solid var(--border); border-radius: 3px; flex-shrink: 0; margin-top: 2px; display: flex; align-items: center; justify-content: center; font-size: 11px; color: white; font-weight: 700; transition: all 0.15s; }
    .cw-item.done .cw-box { background: var(--green); border-color: var(--green); }
    .cw-content { flex: 1; }
    .cw-title { font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 3px; line-height: 1.4; }
    .cw-desc { font-size: 12.5px; color: var(--ink-3); line-height: 1.5; }

    /* TABLE */
    .table-wrapper { overflow-x: auto; margin: 24px 0; }
    .data-table { width: 100%; border-collapse: collapse; font-size: 13px; border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; }
    .data-table th { padding: 10px 14px; text-align: left; font-size: 10px; letter-spacing: 0.07em; text-transform: uppercase; color: var(--ink-3); background: var(--paper-2); font-family: var(--mono); border-bottom: 1px solid var(--border); }
    .data-table th.dark { background: var(--ink); color: var(--paper); }
    .data-table td { padding: 10px 14px; border-bottom: 1px solid var(--paper-3); color: var(--ink-2); vertical-align: top; line-height: 1.55; }
    .data-table tr:last-child td { border-bottom: none; }
    .data-table tr:nth-child(even) td { background: var(--paper); }

    /* CTA */
    .article-cta { background: var(--ink); border-radius: var(--radius-lg); padding: 28px 32px; margin: 44px 0; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
    .article-cta h3 { font-family: var(--serif); font-size: 22px; color: var(--paper); font-style: italic; margin-bottom: 6px; letter-spacing: -0.02em; }
    .article-cta p { font-size: 13.5px; color: #7a7a72; margin: 0; }
    .btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 20px; border-radius: var(--radius); font-size: 13.5px; font-weight: 600; text-decoration: none; transition: all 0.15s; font-family: var(--sans); }
    .btn-light { background: var(--paper); color: var(--ink); }
    .btn-light:hover { background: #fff; }

    /* FAQ */
    .faq-section { margin-top: 56px; border-top: 1px solid var(--paper-3); padding-top: 40px; }
