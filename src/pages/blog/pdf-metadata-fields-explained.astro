  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --ink: #0f0f0d; --ink-2: #3a3a35; --ink-3: #7a7a72;
      --paper: #f5f3ee; --paper-2: #eceae3; --paper-3: #e2dfd6;
      --accent: #c8432a; --green: #2a6b4a; --green-light: #e8f2ec;
      --green-border: #b8ddc8; --amber: #b06820; --amber-light: #fef3e2;
      --border: #d4d1c8; --white: #fafaf8;
      --serif: 'Instrument Serif', Georgia, serif;
      --mono: 'DM Mono', 'Courier New', monospace;
      --sans: 'Geist', system-ui, sans-serif;
      --radius: 4px; --radius-lg: 8px;
    }
    body { font-family: var(--sans); background: var(--paper); color: var(--ink); line-height: 1.6; }
    #reading-progress { position: fixed; top: 0; left: 0; width: 0%; height: 3px; background: var(--accent); z-index: 9999; transition: width 0.08s linear; border-radius: 0 2px 2px 0; pointer-events: none; }

    /* BREADCRUMB */
    .blog-nav-bar { background: var(--white); border-bottom: 1px solid var(--border); padding: 10px 40px; }
    .blog-nav-inner { max-width: 1160px; margin: 0 auto; display: flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 11px; color: var(--ink-3); }
    .blog-nav-inner a { color: var(--ink-3); text-decoration: none; }
    .blog-nav-inner a:hover { color: var(--ink); }
    @media (max-width: 700px) { .blog-nav-bar { padding: 10px 20px; } }

    /* HERO */
/* HERO */
.article-hero {
  background: var(--ink);
  padding: 64px 40px 56px;
  position: relative;
  overflow: hidden;
}

.article-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
  background-size: 48px 48px;
  pointer-events: none;
}

.article-hero-inner {
  max-width: 1160px;
  margin: 0 auto;
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr 380px;
  gap: 72px;
  align-items: center;
}

.article-category {
  font-family: var(--mono);
  font-size: 10.5px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 18px;
}

.article-title {
  font-family: var(--serif);
  font-size: clamp(28px, 4vw, 50px);
  color: var(--paper);
  line-height: 1.08;
  letter-spacing: -0.025em;
  margin-bottom: 18px;
  max-width: 780px;
}

.article-subtitle {
  font-size: 16px;
  color: #7a7a72;
  font-weight: 300;
  line-height: 1.65;
  max-width: 560px;
}

.hero-meta {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-top: 28px;
  font-family: var(--mono);
  font-size: 10.5px;
  color: #4a4a42;
  flex-wrap: wrap;
}

/* RIGHT: floating visual */
.hero-visual {
  position: relative;
  height: 100%;
  min-height: 380px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-visual-inner {
  position: relative;
  width: 100%;
  will-change: transform;
}

.hero-img {
  width: 75%;
  height: auto;
  border-radius: var(--radius-lg);
  box-shadow:
    0 32px 80px rgba(0, 0, 0, 0.5),
    0 8px 24px rgba(0, 0, 0, 0.3),
    0 0 0 1px rgba(255, 255, 255, 0.06);
  display: block;
  animation: heroFloat 6s ease-in-out infinite;
}

.hero-img-fade {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80px;
  background: linear-gradient(to top, var(--ink), transparent);
  border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  pointer-events: none;
}

@keyframes heroFloat {
  0%   { transform: translateY(0); }
  50%  { transform: translateY(-12px); }
  100% { transform: translateY(0); }
}

@media (max-width: 960px) {
  .article-hero-inner {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .hero-visual {
    display: none; /* hide thumbnail on small screens */
  }
  .article-hero {
    padding: 48px 20px 40px;
  }
}
    /* LAYOUT */
    .article-layout { max-width: 1160px; margin: 0 auto; padding: 56px 40px 80px; display: grid; grid-template-columns: 1fr 300px; gap: 64px; align-items: start; }
    .prose { max-width: 680px; }
    .article-sidebar { position: sticky; top: 80px; align-self: start; display: flex; flex-direction: column; gap: 16px; }
    @media (max-width: 960px) { .article-layout { grid-template-columns: 1fr; gap: 40px; padding: 32px 20px 60px; } .article-sidebar { position: static; } .prose { max-width: 100%; } }

    /* PROSE */
    .prose h2 { font-family: var(--serif); font-size: clamp(22px, 2.8vw, 30px); letter-spacing: -0.02em; color: var(--ink); margin: 52px 0 18px; padding-bottom: 12px; border-bottom: 1px solid var(--paper-3); }
    .prose h3 { font-size: 18px; font-weight: 600; color: var(--ink); margin: 36px 0 12px; letter-spacing: -0.015em; }
    .prose p { font-size: 16px; color: var(--ink-2); line-height: 1.8; margin-bottom: 22px; }
    .prose ul, .prose ol { padding-left: 22px; margin-bottom: 22px; }
    .prose li { font-size: 15.5px; color: var(--ink-2); line-height: 1.75; margin-bottom: 8px; }
    .prose a { color: var(--accent); text-decoration: none; border-bottom: 1px solid rgba(200,67,42,0.3); transition: border-color 0.15s; }
    .prose a:hover { border-bottom-color: var(--accent); }
    .prose strong { color: var(--ink); font-weight: 600; }
    .prose code { font-family: var(--mono); font-size: 13px; background: var(--paper-2); border: 1px solid var(--border); padding: 1px 6px; border-radius: 3px; color: var(--ink); }

    /* DIRECT ANSWER BOX */
    .direct-answer { background: linear-gradient(135deg, #0f0f0d 0%, #1a1a17 100%); border-radius: var(--radius-lg); padding: 24px 28px; margin: 0 0 36px; position: relative; overflow: hidden; }
    .direct-answer::before { content: ''; position: absolute; top: -20px; right: -20px; width: 120px; height: 120px; border-radius: 50%; background: rgba(200,67,42,0.08); pointer-events: none; }
    .direct-answer::after { content: ''; position: absolute; bottom: -30px; left: 40px; width: 80px; height: 80px; border-radius: 50%; background: rgba(42,107,74,0.06); pointer-events: none; }
    .da-label { font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin-bottom: 12px; font-weight: 700; display: flex; align-items: center; gap: 6px; }
    .da-label::before { content: ''; width: 16px; height: 1px; background: var(--accent); display: block; }
    .direct-answer p { font-size: 15px; color: #d4d1c8; line-height: 1.75; margin: 0; font-weight: 400; position: relative; z-index: 1; }
    .direct-answer p strong { color: var(--paper); }

    /* FIELD CARDS */
    .field-reference { display: flex; flex-direction: column; gap: 12px; margin: 24px 0; }
    .field-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; transition: box-shadow 0.15s; }
    .field-card:hover { box-shadow: 0 4px 16px rgba(15,15,13,0.08); }
    .field-card-header { padding: 14px 18px; display: flex; align-items: center; justify-content: space-between; gap: 12px; cursor: pointer; }
    .field-card-left { display: flex; align-items: center; gap: 12px; }
    .field-badge { font-family: var(--mono); font-size: 11.5px; font-weight: 700; color: var(--ink); background: var(--paper-2); border: 1px solid var(--border); border-radius: 3px; padding: 3px 10px; flex-shrink: 0; }
    .field-title { font-size: 14.5px; font-weight: 600; color: var(--ink); }
    .field-risk { font-family: var(--mono); font-size: 10px; padding: 2px 8px; border-radius: 3px; font-weight: 700; flex-shrink: 0; }
    .risk-high { background: #fdecea; color: var(--accent); }
    .risk-medium { background: var(--amber-light); color: var(--amber); }
    .risk-low { background: var(--green-light); color: var(--green); }
    .risk-none { background: var(--paper-2); color: var(--ink-3); border: 1px solid var(--border); }
    .field-chevron { color: var(--ink-3); transition: transform 0.2s; flex-shrink: 0; }
    .field-card.open .field-chevron { transform: rotate(180deg); }
    .field-card-body { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
    .field-card.open .field-card-body { max-height: 900px; }
    .field-card-inner { padding: 0 18px 18px; border-top: 1px solid var(--paper-3); }
    .field-meta-row { display: flex; gap: 24px; padding: 10px 0; border-bottom: 1px solid var(--paper-3); flex-wrap: wrap; }
    .field-meta-item { display: flex; flex-direction: column; gap: 2px; }
    .field-meta-label { font-family: var(--mono); font-size: 9.5px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-3); }
    .field-meta-val { font-size: 13px; color: var(--ink-2); font-weight: 500; }
    .field-example { background: var(--paper-2); border-radius: var(--radius); padding: 10px 14px; margin: 12px 0; font-family: var(--mono); font-size: 12.5px; line-height: 1.7; }
    .fe-key { color: var(--ink-3); }
    .fe-val { color: var(--accent); }
    .fe-val.safe { color: var(--green); }
    .field-desc { font-size: 14px; color: var(--ink-2); line-height: 1.7; margin: 10px 0 0; }

    /* CODE BLOCK */
    .code-block { background: #0a0a08; border-radius: var(--radius-lg); padding: 16px 20px; margin: 16px 0; font-family: var(--mono); font-size: 12.5px; color: #7acc99; line-height: 1.9; overflow-x: auto; position: relative; }
    .c-comment { color: #3a5a42; }
    .c-cmd { color: #88ccaa; }
    .c-arg { color: #f0c060; }
    .c-prompt { color: #4a6a52; }
    .c-field { color: var(--accent); }
    .copy-btn { position: absolute; top: 10px; right: 12px; background: #1a1a17; border: 1px solid #2a2a27; border-radius: 3px; padding: 3px 9px; font-size: 10px; color: #5a5a52; cursor: pointer; font-family: var(--mono); transition: all 0.15s; }
    .copy-btn:hover { background: #252522; color: #9a9a92; }

    /* CALLOUT */
    .callout { border-left: 3px solid var(--accent); background: var(--white); border-radius: 0 var(--radius-lg) var(--radius-lg) 0; padding: 18px 22px; margin: 32px 0; box-shadow: 0 1px 3px rgba(15,15,13,0.08); }
    .callout.green { border-left-color: var(--green); }
    .callout.amber { border-left-color: var(--amber); }
    .callout-label { font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; margin-bottom: 8px; color: var(--accent); }
    .callout.green .callout-label { color: var(--green); }
    .callout.amber .callout-label { color: var(--amber); }
    .callout p { margin: 0; font-size: 14.5px; color: var(--ink-2); line-height: 1.65; }
    .callout p + p { margin-top: 8px; }

    /* TABLE */
    .table-wrapper { overflow-x: auto; margin: 24px 0; }
    .data-table { width: 100%; border-collapse: collapse; font-size: 13px; border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; }
    .data-table th { padding: 10px 14px; text-align: left; font-size: 10px; letter-spacing: 0.07em; text-transform: uppercase; color: var(--ink-3); background: var(--paper-2); font-family: var(--mono); border-bottom: 1px solid var(--border); }
    .data-table th.dark { background: var(--ink); color: var(--paper); }
    .data-table td { padding: 10px 14px; border-bottom: 1px solid var(--paper-3); color: var(--ink-2); vertical-align: top; line-height: 1.55; font-size: 13px; }
    .data-table tr:last-child td { border-bottom: none; }
    .data-table tr:nth-child(even) td { background: var(--paper); }

    /* VERIFICATION CHECKLIST */
    .verify-widget { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; margin: 28px 0; }
    .verify-header { padding: 14px 20px; background: var(--paper-2); border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }
    .verify-title { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-3); font-weight: 600; }
    .verify-counter { font-family: var(--mono); font-size: 11px; color: var(--ink-3); }
    .verify-counter span { color: var(--green); font-weight: 600; }
    .verify-item { display: flex; gap: 14px; padding: 14px 20px; border-bottom: 1px solid var(--paper-3); align-items: flex-start; cursor: pointer; transition: background 0.15s; user-select: none; }
    .verify-item:last-child { border-bottom: none; }
    .verify-item:hover { background: var(--paper); }
    .verify-item.checked { opacity: 0.65; }
    .verify-item.checked .v-title { text-decoration: line-through; color: var(--ink-3); }
    .v-box { width: 18px; height: 18px; border: 1.5px solid var(--border); border-radius: 3px; flex-shrink: 0; margin-top: 2px; display: flex; align-items: center; justify-content: center; font-size: 11px; color: white; font-weight: 700; transition: all 0.15s; }
    .verify-item.checked .v-box { background: var(--green); border-color: var(--green); }
    .v-content { flex: 1; }
    .v-title { font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 3px; line-height: 1.4; }
    .v-desc { font-size: 12.5px; color: var(--ink-3); line-height: 1.5; }

    /* CTA */
    .article-cta { background: var(--ink); border-radius: var(--radius-lg); padding: 28px 32px; margin: 44px 0; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
    .article-cta h3 { font-family: var(--serif); font-size: 22px; color: var(--paper); font-style: italic; margin-bottom: 6px; letter-spacing: -0.02em; }
    .article-cta p { font-size: 13.5px; color: #7a7a72; margin: 0; }
    .btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 20px; border-radius: var(--radius); font-size: 13.5px; font-weight: 600; text-decoration: none; transition: all 0.15s; border: none; font-family: var(--sans); cursor: pointer; }
    .btn-light { background: var(--paper); color: var(--ink); }
    .btn-light:hover { background: #fff; }

    /* FAQ */
    .faq-section { margin-top: 56px; border-top: 1px solid var(--paper-3); padding-top: 40px; }
    .faq-title { font-family: var(--serif); font-size: 26px; letter-spacing: -0.02em; margin-bottom: 28px; color: var(--ink); }
    .faq-item { border: 1px solid var(--border); border-radius: var(--radius-lg); margin-bottom: 10px; overflow: hidden; background: var(--white); }
    .faq-q { width: 100%; text-align: left; padding: 16px 20px; background: none; border: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 16px; font-size: 14.5px; font-weight: 600; color: var(--ink); font-family: var(--sans); transition: background 0.15s; line-height: 1.4; }
    .faq-q:hover { background: var(--paper); }
    .faq-q svg { flex-shrink: 0; transition: transform 0.2s ease; color: var(--ink-3); }
    .faq-item.open .faq-q svg { transform: rotate(180deg); }
    .faq-item.open .faq-q { background: var(--paper); }
    .faq-a { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
    .faq-item.open .faq-a { max-height: 400px; }
    .faq-a-inner { padding: 16px 20px 18px; font-size: 14.5px; color: var(--ink-2); line-height: 1.75; border-top: 1px solid var(--paper-3); }

    /* SIDEBAR */
    .sidebar-widget { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; }
    .sw-header { padding: 12px 16px; border-bottom: 1px solid var(--paper-3); font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); font-weight: 600; }
    .sw-body { padding: 14px 16px; }
    .toc-link { display: flex; align-items: flex-start; gap: 8px; font-size: 12.5px; color: var(--ink-3); text-decoration: none; padding: 6px 0; border-bottom: 1px solid var(--paper-3); transition: color 0.15s; line-height: 1.4; }
    .toc-link:last-child { border-bottom: none; }
    .toc-link:hover, .toc-link.active { color: var(--ink); font-weight: 500; }
    .toc-num { font-family: var(--mono); font-size: 10px; color: var(--paper-3); flex-shrink: 0; padding-top: 2px; }
    .stw { background: var(--ink); border-radius: var(--radius-lg); padding: 20px; }
