<script>
  // Footer year (safe)
  const yearEl = document.getElementById('footer-year');
  if (yearEl) yearEl.textContent = new Date().getFullYear();

  // Reading progress
  const bar = document.getElementById('reading-progress');
  if (bar) {
    window.addEventListener('scroll', () => {
      const docH = document.documentElement.scrollHeight - window.innerHeight;
      const pct = docH > 0 ? (window.scrollY / docH) * 100 : 0;
      bar.style.width = Math.min(pct, 100) + '%';
      bar.style.background = pct >= 99 ? 'var(--green)' : 'var(--accent)';
    }, { passive: true });
  }

  // Field card accordion
  document.querySelectorAll('.field-card-header').forEach(header => {
    header.addEventListener('click', () => {
      const card = header.closest('.field-card');
      if (!card) return;
      const isOpen = card.classList.contains('open');
      document.querySelectorAll('.field-card.open').forEach(c => c.classList.remove('open'));
      if (!isOpen) card.classList.add('open');
    });
  });

  // FAQ accordion
  document.querySelectorAll('.faq-q').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      if (!item) return;
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item.open').forEach(el => el.classList.remove('open'));
      if (!isOpen) item.classList.add('open');
    });
  });

  // Verification checklist
  document.querySelectorAll('.verify-item').forEach(item => {
    item.addEventListener('click', () => {
      item.classList.toggle('checked');
      const box = item.querySelector('.v-box');
      if (box) box.textContent = item.classList.contains('checked') ? '✓' : '';
      const done = document.querySelectorAll('.verify-item.checked').length;
      const counter = document.getElementById('vc-done');
      if (counter) counter.textContent = done;
    });
  });

  // Copy code buttons
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const block = btn.parentElement;
      if (!block) return;
      const text = block.innerText
        .replace('Copy', '')
        .replace('✓ Copied', '')
        .trim();
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = '✓ Copied';
        setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
      } catch {
        btn.textContent = 'Failed';
        setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
      }
    });
  });

  // Active TOC on scroll
  const sections = [
    'two-stores',
    'info-dictionary-fields',
    'office-only-fields',
    'xmp-fields',
    'how-to-read-all-fields',
    'gdpr-field-map',
    'verification-checklist'
  ];
  const tocLinks = document.querySelectorAll('.toc-link');

  function updateActiveTOC() {
    let current = 0;
    const offset = 160;
    sections.forEach((id, i) => {
      const el = document.getElementById(id);
      if (el && window.scrollY >= el.offsetTop - offset) current = i;
    });
    tocLinks.forEach((link, i) => link.classList.toggle('active', i === current));
  }

  window.addEventListener('scroll', updateActiveTOC, { passive: true });
  updateActiveTOC();
</script>

