    .data-table tr:last-child td { border-bottom: none; }
    .data-table tr:nth-child(even) td { background: var(--paper); }
    .risk-pill { display: inline-block; font-family: var(--mono); font-size: 10px; padding: 2px 7px; border-radius: 3px; font-weight: 600; }
    .risk-high { background: #fdecea; color: var(--accent); }
    .risk-medium { background: var(--amber-light); color: var(--amber); }
    .risk-low { background: var(--green-light); color: var(--green); }

    /* CODE BLOCK */
    .code-block { background: #0a0a08; border-radius: var(--radius-lg); padding: 18px 22px; margin: 16px 0; font-family: var(--mono); font-size: 13px; color: #7acc99; line-height: 1.9; overflow-x: auto; position: relative; }
    .c-comment { color: #3a5a42; }
    .c-cmd { color: #88ccaa; }
    .c-arg { color: #f0c060; }
    .c-prompt { color: #4a6a52; }
    .c-out { color: #5a7a62; }
    .c-warn { color: var(--accent); }
    .copy-btn { position: absolute; top: 10px; right: 12px; background: #1a1a17; border: 1px solid #2a2a27; border-radius: 3px; padding: 3px 9px; font-size: 10px; color: #5a5a52; cursor: pointer; font-family: var(--mono); transition: all 0.15s; }
    .copy-btn:hover { background: #252522; color: #9a9a92; }

    /* ARTICLE CTA */
    .article-cta { background: var(--ink); border-radius: var(--radius-lg); padding: 28px 32px; margin: 44px 0; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
    .article-cta h3 { font-family: var(--serif); font-size: 22px; color: var(--paper); font-style: italic; margin-bottom: 6px; letter-spacing: -0.02em; }
    .article-cta p { font-size: 13.5px; color: #7a7a72; margin: 0; }
    .btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 20px; border-radius: var(--radius); font-size: 13.5px; font-weight: 600; text-decoration: none; transition: all 0.15s; border: none; font-family: var(--sans); cursor: pointer; }
    .btn-light { background: var(--paper); color: var(--ink); }
