      {"@type": "HowToStep", "position": 1, "name": "Open the file's properties before uploading", "text": "Check the Author, Company, Producer, and Comments fields in the document properties panel before dragging the file into Slack, Teams, or an email draft."},
      {"@type": "HowToStep", "position": 2, "name": "Check the first page for anything you would not say out loud in the channel", "text": "Preview cards and thumbnails in Slack and Teams render the first page automatically, so anything visible there is effectively already shared."},
      {"@type": "HowToStep", "position": 3, "name": "Strip metadata for anything leaving your organization", "text": "Run the file through a metadata remover before sending it to an external partner, client, or public channel, especially if it started life inside an internal template."},
      {"@type": "HowToStep", "position": 4, "name": "Re-check after conversion", "text": "If the PDF was exported from Word, Google Docs, or a scanner, re-check metadata after export — conversion tools frequently reintroduce fields like Producer, Creator, and embedded revision history."}
