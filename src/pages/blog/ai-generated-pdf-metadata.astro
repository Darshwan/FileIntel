      item.classList.toggle('done');
      item.querySelector('.check-box').textContent = item.classList.contains('done') ? '✓' : '';
      const done = document.querySelectorAll('.checklist-item.done').length;
      document.getElementById('done-count').textContent = done;
    });
  });

  // Copy code button, event listener based
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const block = btn.parentElement;
      const text = block.innerText.replace('Copy', '').replace('✓ Copied', '').trim();
      navigator.clipboard.writeText(text).then(() => {
        btn.textContent = '✓ Copied';
        setTimeout(() => btn.textContent = 'Copy', 2000);
      });
    });
  });

  // Hero image parallax and float pause while scrolling
  const heroVisualInner = document.getElementById('hero-visual-inner');
  if (heroVisualInner) {
    let heroScrollTimer = 0;
    window.addEventListener('scroll', () => {
      const scrollY = window.scrollY;
      const heroHeight = document.querySelector('.article-hero')?.getBoundingClientRect().height || 460;
      if (scrollY < heroHeight + 100) {
        heroVisualInner.style.transform = `translateY(${scrollY * 0.28}px)`;
      }
      heroVisualInner.classList.add('scrolling');
      if (heroScrollTimer) window.clearTimeout(heroScrollTimer);
      heroScrollTimer = window.setTimeout(() => heroVisualInner.classList.remove('scrolling'), 150);
    }, { passive: true });
  }

  // Active TOC on scroll
  const sections = ['section-1', 'section-2', 'section-3', 'section-4', 'section-5', 'section-6'];
  const tocLinks = document.querySelectorAll('.toc-link');
  window.addEventListener('scroll', () => {
    let current = 0;
    sections.forEach((id, i) => {
      const el = document.getElementById(id);
      if (el && window.scrollY >= el.offsetTop - 140) current = i;
    });
    tocLinks.forEach((l, i) => l.classList.toggle('active', i === current));
  }, { passive: true });

  // Footer year
  document.getElementById('footer-year').textContent = new Date().getFullYear();
</script>
</body>
</html>