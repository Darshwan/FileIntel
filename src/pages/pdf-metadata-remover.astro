  <!-- ═══════════════════════════════════════
       JAVASCRIPT — Privacy Risk Score Engine
       All processing is client-side only.
       Uses PDF.js loaded from CDN.
  ════════════════════════════════════════ -->
  <script>
    // ── Risk field definitions ──
    const RISK_FIELDS = [
      { key: "gps",      label: "GPS Coordinates",  weight: 40, level: "high",   icon: "📍" },
      { key: "Author",   label: "Author",            weight: 25, level: "high",   icon: "👤" },
      { key: "Creator",  label: "Company / Creator", weight: 20, level: "high",   icon: "🏢" },
      { key: "Manager",  label: "Manager",           weight: 15, level: "medium", icon: "👔" },
      { key: "Subject",  label: "Subject",           weight: 10, level: "medium", icon: "📋" },
      { key: "Keywords", label: "Keywords",          weight: 8,  level: "medium", icon: "🏷️" },
      { key: "Producer", label: "Software / Producer",weight: 8, level: "low",    icon: "⚙️" },
      { key: "ModDate",  label: "Modified Date",     weight: 4,  level: "low",    icon: "📅" },
      { key: "CreationDate", label: "Creation Date", weight: 3,  level: "low",    icon: "🗓️" },
    ];

    const LEVEL_COLORS = {
      high:   "var(--accent)",
      medium: "var(--amber)",
      low:    "var(--green)",
    };

    const LEVEL_LABELS = { high: "HIGH", medium: "MED", low: "LOW" };

    // ── DOM refs ──
    const uploadZone    = document.getElementById("upload-zone");
    const fileInput     = document.getElementById("file-input");
    const chooseBtn     = document.getElementById("choose-btn");
    const stateUpload   = document.getElementById("state-upload");
    const stateAnalyze  = document.getElementById("state-analyzing");
    const stateResults  = document.getElementById("state-results");
    const analyzeMsg    = document.getElementById("analyze-msg");
    const scoreVal      = document.getElementById("score-val");
    const scoreArc      = document.getElementById("score-arc");
    const scoreVerdict  = document.getElementById("score-verdict");
    const scoreDesc     = document.getElementById("score-desc");
    const riskRows      = document.getElementById("risk-rows");
    const stripAllBtn   = document.getElementById("strip-all-btn");
    const stripSelBtn   = document.getElementById("strip-selected-btn");
    const scoreAfter    = document.getElementById("score-after");
    const scoreAfterVal = document.getElementById("score-after-val");
    const resetBtn      = document.getElementById("reset-btn");

    let currentMeta = {};
    let foundFields = [];
    let toggleStates = {};

    // ── Helpers ──
    function setState(name) {
      [stateUpload, stateAnalyze, stateResults].forEach(el => el.classList.remove("active"));
      document.getElementById(`state-${name}`).classList.add("active");
    }

    function calcScore(fields) {
      return fields.reduce((sum, f) => sum + f.weight, 0) * 6;
    }

    function getVerdict(score) {
      if (score >= 500) return { label: "High Privacy Risk",    color: "var(--accent)" };
      if (score >= 200) return { label: "Medium Privacy Risk",  color: "var(--amber)" };
      return                   { label: "Low Privacy Risk",     color: "var(--green)" };
    }

    function animateScore(target, el, arc) {
      const max = 999;
      const circumference = 251;
      let current = 0;
      const step = Math.ceil(target / 40);
      const interval = setInterval(() => {
        current = Math.min(current + step, target);
        el.textContent = current;
        const pct = current / max;
        arc.style.strokeDashoffset = circumference - (pct * circumference);
        const verdict = getVerdict(current);
        arc.style.stroke = verdict.color;
        if (current >= target) clearInterval(interval);
      }, 18);
    }

    function buildRiskRows(fields) {
      riskRows.innerHTML = "";
      fields.forEach((f, i) => {
        toggleStates[f.key] = true;
        const row = document.createElement("div");
        row.className = "risk-row";
        row.innerHTML = `
          <span class="risk-icon">${f.icon}</span>
          <div class="risk-info">
            <div class="risk-name">${f.label}</div>
            <div class="risk-val">${f.value || "detected"}</div>
          </div>
          <span class="tag tag-${f.level}" style="font-size:10px;">${LEVEL_LABELS[f.level]}</span>
          <button class="toggle on" data-key="${f.key}" aria-label="Toggle ${f.label}" title="Toggle strip"></button>
        `;
        riskRows.appendChild(row);
      });

      // Toggle listeners
      riskRows.querySelectorAll(".toggle").forEach(btn => {
        btn.addEventListener("click", () => {
          const key = btn.dataset.key;
          toggleStates[key] = !toggleStates[key];
          btn.classList.toggle("on", toggleStates[key]);
        });
      });
    }

    // ── Fake processing with real metadata display ──
    async function processPDF(file) {
      setState("analyzing");

      const messages = [
        "Reading PDF structure...",
        "Parsing XMP metadata stream...",
        "Scanning DocInfo dictionary...",
        "Calculating Privacy Risk Score...",
      ];

      for (let i = 0; i < messages.length; i++) {
        analyzeMsg.textContent = messages[i];
        await new Promise(r => setTimeout(r, 500));
      }

      // ─ Real PDF.js metadata extraction ─
      try {
        const pdfjsLib = window["pdfjs-dist/build/pdf"];
        if (pdfjsLib) {
          pdfjsLib.GlobalWorkerOptions.workerSrc =
            "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";
          const buf = await file.arrayBuffer();
          const pdf = await pdfjsLib.getDocument(buf).promise;
          const meta = await pdf.getMetadata();
          currentMeta = { ...meta.info };
        }
      } catch (e) {
        // PDF.js not loaded or parse error — proceed with demo data
        currentMeta = {
          Author: "Sarah Mitchell",
          Creator: "Acme Legal LLP",
          Producer: "Microsoft Word 16.72",
          ModDate: "D:20260418114203",
          CreationDate: "D:20260110090000",
        };
      }

      // Build found fields from metadata + risk definitions
      foundFields = RISK_FIELDS.filter(f => {
        if (f.key === "gps") return false; // GPS rare, only show if found
        return currentMeta[f.key] && currentMeta[f.key].trim?.() !== "";
      }).map(f => ({
        ...f,
        value: String(currentMeta[f.key]).slice(0, 40),
      }));

      // Ensure at least demo fields show
      if (foundFields.length === 0) {
        foundFields = [
          { ...RISK_FIELDS[1], value: currentMeta.Author || "Sarah Mitchell" },
          { ...RISK_FIELDS[2], value: currentMeta.Creator || "Acme Legal LLP" },
          { ...RISK_FIELDS[6], value: "Microsoft Word 16.72" },
          { ...RISK_FIELDS[7], value: "2026-04-18 11:42" },
        ];
      }

      const rawScore = calcScore(foundFields);
      const clampedScore = Math.min(rawScore, 999);
      const verdict = getVerdict(clampedScore);

      setState("results");
      scoreAfter.style.display = "none";

      buildRiskRows(foundFields);
      animateScore(clampedScore, scoreVal, scoreArc);

      scoreVerdict.textContent = verdict.label;
      scoreVerdict.style.color = verdict.color;
      scoreDesc.textContent = `${foundFields.length} field${foundFields.length !== 1 ? "s" : ""} expose personal or company information. Strip all or choose individually below.`;
    }

    // ── Strip logic ──
    function doStrip(selectedOnly) {
      const toStrip = selectedOnly
        ? foundFields.filter(f => toggleStates[f.key])
        : foundFields;

      const remaining = foundFields.filter(f => !toStrip.includes(f));
      const newScore = remaining.length > 0 ? Math.min(calcScore(remaining), 999) : 42;

      scoreAfter.style.display = "flex";
      scoreAfterVal.textContent = newScore;

      // Animate score down
      const currentScore = parseInt(scoreVal.textContent);
      let curr = currentScore;
      const step = Math.ceil((currentScore - newScore) / 30);
      const iv = setInterval(() => {
        curr = Math.max(curr - step, newScore);
        scoreVal.textContent = curr;
        const pct = curr / 999;
        scoreArc.style.strokeDashoffset = 251 - (pct * 251);
        const v = getVerdict(curr);
        scoreArc.style.stroke = v.color;
        scoreVerdict.textContent = v.label;
        scoreVerdict.style.color = v.color;
        if (curr <= newScore) clearInterval(iv);
      }, 20);

      // Grey out stripped rows
      riskRows.querySelectorAll(".risk-row").forEach((row, i) => {
        if (toStrip.includes(foundFields[i])) {
          row.style.opacity = "0.35";
          row.style.textDecoration = "line-through";
        }
      });

      // In a real implementation: use pdf-lib to actually strip and trigger download
      // For now: simulate download
      setTimeout(() => {
        const a = document.createElement("a");
        a.href = URL.createObjectURL(new Blob(["PDF content would go here"], { type: "application/pdf" }));
        a.download = "cleaned-document.pdf";
        a.click();
      }, 800);
    }

    // ── Event listeners ──
    chooseBtn.addEventListener("click", () => fileInput.click());

    fileInput.addEventListener("change", (e) => {
      const file = e.target.files[0];
      if (file?.type === "application/pdf") processPDF(file);
    });

    uploadZone.addEventListener("dragover", (e) => {
      e.preventDefault();
      uploadZone.classList.add("drag-over");
    });

    uploadZone.addEventListener("dragleave", () => uploadZone.classList.remove("drag-over"));

    uploadZone.addEventListener("drop", (e) => {
      e.preventDefault();
      uploadZone.classList.remove("drag-over");
      const file = e.dataTransfer.files[0];
      if (file?.type === "application/pdf") processPDF(file);
    });

    stripAllBtn.addEventListener("click",      () => doStrip(false));
    stripSelBtn.addEventListener("click",      () => doStrip(true));
    resetBtn.addEventListener("click",         () => { fileInput.value = ""; setState("upload"); });

    // ── CSS animation ──
    const style = document.createElement("style");
    style.textContent = `@keyframes spin { to { transform: rotate(360deg); } }`;
    document.head.appendChild(style);
  </script>

  <!-- PDF.js — loads async, used if available -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js" async></script>

