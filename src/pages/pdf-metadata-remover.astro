    <!-- ══════════════════════════════════════════════════════════
       PRODUCTION JAVASCRIPT
       Libraries: PDF.js (inspection) + pdf-lib (stripping)
       Architecture: 100% client-side, zero server calls
  ═══════════════════════════════════════════════════════════ -->
    <script>
      (() => {
        "use strict";
        // Configure PDF.js worker
        window["pdfjs-dist/build/pdf"].GlobalWorkerOptions.workerSrc =
          "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";

        // ── Risk field definitions with scoring weights ──
        const RISK_FIELDS = [
          {
            key: "Author",
            label: "Author",
            weight: 25,
            level: "high",
            icon: "👤",
            pdfLibKey: "author",
          },
          {
            key: "Creator",
            label: "Company / Creator",
            weight: 20,
            level: "high",
            icon: "🏢",
            pdfLibKey: "creator",
          },
          {
            key: "Manager",
            label: "Manager",
            weight: 15,
            level: "high",
            icon: "👔",
            pdfLibKey: null,
          },
          {
            key: "Subject",
            label: "Subject",
            weight: 10,
            level: "medium",
            icon: "📋",
            pdfLibKey: "subject",
          },
          {
            key: "Keywords",
            label: "Keywords",
            weight: 8,
            level: "medium",
            icon: "🏷",
            pdfLibKey: "keywords",
          },

          {
            key: "Producer",
            label: "Software / Producer",
            weight: 8,
            level: "medium",
            icon: "⚙️",
            pdfLibKey: "producer",
          },
          {
            key: "ModDate",
            label: "Modified Date",
            weight: 4,
            level: "low",
            icon: "📅",
            pdfLibKey: "modificationDate",
          },
          {
            key: "CreationDate",
            label: "Creation Date",
            weight: 3,
            level: "low",
            icon: "📆",
            pdfLibKey: "creationDate",
          },

          {
            key: "Title",
            label: "Document Title",
            weight: 5,
            level: "medium",
            icon: "📄",
            pdfLibKey: "title",
          },
        ];

        const LEVEL_COLORS = {
          high: "var(--accent)",
          medium: "var(--amber)",
          low: "var(--green)",
        };
        const MAX_SCORE = 999;
        const CIRCUMFERENCE = 239;

        // ── State ──
        let currentFileBytes = null;
        let currentFileName = "";
        let foundFields = [];
        let toggleStates = {};
        let allSelected = true;
        let isStripped = false;

        // ── DOM refs ──
        const $ = (id) => document.getElementById(id);
        const uploadZone = $("upload-zone");
        const fileInput = $("file-input");
        const stateUpload = $("state-upload");
        const stateAnalyzing = $("state-analyzing");
        const stateError = $("state-error");
        const stateClean = $("state-clean");
        const stateResults = $("state-results");
        const analyzeMsg = $("analyze-msg");
        const scoreArc = $("score-arc");
        const scoreVal = $("score-val");
        const scoreVerdict = $("score-verdict");
        const scoreDesc = $("score-desc");
        const riskRows = $("risk-rows");
        const stripBtn = $("strip-selected-btn");
        const resetBtn = $("reset-btn");
        const resetBtn2 = $("reset-btn-2");
        const selectAllBtn = $("select-all-btn");
        const selectedLabel = $("selected-count-label");
        const scoreImproved = $("score-improved");
        const scoreAfterVal = $("score-after-val");
        const scoreImprovedSub = $("score-improved-sub");
        const fileNameDisplay = $("file-name-display");
        const fileSizeDisplay = $("file-size-display");
        const fieldCountDisplay = $("field-count-display");
        const dlProgress = $("dl-progress");
        const dlBar = $("dl-bar");
        const errorMsg = $("error-msg");
        const panelBadge = $("panel-badge");

        // ── Helpers ──
        function setState(name) {
          [
            stateUpload,
            stateAnalyzing,
            stateError,
            stateClean,
            stateResults,
          ].forEach((el) => el.classList.remove("active"));
          $("state-" + name).classList.add("active");
        }

        function formatBytes(bytes) {
          if (bytes < 1024) return bytes + " B";
          if (bytes < 1048576) return (bytes / 1024).toFixed(1) + " KB";
          return (bytes / 1048576).toFixed(2) + " MB";
        }

        function formatPdfDate(raw) {
          if (!raw) return "";
          // PDF date format: D:YYYYMMDDHHmmSS
          const m = String(raw).match(
            /D:(\d{4})(\d{2})(\d{2})(\d{2})(\d{2})(\d{2})/,
          );
          if (m) return `${m[1]}-${m[2]}-${m[3]} ${m[4]}:${m[5]}`;
          return String(raw).replace("D:", "").slice(0, 16);
        }

        function truncate(str, len = 36) {
          if (!str) return "";
          const s = String(str).trim();
          return s.length > len ? s.slice(0, len) + "…" : s;
        }

        function calcScore(fields) {
          const raw = fields.reduce((sum, f) => sum + f.weight, 0) * 6;
          return Math.min(raw, MAX_SCORE);
        }

        function getVerdict(score) {
          if (score >= 400)
            return { label: "High Privacy Risk", color: "var(--accent)" };
          if (score >= 150)
            return { label: "Medium Privacy Risk", color: "var(--amber)" };
          return { label: "Low Privacy Risk", color: "var(--green)" };
        }

        function renderMetadataDiff(strippedFields, remainingFields) {
          const diffEl = document.getElementById("metadata-diff");
          const beforeList = document.getElementById("diff-before-list");
          const afterList = document.getElementById("diff-after-list");
          const beforeCount = document.getElementById("diff-before-count");
          const afterCount = document.getElementById("diff-after-count");
          const changeSummary = document.getElementById("diff-change-summary");

          if (
            !diffEl ||
            !beforeList ||
            !afterList ||
            !beforeCount ||
            !afterCount ||
            !changeSummary
          ) {
            return;
          }

          const ICONS = { high: "🔴", medium: "🟡", low: "🟢" };

          beforeList.innerHTML = "";
          const allFields = [...strippedFields, ...remainingFields];

          allFields.forEach((f) => {
            const isStripped = strippedFields.includes(f);
            const row = document.createElement("div");
            row.className =
              "diff-field-row " +
              (isStripped ? "state-removed" : "state-kept");
            row.innerHTML = `
      <span class="diff-field-icon">${ICONS[f.level] || "⚪"}</span>
      <span class="diff-field-key">${f.label}</span>
      <span class="diff-field-val">${(f.value || "").slice(0, 30)}</span>
      <span class="diff-field-status ${isStripped ? "status-removed" : "status-kept"}">
        ${isStripped ? "Removed" : "Kept"}
      </span>
    `;
            beforeList.appendChild(row);
          });

          afterList.innerHTML = "";
          if (remainingFields.length === 0) {
            afterList.innerHTML = '<div class="diff-empty">✓ All metadata removed</div>';
          } else {
            remainingFields.forEach((f) => {
              const row = document.createElement("div");
              row.className = "diff-field-row state-clean";
              row.innerHTML = `
        <span class="diff-field-icon">${ICONS[f.level] || "⚪"}</span>
        <span class="diff-field-key">${f.label}</span>
        <span class="diff-field-val">${(f.value || "").slice(0, 30)}</span>
        <span class="diff-field-status status-clean">Kept</span>
      `;
              afterList.appendChild(row);
            });
          }

          beforeCount.textContent = `${allFields.length} fields`;
          afterCount.textContent = `${remainingFields.length} fields`;
          changeSummary.textContent = `${strippedFields.length} field${strippedFields.length !== 1 ? "s" : ""} removed`;

          diffEl.style.display = "block";
        }

        // ── Score meter bar ──
        function setMeter(score, instant = false) {
          const fill = document.getElementById("score-meter-fill");
          if (!fill) return;
          const pct = Math.min((score / MAX_SCORE) * 100, 100);
          const color =
            score >= 400
              ? "var(--accent)"
              : score >= 150
                ? "var(--amber)"
                : "var(--green)";
          if (instant) fill.style.transition = "none";
          else
            fill.style.transition =
              "width 0.8s cubic-bezier(0.22,1,0.36,1), background 0.4s";
          fill.style.width = pct + "%";
          fill.style.background = color;
        }

        function setArc(score, instant = false) {
          const pct = Math.min(score / MAX_SCORE, 1);
          const offset = CIRCUMFERENCE - pct * CIRCUMFERENCE;
          const verdict = getVerdict(score);
          if (instant) {
            scoreArc.style.transition = "none";
          } else {
            scoreArc.style.transition =
              "stroke-dashoffset 0.6s ease, stroke 0.4s ease";
          }
          scoreArc.style.strokeDashoffset = offset;
          scoreArc.style.stroke = verdict.color;
        }

        function animateCount(from, to, el, onDone) {
          const duration = 600;
          const start = performance.now();
          const diff = to - from;
          function step(now) {
            const t = Math.min((now - start) / duration, 1);
            const val = Math.round(from + diff * t);
            el.textContent = val;
            if (t < 1) requestAnimationFrame(step);
            else {
              el.textContent = to;
              onDone && onDone();
            }
          }
          requestAnimationFrame(step);
        }

        function updateSelectedCount() {
          const selected = foundFields.filter((f) => toggleStates[f.key]);
          const total = foundFields.length;
          const n = selected.length;
          selectedLabel.textContent =
            n === total ? "All fields selected" : `${n} of ${total} selected`;
          selectAllBtn.textContent =
            n === total ? "Deselect all" : "Select all";
          allSelected = n === total;

          // Live score preview as user toggles
          if (!isStripped) {
            const previewScore = calcScore(selected);
            const verdict = getVerdict(previewScore);
            const currentScore = parseInt(scoreVal.textContent) || 0;
            animateCount(currentScore, previewScore, scoreVal, null);
            setArc(previewScore);
            scoreVerdict.textContent = verdict.label;
            scoreVerdict.style.color = verdict.color;
            scoreDesc.textContent = `${n} field${n !== 1 ? "s" : ""} selected for stripping.`;
          }
        }

        function buildRiskRows(fields) {
          riskRows.innerHTML = "";
          fields.forEach((f) => {
            toggleStates[f.key] = true;
            const row = document.createElement("div");
            row.className = "risk-row";
            row.dataset.key = f.key;
            row.innerHTML = `
          <span class="risk-icon">${f.icon}</span>
          <div class="risk-info">
            <div class="risk-name">${f.label}</div>
            <div class="risk-val">${truncate(f.value)}</div>
          </div>
          <span class="tag tag-${f.level}" style="font-size:10px;">${f.level.toUpperCase()}</span>
          <button class="toggle on" data-key="${f.key}" aria-label="Toggle ${f.label}"></button>
        `;
            riskRows.appendChild(row);
          });

          riskRows.addEventListener("click", (e) => {
            const btn = e.target.closest(".toggle");
            if (!btn) return;
            const key = btn.dataset.key;
            toggleStates[key] = !toggleStates[key];
            btn.classList.toggle("on", toggleStates[key]);
            const row = riskRows.querySelector(`[data-key="${key}"]`);
            if (row) row.classList.toggle("stripped", !toggleStates[key]);
            updateSelectedCount();
          });
        }

        // ── Show download progress bar ──
        function showProgress(pct) {
          dlProgress.style.display = "block";
          dlBar.style.width = pct + "%";
        }

        function hideProgress() {
          setTimeout(() => {
            dlProgress.style.display = "none";
            dlBar.style.width = "0%";
          }, 600);
        }

        // ── CORE: Read PDF metadata with PDF.js ──
        async function inspectPDF(bytes) {
          // Wait for PDF.js to be available
          let pdfjsLib = window["pdfjs-dist/build/pdf"];
          if (!pdfjsLib) {
            await new Promise((resolve, reject) => {
              let attempts = 0;
              const check = setInterval(() => {
                pdfjsLib = window["pdfjs-dist/build/pdf"];
                if (pdfjsLib) {
                  clearInterval(check);
                  resolve();
                }
                if (++attempts > 20) {
                  clearInterval(check);
                  reject(new Error("PDF.js failed to load"));
                }
              }, 200);
            });
          }

          // Load the PDF document
          const loadingTask = pdfjsLib.getDocument({ data: bytes });
          const pdf = await loadingTask.promise;

          // Get metadata
          const metadata = await pdf.getMetadata();
          const info = metadata.info || {};

          // Build result object matching RISK_FIELDS keys
          const result = {};
          result["Author"] = info.Author || "";
          result["Creator"] = info.Creator || "";
          result["Producer"] = info.Producer || "";
          result["Subject"] = info.Subject || "";
          result["Keywords"] = info.Keywords || "";
          result["Title"] = info.Title || "";
          result["CreationDate"] = info.CreationDate || "";
          result["ModDate"] = info.ModDate || "";
          result["Manager"] = info.Manager || "";

          // If PDF.js didn't find ModDate, try XMP
          if (!result["ModDate"] && metadata.metadata) {
            try {
              const raw = metadata.metadata.getAll();
              if (raw && raw["xmp:ModifyDate"]) {
                result["ModDate"] = raw["xmp:ModifyDate"];
              }
            } catch (e) {
              // Ignore XMP parse failures
            }
          }

          return result;
        }

        async function stripMetadata(bytes, keysToStrip) {
          const { PDFDocument, PDFName, PDFString, PDFHexString } = PDFLib;

          showProgress(15);

          // Ensure bytes is always Uint8Array regardless of what was passed in
          const uint8 =
            bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes);
          const pdfDoc = await PDFDocument.load(uint8, {
            ignoreEncryption: false,
            updateMetadata: false,
          });

          showProgress(40);

          const stripAll = keysToStrip.length >= foundFields.length;

          // ── Strategy 1: pdf-lib high-level setters (blank out the value) ──
          const setterMap = {
            Author: () => pdfDoc.setAuthor(""),
            Creator: () => pdfDoc.setCreator(""),
            Subject: () => pdfDoc.setSubject(""),
            Keywords: () => pdfDoc.setKeywords([]),
            Producer: () => pdfDoc.setProducer(""),
            Title: () => pdfDoc.setTitle(""),
            ModDate: () => pdfDoc.setModificationDate(new Date(0)),
            CreationDate: () => pdfDoc.setCreationDate(new Date(0)),
          };

          keysToStrip.forEach((key) => {
            if (setterMap[key]) {
              try {
                setterMap[key]();
              } catch (_) {}
            }
          });

          showProgress(60);

          // ── Strategy 2: Directly delete keys from the PDF Info dictionary ──
          // This ensures the fields are truly gone, not just set to empty strings
          try {
            // Info dictionary lives in the PDF trailer, not the catalog
            const infoRef = pdfDoc.context.trailerInfo.Info;
            if (infoRef) {
              const infoDict = pdfDoc.context.lookup(infoRef);
              if (infoDict) {
                keysToStrip.forEach((key) => {
                  try {
                    infoDict.delete(PDFName.of(key));
                  } catch (_) {}
                });
              }
            }
          } catch (_) {
            // Info dict manipulation failed — high-level setters still applied above
          }

          showProgress(75);

          // ── Strategy 3: Remove XMP metadata stream entirely when stripping all ──
          // XMP is a separate XML blob that duplicates DocInfo — must strip both
          if (stripAll) {
            try {
              pdfDoc.setProducer("FileIntel — fileintel.me");
              pdfDoc.setCreator("FileIntel Privacy Tool");

              const metadataRef = pdfDoc.catalog.get(PDFName.of("Metadata"));
              if (metadataRef) {
                pdfDoc.catalog.delete(PDFName.of("Metadata"));
              }
            } catch (_) {}
          }

          showProgress(88);

          // ── Save: use objectsPerTick for better performance on large files ──
          const cleanBytes = await pdfDoc.save({
            useObjectStreams: false, // Better compatibility across PDF readers
            addDefaultPage: false,
            objectsPerTick: 50,
          });

          showProgress(100);
          return cleanBytes;
        }

        // ── Trigger browser download ──
        function downloadBytes(bytes, filename) {
          const blob = new Blob([bytes], { type: "application/pdf" });
          const url = URL.createObjectURL(blob);
          const a = document.createElement("a");
          a.href = url;
          a.download = filename.replace(/\.pdf$/i, "") + "-clean.pdf";
          document.body.appendChild(a);
          a.click();
          setTimeout(() => {
            URL.revokeObjectURL(url);
            a.remove();
          }, 1000);
        }

        // ── Main process flow ──
        async function processFile(file) {
          if (!file || file.type !== "application/pdf") {
            showError("Please upload a valid PDF file (.pdf).");
            return;
          }

          if (file.size > 52428800) {
            // 50MB
            showError("File exceeds 50MB limit. Please try a smaller PDF.");
            return;
          }

          currentFileName = file.name;
          currentFileBytes = null;
          foundFields = [];
          toggleStates = {};
          isStripped = false;

          setState("analyzing");
          panelBadge.textContent = "PROCESSING...";

          const messages = [
            "Reading PDF structure...",
            "Parsing XMP metadata stream...",
            "Scanning DocInfo dictionary...",
            "Calculating Privacy Risk Score...",
          ];

          let msgIdx = 0;
          const msgInterval = setInterval(() => {
            if (++msgIdx < messages.length)
              analyzeMsg.textContent = messages[msgIdx];
          }, 420);

          try {
            // Read ONCE, slice a copy for PDF.js so it doesn't detach the buffer
            const buffer = await file.arrayBuffer();
            currentFileBytes = new Uint8Array(buffer);

            // Wait at least 1.2s so the animation feels intentional
            const [meta] = await Promise.all([
              inspectPDF(currentFileBytes.slice(0)),
              new Promise((r) => setTimeout(r, 1200)),
            ]);

            clearInterval(msgInterval);

            // Build found fields list
            foundFields = RISK_FIELDS.filter((f) => {
              const val = meta[f.key];
              return (
                val &&
                String(val).trim() !== "" &&
                String(val).trim() !== "D:00000000000000"
              );
            }).map((f) => ({
              ...f,
              value: f.key.includes("Date")
                ? formatPdfDate(meta[f.key])
                : String(meta[f.key]).trim(),
            }));

            if (foundFields.length === 0) {
              panelBadge.textContent = "CLEAN ✓";
              setState("clean");
              return;
            }

            // Populate UI
            fileNameDisplay.textContent = truncate(file.name, 28);
            fileSizeDisplay.textContent = formatBytes(file.size);
            fieldCountDisplay.textContent = `${foundFields.length} risk${foundFields.length !== 1 ? "s" : ""} found`;
            fieldCountDisplay.className =
              "file-info-badge" + (foundFields.length === 0 ? " clean" : "");

            buildRiskRows(foundFields);

            const score = calcScore(foundFields);
            const verdict = getVerdict(score);

            scoreVal.textContent = 0;
            scoreVerdict.textContent = verdict.label;
            scoreVerdict.style.color = verdict.color;
            scoreDesc.textContent = `${foundFields.length} field${foundFields.length !== 1 ? "s" : ""} expose personal or company information. Strip all or choose individually.`;

            scoreImproved.style.display = "none";
            panelBadge.textContent = "LOCAL ONLY";

            setState("results");
            updateSelectedCount();

            // Animate in
            setArc(0, true);
            setMeter(0, true);
            requestAnimationFrame(() => {
              animateCount(0, score, scoreVal, null);
              setArc(score);
              setMeter(score);
            });
          } catch (err) {
            clearInterval(msgInterval);
            console.error("PDF processing error:", err);

            const errorName = err?.name || "";
            const errorMessage = err?.message || "";

            let msg;
            if (
              errorMessage.includes("password") ||
              errorMessage.includes("encrypted")
            ) {
              msg =
                "This PDF is password-protected. Please unlock it first and try again.";
            } else if (
              errorName === "InvalidPDFException" ||
              errorMessage.includes("Invalid PDF")
            ) {
              msg =
                "This file appears to be corrupted or not a valid PDF. Try opening it in another viewer to verify.";
            } else if (
              errorMessage.includes("fetch") ||
              errorMessage.includes("network")
            ) {
              msg = "Network error. Check your connection and try again.";
            } else {
              msg =
                "Could not read this PDF. The file may be corrupted, password-protected, or in an unsupported format.";
            }
            showError(msg);
          }
        }
        function showError(msg) {
          errorMsg.textContent = msg;
          panelBadge.textContent = "ERROR";
          setState("error");
        }

        function resetTool() {
          // Reset file input — create a new one if needed to fully clear it
          try {
            fileInput.value = "";
          } catch (_) {}
          currentFileBytes = null;
          currentFileName = "";
          foundFields = [];
          toggleStates = {};
          allSelected = true;
          isStripped = false;
          panelBadge.textContent = "LOCAL ONLY";
          scoreImproved.style.display = "none";
          if (riskRows) riskRows.innerHTML = "";
          const title = $("zone-title");
          if (title) title.textContent = "Drop a PDF here";
          uploadZone.classList.remove("drag-active");
          hideProgress();
          setState("upload");
        }

        // ── Strip handler ──
        stripBtn.addEventListener("click", async () => {
          console.log(
            "bytes check:",
            currentFileBytes?.byteLength,
            typeof currentFileBytes,
          );
          const toStrip = foundFields.filter((f) => toggleStates[f.key]);
          if (toStrip.length === 0) {
            alert("Select at least one field to strip.");
            return;
          }

          // Validate currentFileBytes before proceeding
          if (!currentFileBytes || currentFileBytes.length === 0) {
            alert("No file data available. Please re-upload the PDF.");
            return;
          }

          stripBtn.disabled = true;
          stripBtn.textContent = "Processing...";
          panelBadge.textContent = "STRIPPING...";

          try {
            const keysToStrip = toStrip.map((f) => f.key);

            // Re-read the file from the original input to ensure fresh bytes
            // This fixes cases where currentFileBytes got corrupted
            const cleanBytes = await stripMetadata(
              currentFileBytes,
              keysToStrip,
            );
            downloadBytes(cleanBytes, currentFileName);
            hideProgress();

            isStripped = true;
            const remaining = foundFields.filter((f) => !toggleStates[f.key]);
            const newScore = remaining.length > 0 ? calcScore(remaining) : 12;
            const oldScore = parseInt(scoreVal.textContent) || 0;

            scoreImproved.style.display = "flex";
            scoreImprovedSub.textContent = `${toStrip.length} field${toStrip.length !== 1 ? "s" : ""} removed · Score improved`;

            animateCount(oldScore, newScore, scoreVal, null);
            animateCount(oldScore, newScore, scoreAfterVal, () => {
              renderMetadataDiff(toStrip, remaining);
            });
            setArc(newScore);
            setMeter(newScore);

            const verdict = getVerdict(newScore);
            scoreVerdict.textContent = verdict.label;
            scoreVerdict.style.color = verdict.color;
            scoreDesc.textContent =
              remaining.length > 0
                ? `${remaining.length} field${remaining.length !== 1 ? "s" : ""} remain. Download the cleaned file above.`
                : "All metadata removed. Your PDF is now clean.";

            panelBadge.textContent = "CLEANED ✓";

            riskRows.querySelectorAll(".risk-row").forEach((row) => {
              const key = row.dataset.key;
              if (toggleStates[key]) {
                row.classList.add("stripped");
              }
            });
          } catch (err) {
            hideProgress();
            console.error("Strip error:", err);

            // Better error message
            const errMsg = err?.message || "";
            if (
              errMsg.includes("No PDF header") ||
              errMsg.includes("Failed to parse")
            ) {
              alert(
                "Could not process this PDF. It may be corrupted. Please try re-uploading the original file.",
              );
              // Reset so user can try again
              resetTool();
            } else {
              alert("Failed to process PDF: " + (errMsg || "Unknown error"));
            }
            panelBadge.textContent = "ERROR";
          } finally {
            stripBtn.disabled = false;
            stripBtn.innerHTML = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/></svg> Strip & Download`;
          }
        });

        // ── Select all / deselect all ──
        selectAllBtn.addEventListener("click", () => {
          const newState = !allSelected;
          foundFields.forEach((f) => {
            toggleStates[f.key] = newState;
            const btn = riskRows.querySelector(`.toggle[data-key="${f.key}"]`);
            if (btn) btn.classList.toggle("on", newState);
            const row = riskRows.querySelector(`[data-key="${f.key}"]`);
            if (row) row.classList.toggle("stripped", !newState);
          });
          updateSelectedCount();
        });

        // ── Reset buttons ──
        [resetBtn, resetBtn2].forEach((btn) =>
          btn?.addEventListener("click", resetTool),
        );
        $("error-retry-btn")?.addEventListener("click", resetTool);
        $("clean-reset-btn")?.addEventListener("click", resetTool);

        // ── Upload zone: click ANYWHERE on zone opens file picker ──
        // Using a dedicated handler that always fires, regardless of child elements
        uploadZone.addEventListener("click", (e) => {
          e.stopPropagation();
          fileInput.click();
        });

        // Keyboard accessibility — Enter or Space also opens picker
        uploadZone.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            fileInput.click();
          }
        });

        // Prevent file-input's own click from bubbling back to zone (avoids double-trigger)
        fileInput.addEventListener("click", (e) => e.stopPropagation());

        // ── File input change — triggered after user selects a file ──
        fileInput.addEventListener("change", (e) => {
          const file = e.target.files[0];
          if (file) processFile(file);
          // Reset value so same file can be re-selected
          fileInput.value = "";
        });

        // ── Drag and drop ──
        uploadZone.addEventListener("dragenter", (e) => {
          e.preventDefault();
          e.stopPropagation();
        });

        uploadZone.addEventListener("dragover", (e) => {
          e.preventDefault();
          e.stopPropagation();
          uploadZone.classList.add("drag-active");
          const title = $("zone-title");
          if (title) title.textContent = "Drop it!";
        });

        uploadZone.addEventListener("dragleave", (e) => {
          e.preventDefault();
          e.stopPropagation();
          // Only remove class if actually leaving the zone (not just entering a child)
          if (!uploadZone.contains(e.relatedTarget)) {
            uploadZone.classList.remove("drag-active");
            const title = $("zone-title");
            if (title) title.textContent = "Drop a PDF here";
          }
        });

        uploadZone.addEventListener("drop", (e) => {
          e.preventDefault();
          e.stopPropagation();
          uploadZone.classList.remove("drag-active");
          const title = $("zone-title");
          if (title) title.textContent = "Drop a PDF here";
          const file = e.dataTransfer.files[0];
          if (file) processFile(file);
        });

        // ── Global drag guard — prevents browser from opening file when dropped outside zone ──
        document.addEventListener("dragover", (e) => e.preventDefault());
        document.addEventListener("drop", (e) => e.preventDefault());
      })();
    </script>

    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"
    ></script>
    <script src="https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>
  </body>
</html>
