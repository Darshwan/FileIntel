  <!-- pdf-lib — required for merge -->
  <script src="https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>
  <!-- PDF.js — required for thumbnails -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js"></script>

  <script>
  (() => {
    'use strict';

    // ── State ──
    let files        = [];   // [{ id, file, name, bytes, pageCount, pdfDoc }]
    let mergedBytes  = null;
    let mergedPdfDoc = null; // pdf-lib doc for download
    let dragSrcId    = null;
    let stripMeta    = true;

    // ── DOM ──
    const $ = id => document.getElementById(id);

    const fileInput      = $('file-input');
    const dropZone       = $('drop-zone');
    const fileListWrap   = $('file-list-wrap');
    const fileList       = $('file-list');
    const fileCountLabel = $('file-count-label');
    const addMoreBtn     = $('add-more-btn');
    const addMoreStrip   = $('add-more-strip');
    const clearAllBtn    = $('clear-all-btn');
    const mergeBtn       = $('merge-btn');
    const resetBtn       = $('reset-btn');
    const stripToggle    = $('strip-toggle');
    const statFiles      = $('stat-files');
    const statPages      = $('stat-pages');
    const summaryHint    = $('summary-hint');
    const progressSection= $('progress-section');
    const progressBar    = $('progress-bar');
    const resultSection  = $('result-section');
    const resultBadge    = $('result-badge');
    const resultBefore   = $('result-before-list');
    const resultPages    = $('result-pages');
    const resultSize     = $('result-size');
    const resultFilesEl  = $('result-files');
    const resultMetaStat = $('result-meta-status');
    const resultThumbStrip = $('result-thumb-strip');
    const downloadBtn    = $('download-btn');
    const mergeAgainBtn  = $('merge-again-btn');
    const outputFilename = $('output-filename');

    // ── Helpers ──
    function uid() { return Math.random().toString(36).slice(2, 9); }

    function formatBytes(b) {
      if (!b || b < 1024) return (b || 0) + ' B';
      if (b < 1048576)    return (b / 1024).toFixed(1) + ' KB';
      return (b / 1048576).toFixed(2) + ' MB';
    }

    function setProgress(pct) {
      progressBar.style.width = Math.min(pct, 100) + '%';
    }

    function setStep(stepId) {
      ['step-load','step-merge','step-meta','step-save'].forEach((id, i) => {
        const el = $(id);
        const order = ['step-load','step-merge','step-meta','step-save'].indexOf(stepId);
        const myOrder = i;
        el.className = 'progress-step' + (myOrder < order ? ' done' : myOrder === order ? ' active' : '');
        el.querySelector('.step-icon').textContent = myOrder < order ? '✓' : String(i + 1);
      });
    }

    function updateSummary() {
      const totalPages = files.reduce((s, f) => s + (f.pageCount || 0), 0);
      statFiles.textContent = files.length;
      statPages.textContent = totalPages;
      fileCountLabel.textContent = files.length === 1 ? '1 file' : `${files.length} files`;
      summaryHint.textContent = files.length < 2
        ? (files.length === 0 ? 'Add at least 2 PDF files to merge' : 'Add at least one more file')
        : `Ready — ${totalPages} total pages`;
      mergeBtn.disabled = files.length < 2;
    }

    // ── PDF.js thumbnail ──
    async function renderThumbnail(bytes, canvasEl, scale = 0.2) {
      try {
        const pdfjsLib = window['pdfjs-dist/build/pdf'];
        if (!pdfjsLib) return;
        pdfjsLib.GlobalWorkerOptions.workerSrc =
          'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

        const pdf  = await pdfjsLib.getDocument({ data: bytes.slice(0) }).promise;
        const page = await pdf.getPage(1);
        const vp   = page.getViewport({ scale });

        canvasEl.width  = vp.width;
        canvasEl.height = vp.height;

        await page.render({
          canvasContext: canvasEl.getContext('2d'),
          viewport: vp,
        }).promise;

        return pdf.numPages;
      } catch (e) {
        console.warn('Thumbnail error:', e);
        return null;
      }
    }

    // ── Load file ──
    async function loadFile(file) {
      if (file.type !== 'application/pdf' && !file.name.toLowerCase().endsWith('.pdf')) {
        alert(`"${file.name}" is not a PDF file.`);
        return;
      }

      const id    = uid();
      const entry = { id, file, name: file.name, bytes: null, pageCount: null };
      files.push(entry);

      // Add item to DOM first — show loading state
      addFileItemToDOM(entry);
      updateSummary();
      fileListWrap.classList.add('has-files');

      // Read bytes
      const buffer   = await file.arrayBuffer();
      entry.bytes    = new Uint8Array(buffer);

      // Render thumbnail + get page count
      const thumbCanvas = document.getElementById(`thumb-${id}`);
      if (thumbCanvas) {
        const pages = await renderThumbnail(entry.bytes, thumbCanvas, 0.18);
        entry.pageCount = pages;

        // Update page count in DOM
        const metaEl = document.getElementById(`meta-${id}`);
        if (metaEl) metaEl.textContent = `${pages || '?'} pages · ${formatBytes(file.size)}`;

        // Hide loading spinner
        const loadingEl = document.getElementById(`loading-${id}`);
        if (loadingEl) loadingEl.style.display = 'none';

        updateSummary();
      }
    }

    // ── Add file item to DOM ──
    function addFileItemToDOM(entry) {
      const idx  = files.findIndex(f => f.id === entry.id) + 1;
      const item = document.createElement('div');
      item.className = 'file-item';
      item.dataset.id = entry.id;
      item.draggable = true;
      item.role = 'listitem';

      item.innerHTML = `
        <div class="drag-handle" title="Drag to reorder">
          <span></span><span></span><span></span>
        </div>
        <div class="file-thumb">
          <canvas id="thumb-${entry.id}"></canvas>
          <div class="file-thumb-loading" id="loading-${entry.id}">
            <div class="thumb-spinner"></div>
          </div>
        </div>
        <div class="file-info">
          <div class="file-name" title="${entry.name}">${truncate(entry.name, 36)}</div>
          <div class="file-meta" id="meta-${entry.id}">
            <span>Loading...</span>
          </div>
        </div>
        <div class="order-badge" id="order-${entry.id}">${idx}</div>
        <button class="file-remove" data-id="${entry.id}" title="Remove file" aria-label="Remove ${entry.name}">×</button>
      `;

      fileList.appendChild(item);

      // Drag events
      item.addEventListener('dragstart', onDragStart);
      item.addEventListener('dragover',  onDragOver);
      item.addEventListener('dragleave', onDragLeave);
      item.addEventListener('drop',      onDrop);
      item.addEventListener('dragend',   onDragEnd);

      // Remove button
      item.querySelector('.file-remove').addEventListener('click', (e) => {
        e.stopPropagation();
        removeFile(e.currentTarget.dataset.id);
      });
    }

    function truncate(str, max) {
      if (str.length <= max) return str;
      const ext = str.lastIndexOf('.');
      if (ext > 0) return str.slice(0, max - 4) + '...' + str.slice(ext);
      return str.slice(0, max - 3) + '...';
    }

    function removeFile(id) {
      files = files.filter(f => f.id !== id);
      const el = document.querySelector(`.file-item[data-id="${id}"]`);
      if (el) {
        el.style.animation = 'none';
        el.style.opacity = '0';
        el.style.transform = 'translateX(-10px)';
        el.style.transition = 'all 0.2s';
        setTimeout(() => el.remove(), 200);
      }
      if (files.length === 0) {
        fileListWrap.classList.remove('has-files');
      }
      rebuildOrderBadges();
      updateSummary();
    }

    function rebuildOrderBadges() {
      files.forEach((f, i) => {
        const badge = document.getElementById(`order-${f.id}`);
        if (badge) badge.textContent = i + 1;
      });
    }

    // ── Drag and drop reorder ──
    function onDragStart(e) {
      dragSrcId = e.currentTarget.dataset.id;
      e.currentTarget.classList.add('dragging');
      e.dataTransfer.effectAllowed = 'move';
      e.dataTransfer.setData('text/plain', dragSrcId);
    }

    function onDragOver(e) {
      e.preventDefault();
      e.dataTransfer.dropEffect = 'move';
      const item = e.currentTarget;
      if (item.dataset.id === dragSrcId) return;

      const rect = item.getBoundingClientRect();
      const midY = rect.top + rect.height / 2;

      clearDragStyles();
      if (e.clientY < midY) {
        item.classList.add('drag-over-top');
      } else {
        item.classList.add('drag-over-bottom');
      }
    }

    function onDragLeave(e) {
      e.currentTarget.classList.remove('drag-over-top', 'drag-over-bottom');
    }

    function onDrop(e) {
      e.preventDefault();
      const targetId  = e.currentTarget.dataset.id;
      if (targetId === dragSrcId) return;

      const srcIdx    = files.findIndex(f => f.id === dragSrcId);
      const targetIdx = files.findIndex(f => f.id === targetId);

      const rect = e.currentTarget.getBoundingClientRect();
      const midY = rect.top + rect.height / 2;
      const insertAfter = e.clientY >= midY;

      // Reorder files array
      const [moved] = files.splice(srcIdx, 1);
      const newIdx  = files.findIndex(f => f.id === targetId);
      files.splice(insertAfter ? newIdx + 1 : newIdx, 0, moved);

      // Reorder DOM
      rebuildFileList();
    }

    function onDragEnd(e) {
      e.currentTarget.classList.remove('dragging');
      clearDragStyles();
      dragSrcId = null;
    }

    function clearDragStyles() {
      document.querySelectorAll('.file-item').forEach(el => {
        el.classList.remove('drag-over-top', 'drag-over-bottom');
      });
    }

    function rebuildFileList() {
      fileList.innerHTML = '';
      files.forEach(f => addFileItemToDOM(f));

      // Re-render thumbnails for items already loaded
      files.forEach(async (f) => {
        if (!f.bytes) return;
        const canvas = document.getElementById(`thumb-${f.id}`);
        const loadEl = document.getElementById(`loading-${f.id}`);
        if (canvas) {
          await renderThumbnail(f.bytes, canvas, 0.18);
          if (loadEl) loadEl.style.display = 'none';
        }
      });

      rebuildOrderBadges();
    }

    // ── Upload events ──
    dropZone.addEventListener('click', e => { e.stopPropagation(); fileInput.click(); });
    dropZone.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); } });
    fileInput.addEventListener('click', e => e.stopPropagation());

    fileInput.addEventListener('change', async (e) => {
      const fs = Array.from(e.target.files || []);
      for (const f of fs) await loadFile(f);
      fileInput.value = '';
    });

    dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('drag-active'); });
    dropZone.addEventListener('dragleave', e => { if (!dropZone.contains(e.relatedTarget)) dropZone.classList.remove('drag-active'); });
    dropZone.addEventListener('drop', async e => {
      e.preventDefault();
      dropZone.classList.remove('drag-active');
      const fs = Array.from(e.dataTransfer.files || []);
      for (const f of fs) await loadFile(f);
    });

    document.addEventListener('dragover', e => e.preventDefault());
    document.addEventListener('drop', e => { if (e.target !== dropZone) e.preventDefault(); });

    addMoreBtn.addEventListener('click',   () => fileInput.click());
    addMoreStrip.addEventListener('click', () => fileInput.click());
    clearAllBtn.addEventListener('click',  () => {
      if (!confirm('Remove all files?')) return;
      files = [];
      fileList.innerHTML = '';
      fileListWrap.classList.remove('has-files');
      resultSection.classList.remove('visible');
      progressSection.classList.remove('visible');
      updateSummary();
    });

    // ── Strip toggle ──
    stripToggle.addEventListener('click', () => {
      stripMeta = !stripMeta;
      stripToggle.classList.toggle('on', stripMeta);
    });

    // ── MERGE ──
    mergeBtn.addEventListener('click', doMerge);

    async function doMerge() {
      if (files.length < 2) return;

      // Reset result
      resultSection.classList.remove('visible');
      progressSection.classList.add('visible');
      mergeBtn.disabled = true;
      resetBtn.style.display = 'none';

      try {
        setStep('step-load');
        setProgress(5);

        const { PDFDocument } = PDFLib;
        const outputDoc = await PDFDocument.create();

        // ── Step 1: Load all input PDFs ──
        const loadedDocs = [];
        for (let i = 0; i < files.length; i++) {
          const f = files[i];
          if (!f.bytes) {
            const buf = await f.file.arrayBuffer();
            f.bytes   = new Uint8Array(buf);
          }
          const doc = await PDFDocument.load(f.bytes, {
            ignoreEncryption: false,
            updateMetadata: false,
          });
          loadedDocs.push(doc);
          setProgress(5 + Math.round((i / files.length) * 25));
        }

        setStep('step-merge');
        setProgress(30);

        // ── Step 2: Copy pages in order ──
        for (let i = 0; i < loadedDocs.length; i++) {
          const doc   = loadedDocs[i];
          const count = doc.getPageCount();
          const indices = Array.from({ length: count }, (_, k) => k);
          const copiedPages = await outputDoc.copyPages(doc, indices);
          copiedPages.forEach(p => outputDoc.addPage(p));
          setProgress(30 + Math.round(((i + 1) / loadedDocs.length) * 40));
        }

        setStep('step-meta');
        setProgress(75);

        // ── Step 3: Set output metadata ──
        const title    = $('meta-title').value.trim()    || 'Merged Document';
        const author   = $('meta-author').value.trim()   || '';
        const subject  = $('meta-subject').value.trim()  || '';
        const keywords = $('meta-keywords').value.trim() || '';

        outputDoc.setTitle(title);
        if (author)   outputDoc.setAuthor(author);
        if (subject)  outputDoc.setSubject(subject);
        if (keywords) outputDoc.setKeywords(keywords.split(',').map(k => k.trim()));
        outputDoc.setProducer('FileIntel — fileintel.tech');
        outputDoc.setCreator('FileIntel PDF Merger');
        outputDoc.setCreationDate(new Date());
        outputDoc.setModificationDate(new Date());

        setStep('step-save');
        setProgress(85);

        // ── Step 4: Save ──
        const savedBytes = await outputDoc.save({ useObjectStreams: false });
        mergedBytes  = savedBytes;
        mergedPdfDoc = outputDoc;

        setProgress(100);

        // Short delay for UX
        await new Promise(r => setTimeout(r, 400));

        // ── Show result ──
        await showResult(savedBytes, loadedDocs);

        progressSection.classList.remove('visible');
        resultSection.classList.add('visible');
        resetBtn.style.display = '';
        resultSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

      } catch (err) {
        progressSection.classList.remove('visible');
        console.error('Merge error:', err);
        alert('Merge failed: ' + (err?.message || 'Unknown error') + '\n\nPlease check your PDF files and try again.');
        mergeBtn.disabled = false;
      }
    }

    // ── Show before/after result ──
    async function showResult(savedBytes, loadedDocs) {
      const totalPages = loadedDocs.reduce((s, d) => s + d.getPageCount(), 0);
      const sizeLabel  = formatBytes(savedBytes.byteLength);

      // Badge
      resultBadge.textContent  = `${totalPages} pages merged`;
      resultPages.textContent  = totalPages;
      resultSize.textContent   = sizeLabel;
      resultFilesEl.textContent= `${files.length} files`;
      resultMetaStat.textContent = stripMeta ? 'Stripped from sources' : 'Preserved from sources';

      // Before list
      resultBefore.innerHTML = '';
      files.forEach((f, i) => {
        const pages = loadedDocs[i]?.getPageCount() || '?';
        const row   = document.createElement('div');
        row.className = 'before-file-row';
        row.innerHTML = `
          <span class="before-file-num">${i + 1}</span>
          <span class="before-file-name" title="${f.name}">${truncate(f.name, 28)}</span>
          <span class="before-file-pages">${pages}p</span>
        `;
        resultBefore.appendChild(row);
      });

      // Merge arrow visual
      const arrowEl = document.createElement('div');
      arrowEl.className = 'merge-arrow';
      arrowEl.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="5 12 12 19 19 12"/></svg>';
      resultBefore.appendChild(arrowEl);

      // After thumbnails — render first 6 pages of merged doc
      resultThumbStrip.innerHTML = '';
      const pdfjsLib = window['pdfjs-dist/build/pdf'];
      if (pdfjsLib) {
        pdfjsLib.GlobalWorkerOptions.workerSrc =
          'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
        try {
          const previewPdf = await pdfjsLib.getDocument({ data: savedBytes.slice(0) }).promise;
          const pagesToShow = Math.min(previewPdf.numPages, 6);
          for (let p = 1; p <= pagesToShow; p++) {
            const wrap  = document.createElement('div');
            wrap.className = 'thumb-strip-item';
            const c    = document.createElement('canvas');
            wrap.appendChild(c);
            resultThumbStrip.appendChild(wrap);

            const page = await previewPdf.getPage(p);
            const vp   = page.getViewport({ scale: 0.15 });
            c.width    = vp.width;
            c.height   = vp.height;
            await page.render({ canvasContext: c.getContext('2d'), viewport: vp }).promise;
          }
          if (previewPdf.numPages > 6) {
            const more = document.createElement('div');
            more.className = 'thumb-strip-item';
            more.style.cssText = 'align-items:center;justify-content:center;font-family:var(--mono);font-size:9px;color:var(--ink-3);text-align:center;padding:4px;';
            more.textContent = `+${previewPdf.numPages - 6} more`;
            resultThumbStrip.appendChild(more);
          }
        } catch (e) {
          console.warn('Preview error:', e);
        }
      }

      // Set suggested filename
      outputFilename.value = (files[0]?.name.replace(/\.pdf$/i, '') || 'merged') + '-merged.pdf';
    }

    // ── Download ──
    downloadBtn.addEventListener('click', () => {
      if (!mergedBytes) return;

      const filename = outputFilename.value.trim() || 'merged-document.pdf';
      const finalName = filename.endsWith('.pdf') ? filename : filename + '.pdf';

      const blob = new Blob([mergedBytes], { type: 'application/pdf' });
      const url  = URL.createObjectURL(blob);
      const a    = document.createElement('a');
      a.href     = url;
      a.download = finalName;
      document.body.appendChild(a);
      a.click();
      setTimeout(() => { URL.revokeObjectURL(url); a.remove(); }, 1500);

      downloadBtn.textContent = '✓ Downloaded!';
      setTimeout(() => {
        downloadBtn.innerHTML = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg> Download merged PDF`;
      }, 2500);
    });

    // ── Merge again ──
    mergeAgainBtn.addEventListener('click', () => {
      resultSection.classList.remove('visible');
      mergeBtn.disabled = files.length < 2;
    });

    // ── Reset ──
    resetBtn.addEventListener('click', () => {
      if (!confirm('Start over? This will clear all files.')) return;
      files        = [];
      mergedBytes  = null;
      mergedPdfDoc = null;
      fileList.innerHTML = '';
      fileListWrap.classList.remove('has-files');
      resultSection.classList.remove('visible');
      progressSection.classList.remove('visible');
      resetBtn.style.display = 'none';
      mergeBtn.disabled = true;
      updateSummary();
    });

    // Init
    updateSummary();

  })();
  </script>

</body>
</html>