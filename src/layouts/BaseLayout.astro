---
import SEO from "../components/SEO.astro";
import Navbar from "../components/Navbar.astro";

const { title, description, canonical, schema, currentPath } = Astro.props;

// Map currentPath to activePage
const getActivePage = (path: string) => {
  if (path === "/" || path === "/home") return "home";
  if (path?.startsWith("/blog")) return "blog";
  if (path === "/privacy") return "privacy";
  if (
    [
      "/pdf-metadata-remover",
      "/pdf-merger",
      "/pdf-redactor",
      "/csv-deduplicator",
    ].includes(path)
  )
    return "tools";
  return "";
};

const activePage = getActivePage(currentPath);
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-MZDBV7SGRD"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-MZDBV7SGRD");
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Mono:wght@400;500&family=Geist:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      schema={schema}
    />
    
  </head>
  <body>
    <!-- Navigation -->
    <Navbar activePage={activePage} />

    <!-- Main Content -->
    <main>
      <slot />
    </main>

